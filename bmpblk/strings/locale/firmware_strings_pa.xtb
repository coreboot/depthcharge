<!DOCTYPE translationbundle>
<translationbundle lang="pa">
<translation id="1201402288615127009">ਅੱਗੇ</translation>
<translation id="1428255359211557126">ਮੈਮੋਰੀ ਜਾਂਚ (ਤਤਕਾਲ)</translation>
<translation id="1483971085438511843">ਕਿਸੇ ਵਿਕਲਪ ਨੂੰ ਚੁਣਨ ਲਈ Enter ਕੁੰਜੀ ਦਬਾਓ।</translation>
<translation id="1995660704900986789">ਪਾਵਰ ਬੰਦ ਕਰੋ</translation>
<translation id="2022309272630265316">ਕੋਈ ਵੈਧ ਇਮੇਜ ਨਹੀਂ ਮਿਲੀ</translation>
<translation id="2164852388827548816">ਫ਼ਰਮਵੇਅਰ ਲੌਗ</translation>
<translation id="3174560100798162637">ਤੁਹਾਡੇ ਡੀਵਾਈਸ ਨੂੰ ਪਾਵਰ ਸਰੋਤ ਨਾਲ ਕਨੈਕਟ ਕਰਨ ਦੀ ਸਿਫ਼ਾਰਸ਼ ਕੀਤੀ ਜਾਂਦੀ ਹੈ।</translation>
<translation id="3294574173405124634">GBB ਫਲੈਗਾਂ ਵੱਲੋਂ ਸੁਰੱਖਿਅਤ ਮੋਡ 'ਤੇ ਵਾਪਸ ਆਉਣ ਦੀ ਇਜਾਜ਼ਤ ਨਹੀਂ ਹੈ।</translation>
<translation id="3697087251845525042">ਸਟੋਰੇਜ ਸਵੈ-ਜਾਂਚ (ਸੰਖਿਪਤ)</translation>
<translation id="385051799172605136">ਪਿੱਛੇ</translation>
<translation id="4002335453596341558">ਪੰਨਾ ਹੇਠਾਂ</translation>
<translation id="4410491068110727276">ਉੱਤੇ ਜਾਂ ਹੇਠਾਂ ਨੈਵੀਗੇਟ ਕਰਨ ਲਈ ਅਵਾਜ਼ ਬਟਨ ਵਰਤੋ।</translation>
<translation id="4773280894882892048">ਡੀਬੱਗ ਜਾਣਕਾਰੀ</translation>
<translation id="4815374450404670311">ਮੈਮੋਰੀ ਜਾਂਚ (ਪੂਰੀ)</translation>
<translation id="4986594717579135906">ਤੁਹਾਡੇ ਡੀਵਾਈਸ 'ਤੇ ਅੱਪਡੇਟ ਪੂਰਾ ਹੋ ਰਿਹਾ ਹੈ। ਇਸ ਵਿੱਚ 1-2 ਮਿੰਟ ਲੱਗ ਸਕਦੇ ਹਨ।
ਕਿਰਪਾ ਕਰਕੇ ਆਪਣੇ ਡੀਵਾਈਸ ਨੂੰ ਬੰਦ ਨਾ ਕਰੋ।</translation>
<translation id="5232488980254489397">ਤਸ਼ਖੀਸ ਲਾਂਚ ਕਰੋ</translation>
<translation id="5477875595374685515">ਫ਼ਰਮਵੇਅਰ ਲੌਗ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਿਆ।</translation>
<translation id="5592705604979238266">ਮਦਦ ਕੇਂਦਰ:</translation>
<translation id="6172915643608608639">ਅੰਦਰੂਨੀ ਡਿਸਕ ਤੋਂ ਬੂਟ ਕਰੋ</translation>
<translation id="635783852215913562">ਉੱਤੇ ਜਾਂ ਥੱਲੇ ਨੈਵੀਗੇਟ ਕਰਨ ਲਈ ਤੀਰ ਕੁੰਜੀਆਂ ਵਰਤੋ।</translation>
<translation id="65237697078188559">ਫ਼ਰਮਵੇਅਰ ਸ਼ੈੱਲ</translation>
<translation id="6972383785688794804">ਪੰਨਾ ਉੱਪਰ</translation>
<translation id="7065553583078443466">ਵਿਕਲਪਿਕ ਬੂਟਲੋਡਰ ਚੁਣੋ</translation>
<translation id="7126032376876878896">ਕਿਸੇ ਵਿਕਲਪ ਨੂੰ ਚੁਣਨ ਲਈ ਪਾਵਰ ਬਟਨ ਵਰਤੋ।</translation>
<translation id="7321387134821904291">ਸਟੋਰੇਜ ਕਾਰਗੁਜ਼ਾਰੀ ਦੀ ਜਾਣਕਾਰੀ</translation>
<translation id="7332672207700801967">ਇੰਟਰਨੈੱਟ ਰਿਕਵਰੀ (ਪੁਰਾਣਾ ਵਰਜਨ)</translation>
<translation id="7342794948394983731">ਤਸ਼ਖੀਸੀ ਟੂਲ</translation>
<translation id="7352651011704765696">ਕੋਈ ਗੜਬੜ ਹੋ ਗਈ</translation>
<translation id="7658239707568436148">ਰੱਦ ਕਰੋ</translation>
<translation id="7939062555109487992">ਉੱਨਤ ਵਿਕਲਪ</translation>
<translation id="8011335065515332253">ਸਮਾਂ ਸਮਾਪਤ ਹੋਣ ਤੋਂ ਬਾਅਦ, ਡੀਵਾਈਸ ਹੇਠਾਂ ਦਿੱਤੀ ਚੋਣ ਤੋਂ ਸਵੈਚਲਿਤ ਤੌਰ 'ਤੇ ਬੂਟ ਹੋਵੇਗਾ।</translation>
<translation id="8116993605321079294">ਵਿਕਲਪਿਕ ਬੂਟਲੋਡਰ ਨੂੰ ਲਾਂਚ ਕਰਨ ਵੇਲੇ ਕੋਈ ਗੜਬੜ ਹੋ ਗਈ। ਵੇਰਵਿਆਂ ਲਈ ਫ਼ਰਮਵੇਅਰ ਲੌਗ ਦੇਖੋ।</translation>
<translation id="8131740175452115882">ਤਸਦੀਕ ਕਰੋ</translation>
<translation id="8377165353588213941">ਤੁਸੀਂ ਸਮਾਪਤੀ ਤੱਕ ਪਹੁੰਚ ਗਏ ਹੋ</translation>
<translation id="8569584079758810124">ਡੀਬੱਗ ਜਾਣਕਾਰੀ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕੀ।</translation>
<translation id="8720490351198901261">ਤੁਸੀਂ ਸਿਖਰ 'ਤੇ ਪਹੁੰਚ ਗਏ ਹੋ</translation>
<translation id="8878311588372127478">ਸਟੋਰੇਜ ਸਵੈ-ਜਾਂਚ (ਵਿਸਤ੍ਰਿਤ)</translation>
<translation id="8975826224585429326">ਵਿਕਲਪਿਕ ਬੂਟਲੋਡਰ ਲੱਭਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ। ਸਥਾਪਤ ਕਰਨ ਦੇ ਤਰੀਕੇ ਬਾਰੇ ਜਾਣਨ ਲਈ, ਇੱਥੇ ਜਾਓ:</translation>
<translation id="9004305007436435169">ਤਸ਼ਖੀਸੀ ਜਾਣਕਾਰੀ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕੀ।</translation>
</translationbundle>