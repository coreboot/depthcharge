<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1041985745423354926">Για την ανάκτηση μπορείτε να χρησιμοποιήσετε εξωτερικό αποθηκευτικό χώρο όπως μια μονάδα USB ή μια κάρτα SD.</translation>
<translation id="1159332245309393502">Ρύθμιση εξωτερικού αποθηκευτικού χώρου</translation>
<translation id="1201402288615127009">Επόμενο</translation>
<translation id="1252150473073837888">Επιβεβαίωση της επιστροφής στην ασφαλή λειτουργία</translation>
<translation id="1321620357351949170">Επιλέξτε τη δοκιμή που θέλετε να εκτελέσετε.</translation>
<translation id="1327914510899744949">Fastboot προγράμματος φόρτωσης εκκίνησης</translation>
<translation id="1389402762514302384">Επιλέξτε Ακύρωση για να παραμείνετε προστατευμένοι.</translation>
<translation id="1428255359211557126">Έλεγχος μνήμης (γρήγορος)</translation>
<translation id="1472222389773595668">Ρύθμιση μονάδας ανάκτησης</translation>
<translation id="1483971085438511843">Χρησιμοποιήστε το πλήκτρο enter για ορισμό μιας επιλογής.</translation>
<translation id="1512607074848104909">Συνδέστε μια εξωτερική μονάδα με μια εικόνα λειτουργικού συστήματος. Η συσκευή σας θα εκκινηθεί αυτόματα.</translation>
<translation id="1618959600706780970">Η συσκευή σας δεν είναι ασφαλής όταν το πρόγραμμα φόρτωσης εκκίνησης είναι ξεκλειδωμένο. Για να επαναφέρετε την ασφάλεια της συσκευής, κλειδώστε το πρόγραμμα φόρτωσης εκκίνησης.</translation>
<translation id="1844317421356540461">Παρουσιάστηκε κάποιο πρόβλημα κατά την εκκίνηση από τον εσωτερικό δίσκο. Δείτε το αρχείο καταγραφής υλικολογισμικού για λεπτομέρειες.</translation>
<translation id="1851498512110506461">Θα γίνει εκκαθάριση των δεδομένων χρήστη κατά τη διαδικασία.</translation>
<translation id="1880493276474218432">Για να δημιουργήσετε μια μονάδα ανάκτησης, θα χρειαστείτε τα εξής:</translation>
<translation id="1931763245382489971">3. Κάντε κλικ στο στοιχείο Επόμενο όταν η συσκευή εξωτερικού αποθηκ. χώρου είναι έτοιμη με το είδωλο ανάκτησης.</translation>
<translation id="1932315467893966859">Η λειτουργία προγραμματιστή είναι ήδη ενεργοποιημένη.</translation>
<translation id="1995660704900986789">Απενεργοποίηση</translation>
<translation id="2022309272630265316">Δεν εντοπίστηκε έγκυρη εικόνα</translation>
<translation id="2164852388827548816">Αρχείο καταγραφής υλικολογισμικού</translation>
<translation id="2176647394998805208">Εκκίνηση από εξωτερικό δίσκο</translation>
<translation id="2188090550242711688">2. Ακολουθήστε τις οδηγίες στην Επέκταση Chrome και κατεβάστε την εικόνα ανάκτησης σε έναν εξωτερικό αποθηκευτικό χώρο</translation>
<translation id="2242127796967618375">Μάθετε περισσότερα στο:</translation>
<translation id="2270126560545545577">Βρίσκεστε σε λειτουργία προγραμματιστή</translation>
<translation id="2340902555262319714">2. Ενώ κρατάτε πατημένο το κουμπί ανάκτησης, πατήστε και αφήστε το κουμπί λειτουργίας ( ⏻ ) και, στη συνέχεια, αφήστε το κουμπί ανάκτησης.</translation>
<translation id="2360163367862409346">Αυτή η ενέργεια περιλαμβάνει τη διαγραφή όλων των δεδομένων από τη συσκευή σας και θα μετατρέψει τη συσκευή σας σε μη ασφαλή.</translation>
<translation id="240428637889110007">1. Μεταβείτε στη διεύθυνση goo.gle/android_laptop_recovery στην άλλη συσκευή σας</translation>
<translation id="2445391421565214706">Για να προσπαθήσετε να διορθώσετε το πρόβλημα, ξεκινήστε τη διαδικασία ανάκτησης. Αφαιρέστε όλες τις συνδεδεμένες συσκευές και έπειτα πατήστε παρατεταμένα τα κουμπιά αύξησης έντασης ήχου, μείωσης έντασης ήχου και λειτουργίας ( ⏻ ) για τουλάχιστον 10 δευτερόλεπτα.</translation>
<translation id="2531345960369431549">Αυτή η επιλογή θα απενεργοποιήσει τη λειτουργία προγραμματιστή και θα επαναφέρει τη συσκευή σας στην αρχική της κατάσταση.</translation>
<translation id="2730585974895524161">Το πρόγραμμα φόρτωσης εκκίνησης είναι ξεκλειδωμένο</translation>
<translation id="2861620505929653443">Ξεκλείδωμα προγράμματος φόρτωσης εκκίνησης;</translation>
<translation id="2904079386864173492">Μοντέλο:</translation>
<translation id="2969699099866537016">Βεβαιωθείτε ότι η μονάδα ανάκτησης έχει ένα έγκυρο είδωλο και δοκιμάστε ξανά.</translation>
<translation id="3165751548024554961">Το επίπεδο μπαταρίας της συσκευής είναι χαμηλό. Συνδεθείτε σε μια πηγή ενέργειας για να συνεχίσετε.</translation>
<translation id="3174560100798162637">Συνιστάται να συνδέσετε τη συσκευή σας σε μια πηγή ενέργειας.</translation>
<translation id="3235458304027619499">1. Μια συσκευή εξωτερικού αποθηκ. χώρου, όπως μια μονάδα USB ή κάρτα SD.</translation>
<translation id="328213018570216625">Ανάκτηση με χρήση εξωτερικού αποθηκευτικού χώρου</translation>
<translation id="3289365543955953678">Συνδέστε τον εξωτερικό δίσκο</translation>
<translation id="3294574173405124634">Η επιστροφή σε ασφαλή λειτουργία δεν επιτρέπεται από τις επισημάνσεις GBB.</translation>
<translation id="330703583939423765">1. Αφαιρέστε όλες τις συνδεδεμένες συσκευές.</translation>
<translation id="361826164482194215">Τα εναλλακτικά προγράμματα φόρτωσης εκκίνησης είναι απενεργοποιημένα. Μάθετε περισσότερα στο:</translation>
<translation id="3635226996169670741">Για να προσπαθήσετε να διορθώσετε το πρόβλημα, ξεκινήστε τη διαδικασία ανάκτησης. Αφαιρέστε όλες τις συνδεδεμένες συσκευές και πατήστε παρατεταμένα Esc, Ανανέωση ( ⟳ ) και το κουμπί λειτουργίας ( ⏻ ).</translation>
<translation id="3697087251845525042">Αυτοέλεγχος αποθηκευτικού χώρου (σύντομος)</translation>
<translation id="3747500110898960596">Τα εναλλακτικά προγράμματα φόρτωσης εκκίνησης είναι απενεργοποιημένα. Για περισσότερες πληροφορίες, επισκεφτείτε τη διεύθυνση:</translation>
<translation id="3784455785234192852">Κλείδωμα</translation>
<translation id="3848046184877245923">Έναρξη της διαδικασίας ανάκτησης</translation>
<translation id="385051799172605136">Πίσω</translation>
<translation id="3931222419141306012">Παρωχημένο είδωλο ανάκτησης</translation>
<translation id="3964506597604121312">Κατά τη διαδικασία θα γίνει εκκαθάριση των δεδομένων χρήστη σας.</translation>
<translation id="4002335453596341558">Επόμενη σελίδα</translation>
<translation id="4152977630022273265">Βεβαιωθείτε ότι ο εξωτερικός δίσκος σας έχει μια έγκυρη εικόνα λειτουργικού συστήματος Chrome OS και τοποθετήστε εκ νέου τον δίσκο όταν είναι έτοιμος.</translation>
<translation id="4228286289437521015">Με αυτή την ενέργεια θα διαγραφούν όλα τα δεδομένα από τη συσκευή σας. Η ασφάλεια της συσκευής θα απενεργοποιηθεί.</translation>
<translation id="4231467600151418708">2. Πατήστε παρατεταμένα τα κουμπιά Esc + Ανανέωση ( ⟳ ) + Λειτουργία ( ⏻ ).</translation>
<translation id="4410491068110727276">Χρησιμοποιήστε τα κουμπιά έντασης ήχου για πλοήγηση προς τα επάνω ή προς τα κάτω.</translation>
<translation id="46859019225980199">Για να διορθώσετε αυτό το πρόβλημα, ξεκινήστε τη διαδικασία ανάκτησης.</translation>
<translation id="4773280894882892048">Πληροφορίες εντοπισμού σφάλματος</translation>
<translation id="4815374450404670311">Έλεγχος μνήμης (πλήρης)</translation>
<translation id="4834079235849774599">2. Μια άλλη συσκευή με πρόσβαση στο διαδίκτυο.</translation>
<translation id="4841043913984655587">Η εκκίνηση από εξωτερικό δίσκο είναι απενεργοποιημένη. Για περισσότερες πληροφορίες, επισκεφτείτε τη διεύθυνση:</translation>
<translation id="4986594717579135906">Your device is finishing an update. This may take 1-2 minutes.
Please do not turn off your device.</translation>
<translation id="4989087579517177148">Επιλέξτε τον τρόπο ανάκτησης.</translation>
<translation id="4991849386608920411">Πατήστε το κουμπί Ανάκτηση στη συσκευή σας για να ξεκλειδώσετε το πρόγραμμα φόρτωσης εκκίνησης ή επιλέξτε Ακύρωση για να παραμείνετε προστατευμένοι.</translation>
<translation id="5018618999152115810">Χρήση μονάδας USB</translation>
<translation id="5019112228955634706">3. Μια πηγή ενέργειας για αυτήν τη συσκευή</translation>
<translation id="5070315104093438679">Προϊόν:</translation>
<translation id="5175612852476047443">Μην απενεργοποιήσετε τη συσκευή σας</translation>
<translation id="5184662919967270437">Γίνεται ενημέρωση της συσκευής σας</translation>
<translation id="5232488980254489397">Εκκίνηση διαγνωστικών</translation>
<translation id="5258940999070776327">Επιλογή δοκιμής για εκτέλεση</translation>
<translation id="5288652088496335604">Επιλέξτε μια μέθοδο ανάκτησης για να ξεκινήσετε.</translation>
<translation id="5447452894128399840">2. Ακολουθήστε τις οδηγίες στην άλλη συσκευή σας</translation>
<translation id="5477875595374685515">Δεν ήταν δυνατή η λήψη του αρχείου καταγραφής υλικολογισμικού.</translation>
<translation id="5511340521509645831">Εκκίνηση από εξωτερική μονάδα</translation>
<translation id="5592705604979238266">Κέντρο βοήθειας:</translation>
<translation id="5704836750240170251">Κλείδωμα προγράμματος φόρτωσης εκκίνησης</translation>
<translation id="5733004683773923934">Παρουσιάστηκε κάποιο πρόβλημα κατά την εκκίνηση από τον εσωτερικό δίσκο. Για λεπτομέρειες, μεταβείτε στην επιλογή Σύνθετες επιλογές &gt; Αρχείο καταγραφής υλικολογισμικού.</translation>
<translation id="5809240698077875994">Πατήστε το κουμπί λειτουργίας για να ενεργοποιήσετε τη λειτουργία προγραμματιστή ή επιλέξτε Ακύρωση για να παραμείνετε προστατευμένοι.</translation>
<translation id="5831266751064943765">Δεν μπορείτε να χρησιμοποιήσετε εξωτερικό πληκτρολόγιο για να ξεκλειδώσετε το πρόγραμμα φόρτωσης εκκίνησης. Χρησιμοποιήστε το ενσωματωμένο πληκτρολόγιο.</translation>
<translation id="5846715299792649254">1. Μια μονάδα USB</translation>
<translation id="586317305889719987">Για να επιστρέψετε στην προτεινόμενη ασφαλή λειτουργία, επιλέξτε "Επιστροφή στην ασφαλή λειτουργία" παρακάτω.</translation>
<translation id="5874367961304694171">Συνδέστε τη συσκευή εξωτερικού αποθηκ. χώρου</translation>
<translation id="589807000231180230">Αναμονή για σύνδεση…</translation>
<translation id="6073029132385600270">Ετοιμαστείτε για την ανάκτηση της συσκευής σας</translation>
<translation id="6172915643608608639">Εκκίνηση από εσωτερικό δίσκο</translation>
<translation id="6191358901427525316">Ετοιμαστείτε για την ανάκτηση της συσκευής σας. Θα χρειαστείτε τα εξής:</translation>
<translation id="6209959435052494013">Κλείδωμα προγράμματος φόρτωσης εκκίνησης;</translation>
<translation id="6259657716425232440">Το πρόγραμμα φόρτωσης εκκίνησης είναι ήδη ξεκλειδωμένο.</translation>
<translation id="635783852215913562">Χρησιμοποιήστε τα πλήκτρα βέλους για πλοήγηση επάνω ή κάτω.</translation>
<translation id="6393574457614848045">Το διαμέρισμα ανάκτησης διαδικτύου έχει καταστραφεί ή λείπει. Εναλλακτικά, κάντε ανάκτηση χρησιμοποιώντας εξωτερικό αποθηκευτικό χώρο.</translation>
<translation id="6437078769036639380">Βεβαιωθείτε ότι η εξωτερική μονάδα έχει μια έγκυρη εικόνα λειτουργικού συστήματος και τοποθετήστε την ξανά όταν είναι έτοιμη.</translation>
<translation id="6448938863276324156">Για την ανάκτηση μπορείτε να χρησιμοποιήσετε εξωτερικό αποθηκευτικό χώρο όπως μια μονάδα USB.</translation>
<translation id="6453188622241717495">Ξεκλείδωμα προγράμματος φόρτωσης εκκίνησης</translation>
<translation id="65237697078188559">Κέλυφος υλικολογισμικού</translation>
<translation id="6526005868180962531">Όταν η μονάδα ανάκτησης είναι έτοιμη, συνδέστε τη σε αυτή τη συσκευή για να ξεκινήσετε τη διαδικασία ανάκτησης.</translation>
<translation id="6870233504224262352">Διατηρήστε ενεργοποιημένη τη συσκευή σας. Ίσως χρειαστεί λίγος χρόνος.</translation>
<translation id="6933530204467815794">Σύνδεση μέσω TCP</translation>
<translation id="6972383785688794804">Προηγούμενη σελίδα</translation>
<translation id="7065553583078443466">Επιλογή εναλλακτικού προγράμματος φόρτωσης εκκίνησης</translation>
<translation id="7071202423630761214">Σύνδεση μέσω USB</translation>
<translation id="7126032376876878896">Χρησιμοποιήστε το κουμπί λειτουργίας για τον ορισμό μιας επιλογής.</translation>
<translation id="714708458581824276">Το διαμέρισμα ανάκτησης μέσω διαδικτύου έχει καταστραφεί ή λείπει. Εναλλακτικά, χρησιμοποιήστε μια μονάδα USB ή μια κάρτα SD.</translation>
<translation id="7154775592215462674">1. Μια συσκευή εξωτερικού αποθηκ. χώρου, όπως μια μονάδα USB.</translation>
<translation id="7157640574359006953">Συνδέστε τον εξωτερικό σας δίσκο με μια εικόνα λειτουργικού συστήματος Chrome OS. Θα εκκινηθεί αυτόματα.</translation>
<translation id="7187861267433191629">Το σύστημά σας εφαρμόζει μια σημαντική ενημέρωση.</translation>
<translation id="7236073510654217175">Επιστροφή στην ασφαλή λειτουργία</translation>
<translation id="7321387134821904291">Πληροφορίες κατάστασης αποθηκευτικού χώρου</translation>
<translation id="7332672207700801967">Ανάκτηση διαδικτύου (παλαιότερη έκδοση)</translation>
<translation id="7342794948394983731">Διαγνωστικά εργαλεία</translation>
<translation id="7352651011704765696">Παρουσιάστηκε κάποιο πρόβλημα</translation>
<translation id="7356165460126686730">Χρήση σύνδεσης στο διαδίκτυο</translation>
<translation id="7363327341920650426">Η εκκίνηση με ξεκλειδωμένο πρόγραμμα φόρτωσης εκκίνησης είναι απενεργοποιημένη. Για να την ενεργοποιήσετε, κάντε επανεκκίνηση στο λειτουργικό σύστημα και ενεργοποιήστε το OEM ξεκλείδωμα στις Επιλογές για προγραμματιστές. Μάθετε περισσότερα στο:</translation>
<translation id="7379220436569534523">Με αυτή την ενέργεια, θα κλειδωθεί το πρόγραμμα φόρτωσης εκκίνησης και θα γίνει επαναφορά της συσκευής στην αρχική της κατάσταση.</translation>
<translation id="7407610796520500368">Ανάκτηση με χρήση σύνδεσης στο διαδίκτυο</translation>
<translation id="7420576176825630019">Ενεργοποίηση λειτουργίας προγραμματιστή</translation>
<translation id="7567414219298075193">Για να προσπαθήσετε να διορθώσετε το πρόβλημα, ξεκινήστε τη διαδικασία ανάκτησης. Αφαιρέστε όλες τις συνδεδεμένες συσκευές. Έπειτα, πατήστε παρατεταμένα το κουμπί ανάκτησης, πατήστε και αφήστε το κουμπί λειτουργίας ( ⏻ ) και μετά αφήστε το κουμπί ανάκτησης.</translation>
<translation id="7638747526774710781">1. Μεταβείτε στη διεύθυνση google.com/chromeos/recovery στην άλλη συσκευή και εγκαταστήστε την επέκταση Chrome.</translation>
<translation id="7658239707568436148">Ακύρωση</translation>
<translation id="7666722144169757891">Αυτό το είδωλο ανάκτησης είναι πολύ παλιό για τη συσκευή σας. Κατεβάστε ένα νέο είδωλο ανάκτησης και δοκιμάστε ξανά.</translation>
<translation id="7768922467835418715">Δεν εντοπίστηκε εξωτερική μονάδα</translation>
<translation id="786846615651935749">2. Μια άλλη συσκευή με σύνδεση στο διαδίκτυο</translation>
<translation id="7939062555109487992">Επιλογές για προχωρημένους</translation>
<translation id="8003769027543821178">1. Μια μονάδα USB ή μια κάρτα SD</translation>
<translation id="8011335065515332253">Μετά τη λήξη του χρονικού ορίου, η συσκευή θα εκκινηθεί αυτόματα βάσει της παρακάτω επιλογής.</translation>
<translation id="8027199195649765326">Πατήστε το κουμπί ανάκτησης στο Chromebox για να ενεργοποιήσετε τη λειτουργία προγραμματιστή ή επιλέξτε Ακύρωση για να παραμείνετε προστατευμένοι.</translation>
<translation id="8101391381992690790">Βεβαιωθείτε ότι ο εξωτερικός δίσκος περιέχει ένα έγκυρο είδωλο ανάκτησης και τοποθετήστε εκ νέου τον δίσκο όταν είστε έτοιμος.</translation>
<translation id="8116993605321079294">Παρουσιάστηκε κάποιο πρόβλημα με την εκκίνηση του εναλλακτικού προγράμματος φόρτωσης εκκίνησης. Δείτε το αρχείο καταγραφής υλικολογισμικού για λεπτομέρειες.</translation>
<translation id="8131740175452115882">Επιβεβαίωση</translation>
<translation id="8182314305006465525">Είστε σε λειτουργία Fastboot προγράμματος φόρτωσης εκκίνησης</translation>
<translation id="8199613549817472219">Ας δούμε αναλυτικά τα βήματα της διαδικασίας ανάκτησης</translation>
<translation id="8315682102205416794">Χρήση μονάδας USB ή κάρτας SD</translation>
<translation id="8377165353588213941">Φτάσατε στο τέλος</translation>
<translation id="8547898031669202422">Η εκκίνηση από εξωτερική μονάδα είναι απενεργοποιημένη. Μάθετε περισσότερα στο:</translation>
<translation id="8569584079758810124">Δεν ήταν δυνατή η λήψη πληροφοριών εντοπισμού σφαλμάτων.</translation>
<translation id="8609689706517017461">Το διαμέρισμα ανάκτησης μέσω διαδικτύου έχει καταστραφεί ή λείπει. Εναλλακτικά, χρησιμοποιήστε μια μονάδα USB.</translation>
<translation id="8720490351198901261">Φτάσατε στην κορυφή</translation>
<translation id="8734661833241888861">Η εκκίνηση σε λειτουργία προγραμματιστή δεν επιτρέπεται. Για περισσότερες πληροφορίες, επισκεφτείτε τη διεύθυνση:</translation>
<translation id="8738563743369620892">Δεν μπορείτε να χρησιμοποιήσετε πληκτρολόγιο για να ξεκλειδώσετε το πρόγραμμα φόρτωσης εκκίνησης. Χρησιμοποιήστε το κουμπί λειτουργίας ( ⏻ ).</translation>
<translation id="8789686976863801203">Προσπαθείτε να ενεργοποιήσετε τη λειτουργία προγραμματιστή</translation>
<translation id="8848124168564939055">Δεν μπορείτε να χρησιμοποιήσετε εξωτερικό πληκτρολόγιο για να ενεργοποιήσετε τη λειτουργία προγραμματιστή. Χρησιμοποιήστε τα κουμπιά στη συσκευή που υποδεικνύονται στις οδηγίες πλοήγησης.</translation>
<translation id="8856927881878864573">2. Πατήστε παρατεταμένα τα κουμπιά αύξησης έντασης ήχου, μείωσης έντασης ήχου και λειτουργίας ( ⏻ ) για τουλάχιστον 10 δευτερόλεπτα.</translation>
<translation id="8878311588372127478">Αυτοέλεγχος αποθηκευτικού χώρου (εκτεταμένος)</translation>
<translation id="8975826224585429326">Δεν ήταν δυνατή η εύρεση εναλλακτικού προγράμματος φόρτωσης εκκίνησης. Για να μάθετε πώς να εγκαταστήσετε ένα τέτοιο πρόγραμμα, επισκεφτείτε τη διεύθυνση:</translation>
<translation id="9004305007436435169">Δεν ήταν δυνατή η λήψη διαγνωστικών πληροφοριών.</translation>
<translation id="9037104512788860027">Δεν επιτρέπεται η εκκίνηση με ξεκλειδωμένο πρόγραμμα φόρτωσης εκκίνησης. Μάθετε περισσότερα στο:</translation>
<translation id="9040266428058825675">Εάν η συσκευή εξωτερικού αποθηκ. χώρου είναι έτοιμη με ένα είδωλο ανάκτησης, συνδέστε τη σε αυτήν τη συσκευή για να ξεκινήσετε τη διαδικασία ανάκτησης.</translation>
<translation id="9111102763498581341">Ξεκλείδωμα</translation>
</translationbundle>