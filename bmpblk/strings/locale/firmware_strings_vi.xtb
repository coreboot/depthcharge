<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="vi">
<translation id="1014836725110176376">1. Truy cập vào <ph name="REC_URL" /> trên thiết bị còn lại của bạn</translation>
<translation id="1201402288615127009">Tiếp theo</translation>
<translation id="1327914510899744949">Chế độ khởi động nhanh của trình tải khởi động</translation>
<translation id="1428255359211557126">Kiểm tra bộ nhớ (nhanh)</translation>
<translation id="1472222389773595668">Thiết lập ổ đĩa khôi phục</translation>
<translation id="1483971085438511843">Dùng phím Enter để chọn một tùy chọn.</translation>
<translation id="1512607074848104909">Cắm ổ đĩa ngoài có hình ảnh hệ điều hành. Thiết bị sẽ tự động khởi động.</translation>
<translation id="1618959600706780970">Thiết bị không được bảo mật khi trình tải khởi động được mở khoá. Để khôi phục tính năng bảo mật của thiết bị, hãy khoá trình tải khởi động.</translation>
<translation id="1851498512110506461">Dữ liệu người dùng sẽ bị xoá sạch trong quá trình này.</translation>
<translation id="1880493276474218432">Để tạo ổ đĩa khôi phục, bạn cần:</translation>
<translation id="1995660704900986789">Tắt nguồn</translation>
<translation id="2022309272630265316">Không phát hiện thấy hình ảnh hợp lệ</translation>
<translation id="2164852388827548816">Nhật ký của chương trình cơ sở</translation>
<translation id="2242127796967618375">Tìm hiểu thêm tại:</translation>
<translation id="2340902555262319714">2. Trong khi giữ nút Khôi phục, hãy nhấn rồi nhả nút Nguồn ( ⏻ ), sau đó nhả nút Khôi phục.</translation>
<translation id="2730585974895524161">Trình tải khởi động đã mở khoá</translation>
<translation id="2861620505929653443">Mở khoá trình tải khởi động?</translation>
<translation id="2969699099866537016">Đảm bảo rằng ổ đĩa khôi phục có hình ảnh hợp lệ rồi thử lại.</translation>
<translation id="3165751548024554961">Thiết bị sắp hết pin. Hãy kết nối với nguồn điện để tiếp tục.</translation>
<translation id="3174560100798162637">Bạn nên cắm thiết bị vào nguồn điện.</translation>
<translation id="3294574173405124634">Các cờ GBB không cho phép quay lại chế độ bảo mật.</translation>
<translation id="330703583939423765">1. Xoá mọi thiết bị đã kết nối.</translation>
<translation id="361826164482194215">Trình tải khởi động thay thế đã bị tắt. Tìm hiểu thêm tại:</translation>
<translation id="3697087251845525042">Tự kiểm tra bộ nhớ (nhanh)</translation>
<translation id="3784455785234192852">Khoá</translation>
<translation id="3848046184877245923">Bắt đầu quy trình khôi phục</translation>
<translation id="385051799172605136">Quay lại</translation>
<translation id="3931222419141306012">Hình ảnh khôi phục đã cũ</translation>
<translation id="4002335453596341558">Trang dưới</translation>
<translation id="4228286289437521015">Thao tác này sẽ xoá tất cả dữ liệu khỏi thiết bị. Tính năng bảo mật thiết bị sẽ bị tắt.</translation>
<translation id="4231467600151418708">2. Nhấn và giữ phím Esc + Làm mới ( ⟳ ) + Nguồn ( ⏻ ).</translation>
<translation id="4410491068110727276">Dùng các nút âm lượng để di chuyển lên trên hoặc xuống dưới.</translation>
<translation id="46859019225980199">Để khắc phục vấn đề này, hãy bắt đầu quy trình khôi phục.</translation>
<translation id="4773280894882892048">Thông tin gỡ lỗi</translation>
<translation id="4815374450404670311">Kiểm tra bộ nhớ (toàn diện)</translation>
<translation id="4986594717579135906">Thiet bi dang cap nhat. Qua trinh nay co the mat 1-2 phut.
Vui long khong tat may.</translation>
<translation id="4991849386608920411">Nhấn nút Khôi phục trên thiết bị để mở khoá trình tải khởi động hoặc chọn Huỷ để duy trì bảo mật.</translation>
<translation id="5018618999152115810">Sử dụng ổ đĩa USB</translation>
<translation id="5184662919967270437">Đang cập nhật thiết bị</translation>
<translation id="5232488980254489397">Chạy tính năng chẩn đoán</translation>
<translation id="5258940999070776327">Chọn một thử nghiệm để chạy</translation>
<translation id="5288652088496335604">Chọn phương thức khôi phục để bắt đầu.</translation>
<translation id="5447452894128399840">2. Làm theo hướng dẫn trên thiết bị còn lại</translation>
<translation id="5477875595374685515">Không nhận được nhật ký của chương trình cơ sở.</translation>
<translation id="5511340521509645831">Khởi động từ ổ đĩa ngoài</translation>
<translation id="5592705604979238266">Trung tâm trợ giúp:</translation>
<translation id="5704836750240170251">Khoá trình tải khởi động</translation>
<translation id="5733004683773923934">Đã xảy ra lỗi khi khởi động từ ổ đĩa trong. Để biết chi tiết, hãy chuyển đến Tuỳ chọn nâng cao &gt; Nhật ký của chương trình cơ sở.</translation>
<translation id="5831266751064943765">Bạn không thể dùng bàn phím ngoài để mở khoá trình tải khởi động. Hãy sử dụng bàn phím tích hợp sẵn.</translation>
<translation id="5846715299792649254">1. Ổ đĩa USB</translation>
<translation id="589807000231180230">Đang chờ kết nối...</translation>
<translation id="6073029132385600270">Chuẩn bị sẵn sàng khôi phục thiết bị</translation>
<translation id="6172915643608608639">Khởi động từ ổ đĩa trong</translation>
<translation id="6209959435052494013">Khoá trình tải khởi động?</translation>
<translation id="6259657716425232440">Đã mở khoá trình tải khởi động.</translation>
<translation id="6326551461084488743">Thiết bị:</translation>
<translation id="635783852215913562">Sử dụng các phím mũi tên để di chuyển lên trên hoặc xuống dưới.</translation>
<translation id="6437078769036639380">Đảm bảo rằng ổ đĩa ngoài có hình ảnh hệ điều hành hợp lệ rồi cắm lại khi đã sẵn sàng.</translation>
<translation id="6453188622241717495">Mở khoá trình tải khởi động</translation>
<translation id="65237697078188559">Shell chương trình cơ sở</translation>
<translation id="6526005868180962531">Khi ổ đĩa khôi phục đã sẵn sàng, hãy cắm vào thiết bị này để bắt đầu quy trình khôi phục.</translation>
<translation id="6870233504224262352">Đừng tắt thiết bị. Quá trình này có thể mất chút thời gian.</translation>
<translation id="6933530204467815794">Đã kết nối qua TCP</translation>
<translation id="6972383785688794804">Trang trên</translation>
<translation id="7065553583078443466">Chọn trình tải khởi động thay thế</translation>
<translation id="7071202423630761214">Đã kết nối qua USB</translation>
<translation id="7126032376876878896">Dùng nút nguồn để chọn một tùy chọn.</translation>
<translation id="714708458581824276">Phân vùng khôi phục qua Internet bị hỏng hoặc bị thiếu. Thay vào đó, hãy dùng ổ đĩa USB hoặc thẻ SD.</translation>
<translation id="7321387134821904291">Thông tin về tình trạng bộ nhớ</translation>
<translation id="7332672207700801967">Khôi phục bằng kết nối Internet (phiên bản cũ hơn)</translation>
<translation id="7342794948394983731">Công cụ chẩn đoán</translation>
<translation id="7352651011704765696">Đã xảy ra lỗi</translation>
<translation id="7356165460126686730">Sử dụng kết nối Internet</translation>
<translation id="7363327341920650426">Đã tắt chế độ khởi động bằng trình tải khởi động đã mở khoá. Để bật chế độ này, hãy khởi động lại vào hệ điều hành rồi bật chế độ mở khoá OEM trong Tuỳ chọn cho nhà phát triển. Tìm hiểu thêm tại:</translation>
<translation id="7379220436569534523">Thao tác này sẽ khoá trình tải khởi động và khôi phục thiết bị về trạng thái ban đầu.</translation>
<translation id="7658239707568436148">Hủy</translation>
<translation id="7666722144169757891">Hình ảnh khôi phục này quá cũ đối với thiết bị. Hãy tải hình ảnh khôi phục mới xuống rồi thử lại.</translation>
<translation id="7768922467835418715">Không phát hiện ổ đĩa ngoài</translation>
<translation id="786846615651935749">2. Thiết bị khác có kết nối Internet</translation>
<translation id="7939062555109487992">Tùy chọn nâng cao</translation>
<translation id="8003769027543821178">1. Ổ đĩa USB hoặc thẻ SD</translation>
<translation id="8011335065515332253">Sau khi hết thời gian chờ, thiết bị sẽ tự động khởi động theo tùy chọn được chọn ở bên dưới.</translation>
<translation id="8116993605321079294">Đã xảy ra lỗi khi chạy trình tải khởi động thay thế. Xem nhật ký của chương trình cơ sở để biết thông tin chi tiết.</translation>
<translation id="8131740175452115882">Xác nhận</translation>
<translation id="8182314305006465525">Bạn đang ở chế độ khởi động nhanh của trình tải khởi động</translation>
<translation id="8315682102205416794">Sử dụng ổ đĩa USB hoặc thẻ SD</translation>
<translation id="8377165353588213941">Bạn đã ở trang cuối cùng</translation>
<translation id="8547898031669202422">Đã tắt chế độ khởi động từ ổ đĩa ngoài. Tìm hiểu thêm tại:</translation>
<translation id="8569584079758810124">Không nhận được thông tin gỡ lỗi.</translation>
<translation id="8609689706517017461">Phân vùng khôi phục qua Internet bị hỏng hoặc bị thiếu. Hãy sử dụng ổ đĩa USB.</translation>
<translation id="8720490351198901261">Bạn đã ở trang đầu tiên</translation>
<translation id="8738563743369620892">Bạn không thể dùng bàn phím để mở khoá trình tải khởi động. Hãy sử dụng nút Nguồn ( ⏻ ).</translation>
<translation id="8856927881878864573">2. Nhấn và giữ nút Tăng âm lượng + Giảm âm lượng + Nguồn ( ⏻ ) trong ít nhất 10 giây.</translation>
<translation id="8878311588372127478">Tự kiểm tra bộ nhớ (mở rộng)</translation>
<translation id="8975826224585429326">Không tìm thấy trình tải khởi động thay thế. Để tìm hiểu cách cài đặt trình tải khởi động, hãy truy cập:</translation>
<translation id="9004305007436435169">Không nhận được thông tin chẩn đoán.</translation>
<translation id="9037104512788860027">Không cho phép khởi động bằng trình tải khởi động đã mở khoá. Tìm hiểu thêm tại:</translation>
<translation id="9111102763498581341">Mở khoá</translation>
</translationbundle>