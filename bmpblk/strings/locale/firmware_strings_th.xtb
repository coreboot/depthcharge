<!DOCTYPE translationbundle>
<translationbundle lang="th">
<translation id="1014836725110176376">1. ไปที่ <ph name="REC_URL" /> ในอุปกรณ์อีกเครื่อง</translation>
<translation id="1201402288615127009">ถัดไป</translation>
<translation id="1327914510899744949">Bootloader Fastboot</translation>
<translation id="1428255359211557126">การตรวจสอบหน่วยความจำ (แบบด่วน)</translation>
<translation id="1472222389773595668">ตั้งค่าไดรฟ์การกู้คืน</translation>
<translation id="1483971085438511843">ใช้แป้น Enter เพื่อเลือกตัวเลือก</translation>
<translation id="1512607074848104909">เสียบไดรฟ์ภายนอกที่มีอิมเมจระบบปฏิบัติการ อุปกรณ์จะเปิดเครื่องโดยอัตโนมัติ</translation>
<translation id="1618959600706780970">อุปกรณ์ของคุณจะไม่ปลอดภัยขณะที่ Bootloader ปลดล็อกอยู่ ล็อก Bootloader เพื่อคืนค่าความปลอดภัยของอุปกรณ์</translation>
<translation id="1851498512110506461">ระบบจะล้างข้อมูลผู้ใช้ในระหว่างดำเนินการ</translation>
<translation id="1880493276474218432">คุณจะต้องมีสิ่งต่อไปนี้เพื่อสร้างไดรฟ์การกู้คืน</translation>
<translation id="1995660704900986789">ปิดเครื่อง</translation>
<translation id="2022309272630265316">ไม่พบอิมเมจที่ถูกต้อง</translation>
<translation id="2164852388827548816">บันทึกเฟิร์มแวร์</translation>
<translation id="2242127796967618375">ดูข้อมูลเพิ่มเติมที่:</translation>
<translation id="2340902555262319714">2. ขณะที่กดปุ่มกู้คืนค้างไว้ ให้กดปุ่มเปิด/ปิด ( ⏻) แล้วปล่อย จากนั้นจึงปล่อยปุ่มกู้คืน</translation>
<translation id="2730585974895524161">Bootloader ปลดล็อกอยู่</translation>
<translation id="2861620505929653443">ปลดล็อก Bootloader ไหม</translation>
<translation id="2969699099866537016">ตรวจสอบว่าไดรฟ์การกู้คืนมีอิมเมจที่ถูกต้องแล้วลองอีกครั้ง</translation>
<translation id="3165751548024554961">แบตเตอรี่ของอุปกรณ์เหลือน้อย เชื่อมต่อกับแหล่งจ่ายไฟเพื่อดำเนินการต่อ</translation>
<translation id="3174560100798162637">ขอแนะนำให้เชื่อมต่ออุปกรณ์กับแหล่งจ่ายไฟ</translation>
<translation id="3294574173405124634">การติดธง GBB ไม่อนุญาตให้กลับไปยังโหมดปลอดภัย</translation>
<translation id="330703583939423765">1. นำอุปกรณ์ทั้งหมดที่เชื่อมต่ออยู่ออก</translation>
<translation id="361826164482194215">ปิดใช้ Bootloader สำรองอยู่ ดูข้อมูลเพิ่มเติมที่:</translation>
<translation id="3697087251845525042">การทดสอบพื้นที่เก็บข้อมูลด้วยตนเอง (แบบใช้เวลาน้อย)</translation>
<translation id="3784455785234192852">ล็อก</translation>
<translation id="3848046184877245923">เริ่มกระบวนการกู้คืน</translation>
<translation id="385051799172605136">กลับ</translation>
<translation id="3931222419141306012">อิมเมจการกู้คืนที่ล้าสมัย</translation>
<translation id="4002335453596341558">เลื่อนหน้าลง</translation>
<translation id="4228286289437521015">การดำเนินการนี้จะลบข้อมูลทั้งหมดออกจากอุปกรณ์ ระบบรักษาความปลอดภัยของอุปกรณ์จะถูกปิดใช้</translation>
<translation id="4231467600151418708">2. กด Esc + รีเฟรช ( ⟳ ) + เปิด/ปิด ( ⏻ ) ค้างไว้</translation>
<translation id="4410491068110727276">ใช้ปุ่มปรับระดับเสียงเพื่อเลื่อนขึ้นหรือลง</translation>
<translation id="46859019225980199">หากต้องการแก้ไขปัญหานี้ ให้เริ่มกระบวนการกู้คืน</translation>
<translation id="4773280894882892048">ข้อมูลการแก้ไขข้อบกพร่อง</translation>
<translation id="4815374450404670311">การตรวจสอบหน่วยความจำ (เต็มรูปแบบ)</translation>
<translation id="4986594717579135906">อุปกรณ์กำลังอัปเดตให้เสร็จสิ้น ขั้นตอนนี้อาจใช้เวลา 1 ถึง 2 นาที
โปรดอย่าปิดอุปกรณ์</translation>
<translation id="4991849386608920411">กดปุ่มกู้คืนในอุปกรณ์เพื่อปลดล็อก Bootloader หรือเลือก "ยกเลิก" เพื่อคงการป้องกันไว้</translation>
<translation id="5018618999152115810">ใช้ไดรฟ์ USB</translation>
<translation id="5184662919967270437">กำลังอัปเดตอุปกรณ์ของคุณ</translation>
<translation id="5232488980254489397">เปิดการวินิจฉัย</translation>
<translation id="5258940999070776327">เลือกการทดสอบที่จะเรียกใช้</translation>
<translation id="5288652088496335604">เลือกวิธีการกู้คืนเพื่อเริ่มต้นใช้งาน</translation>
<translation id="5447452894128399840">2. ทำตามวิธีการในอุปกรณ์อีกเครื่อง</translation>
<translation id="5477875595374685515">โหลดบันทึกเฟิร์มแวร์ไม่ได้</translation>
<translation id="5511340521509645831">เปิดเครื่องจากไดรฟ์ภายนอก</translation>
<translation id="5592705604979238266">ศูนย์ช่วยเหลือ:</translation>
<translation id="5704836750240170251">ล็อก Bootloader</translation>
<translation id="5733004683773923934">เกิดข้อผิดพลาดในการเปิดเครื่องจากดิสก์ภายใน ดูรายละเอียดได้ที่ตัวเลือกขั้นสูง &gt; บันทึกเฟิร์มแวร์</translation>
<translation id="5831266751064943765">คุณใช้แป้นพิมพ์ภายนอกปลดล็อก Bootloader ไม่ได้ ใช้แป้นพิมพ์ในตัว</translation>
<translation id="5846715299792649254">1. ไดรฟ์ USB</translation>
<translation id="589807000231180230">กำลังรอการเชื่อมต่อ...</translation>
<translation id="6073029132385600270">เตรียมกู้คืนอุปกรณ์ของคุณ</translation>
<translation id="6172915643608608639">บูตจากดิสก์ภายใน</translation>
<translation id="6209959435052494013">ล็อก Bootloader ไหม</translation>
<translation id="6259657716425232440">ปลดล็อก Bootloader แล้ว</translation>
<translation id="6326551461084488743">อุปกรณ์:</translation>
<translation id="635783852215913562">ใช้แป้นลูกศรเพื่อเลื่อนขึ้นหรือลง</translation>
<translation id="6437078769036639380">ตรวจสอบว่าไดรฟ์ภายนอกมีอิมเมจระบบปฏิบัติการที่ถูกต้องแล้วใส่ไดรฟ์อีกครั้งเมื่อพร้อม</translation>
<translation id="6453188622241717495">ปลดล็อก Bootloader</translation>
<translation id="65237697078188559">Shell เฟิร์มแวร์</translation>
<translation id="6526005868180962531">เมื่อไดรฟ์การกู้คืนพร้อมแล้ว ให้เสียบเข้ากับอุปกรณ์นี้เพื่อเริ่มขั้นตอนการกู้คืน</translation>
<translation id="6870233504224262352">เปิดอุปกรณ์ไว้ การดำเนินการนี้อาจใช้เวลาสักครู่</translation>
<translation id="6933530204467815794">เชื่อมต่อผ่าน TCP</translation>
<translation id="6972383785688794804">เลื่อนหน้าขึ้น</translation>
<translation id="7065553583078443466">เลือก Bootloader อื่น</translation>
<translation id="7071202423630761214">เชื่อมต่อผ่าน USB</translation>
<translation id="7126032376876878896">ใช้ปุ่มเปิด/ปิดเพื่อเลือกตัวเลือก</translation>
<translation id="714708458581824276">พาร์ติชันการกู้คืนอินเทอร์เน็ตเสียหายหรือไม่มี โปรดใช้ไดรฟ์ USB หรือการ์ด SD แทน</translation>
<translation id="7321387134821904291">ข้อมูลความสมบูรณ์ของพื้นที่เก็บข้อมูล</translation>
<translation id="7332672207700801967">การกู้คืนอินเทอร์เน็ต (เวอร์ชันเก่า)</translation>
<translation id="7342794948394983731">เครื่องมือวินิจฉัย</translation>
<translation id="7352651011704765696">มีข้อผิดพลาดเกิดขึ้น</translation>
<translation id="7356165460126686730">ใช้การเชื่อมต่ออินเทอร์เน็ต</translation>
<translation id="7363327341920650426">ปิดใช้การเปิดเครื่องด้วย Bootloader ที่ปลดล็อกอยู่ หากต้องการเปิดใช้ ให้รีบูตไปยังระบบปฏิบัติการและเปิดใช้การปลดล็อก OEM ในตัวเลือกสำหรับนักพัฒนาแอป ดูข้อมูลเพิ่มเติมที่:</translation>
<translation id="7379220436569534523">การดำเนินการนี้จะล็อก Bootloader และคืนค่าอุปกรณ์เป็นสถานะดั้งเดิม</translation>
<translation id="7658239707568436148">ยกเลิก</translation>
<translation id="7666722144169757891">อิมเมจการกู้คืนนี้เก่าเกินไปสำหรับอุปกรณ์ของคุณ ดาวน์โหลดอิมเมจการกู้คืนใหม่แล้วลองอีกครั้ง</translation>
<translation id="7768922467835418715">ไม่พบไดรฟ์ภายนอก</translation>
<translation id="786846615651935749">2. อุปกรณ์อื่นที่มีการเชื่อมต่ออินเทอร์เน็ต</translation>
<translation id="7939062555109487992">ตัวเลือกขั้นสูง</translation>
<translation id="8003769027543821178">1. ไดรฟ์ USB หรือการ์ด SD</translation>
<translation id="8011335065515332253">หลังจากหมดเวลาแล้ว อุปกรณ์จะเปิดเครื่องโดยอัตโนมัติจากตัวเลือกด้านล่าง</translation>
<translation id="8116993605321079294">เกิดข้อผิดพลาดในการเปิด Bootloader สำรอง ดูรายละเอียดได้จากบันทึกเฟิร์มแวร์</translation>
<translation id="8131740175452115882">ยืนยัน</translation>
<translation id="8182314305006465525">คุณอยู่ใน Fastboot Mode ของ Bootloader</translation>
<translation id="8315682102205416794">ใช้ไดรฟ์ USB หรือการ์ด SD</translation>
<translation id="8377165353588213941">มาถึงส่วนสุดท้ายแล้ว</translation>
<translation id="8547898031669202422">ปิดใช้การเปิดเครื่องจากไดรฟ์ภายนอกอยู่ ดูข้อมูลเพิ่มเติมที่:</translation>
<translation id="8569584079758810124">โหลดข้อมูลการแก้ไขข้อบกพร่องไม่ได้</translation>
<translation id="8609689706517017461">พาร์ติชันการกู้คืนอินเทอร์เน็ตเสียหายหรือไม่มี ใช้ไดรฟ์ USB แทน</translation>
<translation id="8720490351198901261">มาถึงส่วนบนสุดแล้ว</translation>
<translation id="8738563743369620892">คุณใช้แป้นพิมพ์ปลดล็อก Bootloader ไม่ได้ ใช้ปุ่มเปิด/ปิด ( ⏻ )</translation>
<translation id="8856927881878864573">2. กดปุ่มเพิ่มระดับเสียง + ลดระดับเสียง + ปุ่มเปิด/ปิด ( ⏻ ) ค้างไว้อย่างน้อย 10 วินาที</translation>
<translation id="8878311588372127478">การทดสอบพื้นที่เก็บข้อมูลด้วยตนเอง (แบบใช้เวลานาน)</translation>
<translation id="8975826224585429326">ไม่พบ Bootloader สำรอง ดูวิธีติดตั้งได้ที่</translation>
<translation id="9004305007436435169">โหลดข้อมูลการวินิจฉัยไม่ได้</translation>
<translation id="9037104512788860027">ไม่อนุญาตให้เปิดเครื่องด้วย Bootloader ที่ปลดล็อกแล้ว ดูข้อมูลเพิ่มเติมที่:</translation>
<translation id="9111102763498581341">ปลดล็อก</translation>
</translationbundle>