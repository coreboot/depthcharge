<translation id="1014836725110176376">1. Otvorite <ph name="REC_URL" /> na drugom uređaju</translation>
<translation id="1201402288615127009">Dalje</translation>
<translation id="1327914510899744949">Brzo podizanje pokretača operativnog sustava</translation>
<translation id="1428255359211557126">Provjera memorije (brza)</translation>
<translation id="1472222389773595668">Postavite disk za oporavak</translation>
<translation id="1483971085438511843">Za odabir opcije koristite se tipkom Enter.</translation>
<translation id="1512607074848104909">Priključite vanjski disk sa slikom OS-a. Uređaj će se automatski pokrenuti.</translation>
<translation id="1618959600706780970">Vaš uređaj nije siguran dok je pokretač operativnog sustava otključan. Da biste vratili sigurnost uređaja, zaključajte pokretač operativnog sustava.</translation>
<translation id="1851498512110506461">Tijekom postupka korisnički podaci će se izbrisati.</translation>
<translation id="1880493276474218432">Da biste izradili disk za oporavak, trebat će vam sljedeće:</translation>
<translation id="1995660704900986789">Isključi</translation>
<translation id="2022309272630265316">Nije otkrivena valjana slika</translation>
<translation id="2164852388827548816">Zapisnik o firmwareu</translation>
<translation id="2242127796967618375">Saznajte više na:</translation>
<translation id="2340902555262319714">2. Dok držite gumb za oporavak, pritisnite i otpustite tipku za uključivanje/isključivanje ( ⏻ ), a zatim otpustite gumb za oporavak.</translation>
<translation id="2730585974895524161">Pokretač operativnog sustava je otključan</translation>
<translation id="2861620505929653443">Želite li otključati pokretač operativnog sustava?</translation>
<translation id="2969699099866537016">Provjerite ima li vaš disk za oporavak važeću sliku i pokušajte ponovno.</translation>
<translation id="3165751548024554961">Baterija uređaja je slaba. Povežite se s izvorom napajanja da biste nastavili.</translation>
<translation id="3174560100798162637">Preporučujemo da uređaj spojite na izvor napajanja.</translation>
<translation id="3294574173405124634">Povratak u sigurni način zabranjen je pomoću GBB oznaka.</translation>
<translation id="330703583939423765">1. Uklonite sve povezane proizvode.</translation>
<translation id="361826164482194215">Alternativni pokretači operativnog sustava su onemogućeni. Saznajte više na:</translation>
<translation id="3697087251845525042">Samotestiranje pohrane (kratko)</translation>
<translation id="3784455785234192852">Zaključaj</translation>
<translation id="3848046184877245923">Pokrenite postupak oporavka</translation>
<translation id="385051799172605136">Natrag</translation>
<translation id="3931222419141306012">Zastarjela slika za oporavak</translation>
<translation id="4002335453596341558">Stranica prema dolje</translation>
<translation id="4228286289437521015">Time će se izbrisati svi podaci s vašeg uređaja. Sigurnost uređaja bit će onemogućena.</translation>
<translation id="4231467600151418708">2. Pritisnite i zadržite tipke Esc, Refresh ( ⟳ ) i Power ( ⏻ ).</translation>
<translation id="4410491068110727276">Za kretanje prema gore ili dolje koristite se tipkama za glasnoću.</translation>
<translation id="46859019225980199">Da biste riješili taj problem, pokrenite postupak oporavka.</translation>
<translation id="4773280894882892048">Informacije o otklanjanju pogrešaka</translation>
<translation id="4815374450404670311">Provjera memorije (potpuna)</translation>
<translation id="4986594717579135906">Your device is finishing an update. This may take 1-2 minutes.
Please do not turn off your device.</translation>
<translation id="4991849386608920411">Pritisnite tipku za oporavak na uređaju da biste otključali pokretač operativnog sustava ili odaberite Odustani da biste ostali zaštićeni.</translation>
<translation id="5018618999152115810">Upotrijebite USB disk</translation>
<translation id="5184662919967270437">Ažuriranje uređaja</translation>
