<translation id="5258940999070776327">Odaberite test za pokretanje</translation>
<translation id="5288652088496335604">Za početak odaberite način oporavka.</translation>
<translation id="5447452894128399840">2. Slijedite upute na drugom uređaju</translation>
<translation id="5477875595374685515">Dohvaćanje zapisnika firmwarea nije uspjelo.</translation>
<translation id="5511340521509645831">Pokreni s vanjskog diska</translation>
<translation id="5592705604979238266">Centar za pomoć:</translation>
<translation id="5704836750240170251">Zaključaj pokretač operativnog sustava</translation>
<translation id="5733004683773923934">Nešto nije u redu s pokretanjem s internog diska. Pojedinosti potražite u odjeljku Napredne opcije &gt; Zapisnik o firmwareu.</translation>
<translation id="5831266751064943765">Ne možete otključati pokretač operativnog sustava pomoću vanjske tipkovnice. Upotrijebite ugrađenu tipkovnicu.</translation>
<translation id="5846715299792649254">1. USB disk</translation>
<translation id="589807000231180230">Čeka se na uspostavu veze…</translation>
<translation id="6073029132385600270">Pripremite se za oporavak svojeg uređaja</translation>
<translation id="6172915643608608639">Pokretanje s unutarnjeg diska</translation>
<translation id="6209959435052494013">Želite li zaključati pokretač operativnog sustava?</translation>
<translation id="6259657716425232440">Pokretač operativnog sustava već je otključan.</translation>
<translation id="6326551461084488743">Uređaj:</translation>
<translation id="635783852215913562">Za kretanje prema gore i dolje koristite se tipkama sa strelicama.</translation>
<translation id="6437078769036639380">Provjerite ima li vaš vanjski disk važeću sliku OS-a i ponovno ga umetnite kad bude spreman.</translation>
<translation id="6453188622241717495">Otključaj pokretač operativnog sustava</translation>
<translation id="65237697078188559">Ljuska firmwarea</translation>
<translation id="6526005868180962531">Kad je disk za oporavak spreman, priključite ga u uređaj da biste pokrenuli postupak oporavka.</translation>
<translation id="6870233504224262352">Uređaj mora biti uključen. Ovo može potrajati.</translation>
<translation id="6933530204467815794">Povezano putem TCP-a</translation>
<translation id="6972383785688794804">Stranica prema gore</translation>
<translation id="7065553583078443466">Odaberite zamjenski pokretač operativnog sustava</translation>
<translation id="7071202423630761214">Povezano putem USB-a</translation>
<translation id="7126032376876878896">Za odabir opcije upotrijebite tipku za uključivanje/isključivanje.</translation>
<translation id="714708458581824276">Particija za oporavak putem interneta oštećena je ili nedostaje. Umjesto toga upotrijebite USB disk ili SD karticu.</translation>
<translation id="7321387134821904291">Informacije o stanju pohrane</translation>
<translation id="7332672207700801967">Oporavak interneta (starija verzija)</translation>
<translation id="7342794948394983731">Dijagnostički alati</translation>
<translation id="7352651011704765696">Nešto nije u redu</translation>
<translation id="7356165460126686730">Upotrijebite internetsku vezu</translation>
<translation id="7363327341920650426">Pokretanje s otključanim pokretačem operativnog sustava je onemogućeno. Da biste ga omogućili, ponovno pokrenite OS i omogućite OEM otključavanje u opcijama za razvojne programere. Saznajte više na:</translation>
<translation id="7379220436569534523">Time će se zaključati pokretač operativnog sustava i uređaj će se vratiti u izvorno stanje.</translation>
<translation id="7658239707568436148">Odustani</translation>
<translation id="7666722144169757891">Ova je slika za oporavak prestara za vaš uređaj. Preuzmite novu sliku za oporavak i pokušajte ponovno.</translation>
<translation id="7768922467835418715">Nije otkriven vanjski disk</translation>
<translation id="786846615651935749">2. Drugi uređaj s internetskom vezom</translation>
<translation id="7939062555109487992">Napredne opcije</translation>
<translation id="8003769027543821178">1. USB disk ili SD kartica</translation>
<translation id="8011335065515332253">Nakon vremena čekanja uređaj će se automatski pokrenuti u skladu s opcijom odabranom u nastavku.</translation>
<translation id="8116993605321079294">Došlo je do pogreške prilikom pokretanja alternativnog početnog programa za pokretanje. Pojedinosti potražite u zapisniku firmwarea.</translation>
<translation id="8131740175452115882">Potvrdi</translation>
<translation id="8182314305006465525">U načinu ste brzog podizanja pokretača operativnog sustava</translation>
<translation id="8315682102205416794">Upotrijebite USB disk ili SD karticu</translation>
<translation id="8377165353588213941">Stigli ste do kraja</translation>
<translation id="8547898031669202422">Pokretanje s vanjskog diska je onemogućeno. Saznajte više na:</translation>
<translation id="8569584079758810124">Dohvaćanje informacija o otklanjanju pogrešaka nije uspjelo.</translation>
<translation id="8609689706517017461">Particija za oporavak putem interneta oštećena je ili nedostaje. Upotrijebite USB disk.</translation>
<translation id="8720490351198901261">Stigli ste do vrha</translation>
<translation id="8738563743369620892">Ne možete upotrijebiti tipkovnicu za otključavanje pokretača operativnog sustava. Upotrijebite tipku za uključivanje/isključivanje ( ⏻ ).</translation>
<translation id="8856927881878864573">2. Pritisnite tipke za pojačavanje glasnoće, stišavanje glasnoće i uključivanje/isključivanje ( ⏻ ) i zadržite pritisak najmanje deset sekundi.</translation>
<translation id="8878311588372127478">Samotestiranje pohrane (prošireno)</translation>
<translation id="8975826224585429326">Alternativni pokretač operativnog sustava nije pronađen. Da biste saznali kako ga instalirati, posjetite:</translation>
<translation id="9004305007436435169">Dohvaćanje dijagnostičkih podataka nije uspjelo.</translation>
<translation id="9037104512788860027">Pokretanje s otključanim pokretačem operativnog sustava nije dopušteno. Saznajte više na:</translation>
<translation id="9111102763498581341">Otključaj</translation>
