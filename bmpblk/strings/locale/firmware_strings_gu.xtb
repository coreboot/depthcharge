<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="gu">
<translation id="1014836725110176376">1. તમારા અન્ય ડિવાઇસ પરના <ph name="REC_URL" /> પર જાઓ</translation>
<translation id="1201402288615127009">આગલું</translation>
<translation id="1327914510899744949">બૂટલોડર ફાસ્ટબૂટ</translation>
<translation id="1428255359211557126">મેમરી ચેક કરવાની સુવિધા (ઝટપટ)</translation>
<translation id="1472222389773595668">તમારી રિકવરી ડ્રાઇવનું સેટઅપ કરો</translation>
<translation id="1483971085438511843">કોઈ વિકલ્પ પસંદ કરવા માટે એન્ટર કીનો ઉપયોગ કરો.</translation>
<translation id="1512607074848104909">OSની છબી ધરાવતી બાહ્ય ડ્રાઇવ પ્લગ ઇન કરો. તમારું ડિવાઇસ ઑટોમૅટિક રીતે બૂટ થશે.</translation>
<translation id="1618959600706780970">બૂટલોડર અનલૉક કરેલું હોય ત્યારે તમારું ડિવાઇસ સુરક્ષિત હોતું નથી. ડિવાઇસની સુરક્ષા રિસ્ટોર કરવા માટે, બૂટલોડર લૉક કરો.</translation>
<translation id="1851498512110506461">આ પ્રક્રિયામાં વપરાશકર્તાનો ડેટા વાઇપ કરવામાં આવશે.</translation>
<translation id="1880493276474218432">કોઈ રિકવરી ડ્રાઇવ બનાવવા માટે, તમને આની જરૂર પડશે:</translation>
<translation id="1995660704900986789">પાવર બંધ કરો</translation>
<translation id="2022309272630265316">કોઈ માન્ય છબી જોવા મળી નથી</translation>
<translation id="2164852388827548816">ફર્મવેયર લૉગ</translation>
<translation id="2242127796967618375">અહીં વધુ જાણો:</translation>
<translation id="2340902555262319714">2. રિકવરી બટન દબાવી રાખતી વખતે, પાવર બટન ( ⏻ ) દબાવીને છોડી દો, પછી રિકવરી બટન છોડી દો.</translation>
<translation id="2730585974895524161">બૂટલોડર અનલૉક કરેલું છે</translation>
<translation id="2861620505929653443">બૂટલોડર અનલૉક કરીએ?</translation>
<translation id="2969699099866537016">તમારી રિકવરી ડ્રાઇવમાં માન્ય છબી હોવાની ખાતરી કરીને ફરી પ્રયાસ કરો.</translation>
<translation id="3165751548024554961">તમારા ડિવાઇસની બૅટરીનું લેવલ ઓછું છે. ચાલુ રાખવા માટે પાવર સૉર્સ સાથે કનેક્ટ કરો.</translation>
<translation id="3174560100798162637">તમારા ડિવાઇસને પાવર સ્રોત સાથે કનેક્ટ કરવાની ભલામણ કરવામાં આવે છે.</translation>
<translation id="3294574173405124634">GBB ફ્લૅગ દ્વારા સુરક્ષિત મોડ પર પાછા ફરવાનું નામંજૂર કરવામાં આવ્યું છે.</translation>
<translation id="330703583939423765">1. કનેક્ટ કરેલા બધા ડિવાઇસ કાઢી નાખો.</translation>
<translation id="361826164482194215">વૈકલ્પિક બૂટલોડર બંધ કરવામાં આવ્યા છે. અહીં વધુ જાણો:</translation>
<translation id="3697087251845525042">સ્ટોરેજ દ્વારા પોતાનું પરીક્ષણ કરવાની સુવિધા (ટૂંકી)</translation>
<translation id="3784455785234192852">લૉક કરો</translation>
<translation id="3848046184877245923">રિકવરીની પ્રક્રિયા શરૂ કરો</translation>
<translation id="385051799172605136">પાછળ</translation>
<translation id="3931222419141306012">જૂની રિકવરી છબી</translation>
<translation id="4002335453596341558">નીચેનું પેજ</translation>
<translation id="4228286289437521015">આમ કરવાથી તમારા ડિવાઇસમાંથી બધો ડેટા કાઢી નાખવામાં આવશે. ડિવાઇસની સુરક્ષા બંધ કરવામાં આવશે.</translation>
<translation id="4231467600151418708">2. Esc + રિફ્રેશ ( ⟳ ) + પાવર ( ⏻ ) દબાવી રાખો.</translation>
<translation id="4410491068110727276">ઉપર અથવા નીચે નૅવિગેટ કરવા માટે વૉલ્યૂમ બટનનો ઉપયોગ કરો.</translation>
<translation id="46859019225980199">આ સમસ્યાનું નિરાકરણ કરવા માટે, રિકવરીની પ્રક્રિયા શરૂ કરો.</translation>
<translation id="4773280894882892048">ડિબગ માહિતી</translation>
<translation id="4815374450404670311">મેમરી ચેક કરવાની સુવિધા (સંપૂર્ણ)</translation>
<translation id="4986594717579135906">Your device is finishing an update. This may take 1-2 minutes.
Please do not turn off your device.</translation>
<translation id="4991849386608920411">બૂટલોડરને અનલૉક કરવા માટે તમારા ડિવાઇસ પરનું રિકવરી બટન દબાવો અથવા સુરક્ષિત રહેવા માટે 'રદ કરો' પસંદ કરો.</translation>
<translation id="5018618999152115810">USB ડ્રાઇવનો ઉપયોગ કરો</translation>
<translation id="5184662919967270437">તમારું ડિવાઇસ અપડેટ કરી રહ્યાં છીએ</translation>
<translation id="5232488980254489397">નિદાન લૉન્ચ કરો</translation>
<translation id="5258940999070776327">ચલાવવા માટે કોઈ પરીક્ષણ પસંદ કરો</translation>
<translation id="5288652088496335604">શરૂ કરવા માટે કોઈ રિકવરી પદ્ધતિ પસંદ કરો.</translation>
<translation id="5447452894128399840">2. તમારા અન્ય ડિવાઇસ પર સૂચનાઓને અનુસરો</translation>
<translation id="5477875595374685515">ફર્મવેયર લૉગ મેળવી શકાયો નથી.</translation>
<translation id="5511340521509645831">બાહ્ય ડ્રાઇવ પરથી બૂટ કરો</translation>
<translation id="5592705604979238266">સહાયતા કેન્દ્ર:</translation>
<translation id="5704836750240170251">બૂટલોડર લૉક કરો</translation>
<translation id="5733004683773923934">આંતરિક ડિસ્ક પરથી બૂટ કરવામાં કંઈક ખોટું થયું. વિગતો માટે, વિગતવાર વિકલ્પો &gt; ફર્મવેયર લૉગ પર જાઓ.</translation>
<translation id="5831266751064943765">બૂટલોડરને અનલૉક કરવા માટે, તમે બાહ્ય કીબોર્ડનો ઉપયોગ કરી શકશો નહીં. બિલ્ટ-ઇન કીબોર્ડનો ઉપયોગ કરો.</translation>
<translation id="5846715299792649254">1. USB ડ્રાઇવ</translation>
<translation id="589807000231180230">કનેક્શનની રાહ જોઈ રહ્યાં છીએ...</translation>
<translation id="6073029132385600270">તમારા ડિવાઇસને રિકવર કરવા માટે તૈયાર થઈ જાઓ</translation>
<translation id="6172915643608608639">આંતરિક ડિસ્ક પરથી બૂટ કરો</translation>
<translation id="6209959435052494013">બૂટલોડર લૉક કરીએ?</translation>
<translation id="6259657716425232440">બૂટલોડર પહેલેથી અનલૉક કરેલું છે.</translation>
<translation id="6326551461084488743">ડિવાઇસ:</translation>
<translation id="635783852215913562">ઉપર કે નીચે નૅવિગેટ કરવા માટે એરો કીનો ઉપયોગ કરો.</translation>
<translation id="6437078769036639380">તમારી બાહ્ય ડ્રાઇવમાં OSની માન્ય છબી હોવાની ખાતરી કરો અને જ્યારે તે તૈયાર હોય, ત્યારે ફરીથી તેને શામેલ કરો.</translation>
<translation id="6453188622241717495">બૂટલોડર અનલૉક કરો</translation>
<translation id="65237697078188559">ફર્મવેયર શેલ</translation>
<translation id="6526005868180962531">જ્યારે તમારી રિકવરી ડ્રાઇવ તૈયાર થઈ જાય, ત્યારે રિકવરીની પ્રક્રિયા શરૂ કરવા માટે તેને આ ડિવાઇસમાં પ્લગ કરો.</translation>
<translation id="6870233504224262352">તમારું ડિવાઇસ ચાલુ રાખો. આમાં થોડો સમય લાગી શકે છે.</translation>
<translation id="6933530204467815794">TCP મારફતે કનેક્ટેડ</translation>
<translation id="6972383785688794804">ઉપરનું પેજ</translation>
<translation id="7065553583078443466">વૈકલ્પિક બૂટલોડર પસંદ કરો</translation>
<translation id="7071202423630761214">USB મારફતે કનેક્ટેડ</translation>
<translation id="7126032376876878896">કોઈ વિકલ્પ પસંદ કરવા માટે પાવર બટનનો ઉપયોગ કરો.</translation>
<translation id="714708458581824276">ઇન્ટરનેટ રિકવરીનું પાર્ટિશન દૂષિત છે અથવા ખૂટે છે. તેના બદલે USB ડ્રાઇવ અથવા SD કાર્ડનો ઉપયોગ કરો.</translation>
<translation id="7321387134821904291">સ્ટોરેજના સ્ટેટસ સંબંધિત માહિતી</translation>
<translation id="7332672207700801967">ઇન્ટરનેટ રિકવરી (જૂનું વર્ઝન)</translation>
<translation id="7342794948394983731">નિદાન માટેના સાધનો</translation>
<translation id="7352651011704765696">કંઈક ખોટું થયું હતું</translation>
<translation id="7356165460126686730">ઇન્ટરનેટ કનેક્શનનો ઉપયોગ કરો</translation>
<translation id="7363327341920650426">અનલૉક કરેલા કોઈ બૂટલોડર વડે બૂટ કરવાની સુવિધા બંધ કરવામાં આવી છે. તેને ચાલુ કરવા માટે, OS પર રીબૂટ કરો અને ડેવલપરના વિકલ્પોમાં OEM અનલૉક કરવાની સુવિધા ચાલુ કરો. અહીં વધુ જાણો:</translation>
<translation id="7379220436569534523">આમ કરવાથી બૂટલોડર લૉક થઈ જશે અને તમારું ડિવાઇસ તેની મૂળ સ્થિતિ પર રિસ્ટોર થઈ જશે.</translation>
<translation id="7658239707568436148">રદ કરો</translation>
<translation id="7666722144169757891">તમારા ડિવાઇસ માટે આ રિકવરી છબી ઘણી જૂની છે. નવી રિકવરી છબી ડાઉનલોડ કરો અને ફરી પ્રયાસ કરો.</translation>
<translation id="7768922467835418715">કોઈ બાહ્ય ડ્રાઇવની ભાળ મળી નથી</translation>
<translation id="786846615651935749">2. ઇન્ટરનેટ કનેક્શન ધરાવતું અન્ય ડિવાઇસ</translation>
<translation id="7939062555109487992">વિગતવાર વિકલ્પો</translation>
<translation id="8003769027543821178">1. USB ડ્રાઇવ અથવા SD કાર્ડ</translation>
<translation id="8011335065515332253">સમયસમાપ્તિ પછી, ડિવાઇસ નીચેની પસંદગીમાંથી ઑટોમૅટિક રીતે બૂટ થશે.</translation>
<translation id="8116993605321079294">વૈકલ્પિક બૂટલોડર લૉન્ચ કરતી વખતે કંઈક ખોટું થયું. વિગતો માટે, ફર્મવેયર લૉગ જુઓ.</translation>
<translation id="8131740175452115882">કન્ફર્મ કરો</translation>
<translation id="8182314305006465525">તમે બૂટલોડર ફાસ્ટબૂટ મોડ (Fastboot mode)માં છો</translation>
<translation id="8315682102205416794">USB ડ્રાઇવ અથવા SD કાર્ડનો ઉપયોગ કરો</translation>
<translation id="8377165353588213941">તમે સમાપ્તિ પર પહોંચી ગયા છો</translation>
<translation id="8547898031669202422">બાહ્ય ડ્રાઇવમાંથી બૂટ કરવાની સુવિધા બંધ કરવામાં આવી છે. અહીં વધુ જાણો:</translation>
<translation id="8569584079758810124">ડિબગ માહિતી મેળવી શકાઈ નથી.</translation>
<translation id="8609689706517017461">ઇન્ટરનેટ રિકવરીનું પાર્ટિશન દૂષિત છે અથવા ખૂટે છે. તેના બદલે USB ડ્રાઇવનો ઉપયોગ કરો.</translation>
<translation id="8720490351198901261">તમે સૌથી ઉપર પહોંચી ગયા છો</translation>
<translation id="8738563743369620892">બૂટલોડરને અનલૉક કરવા માટે, તમે કીબોર્ડનો ઉપયોગ કરી શકશો નહીં. પાવર બટન ( ⏻ )નો ઉપયોગ કરો.</translation>
<translation id="8856927881878864573">2. ઓછામાં ઓછી 10 સેકન્ડ માટે વૉલ્યૂમ વધારો + વૉલ્યૂમ ઘટાડો + પાવર બટન ( ⏻ ) દબાવી રાખો.</translation>
<translation id="8878311588372127478">સ્ટોરેજ દ્વારા પોતાનું પરીક્ષણ કરવાની સુવિધા (વધારવામાં આવેલી)</translation>
<translation id="8975826224585429326">કોઈ વૈકલ્પિક બૂટલોડર મળી રહ્યું નથી. બૂટલોડર ઇન્સ્ટૉલ કરવાની રીત જાણવા માટે, અહીં મુલાકાત લો:</translation>
<translation id="9004305007436435169">નિદાનની માહિતી મેળવી શકાઈ નથી.</translation>
<translation id="9037104512788860027">અનલૉક કરેલા કોઈ બૂટલોડર વડે બૂટ કરવાની મંજૂરી નથી. અહીં વધુ જાણો:</translation>
<translation id="9111102763498581341">અનલૉક કરો</translation>
</translationbundle>