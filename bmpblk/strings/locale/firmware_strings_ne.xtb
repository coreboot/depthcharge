<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ne">
<translation id="1201402288615127009">अर्को</translation>
<translation id="1428255359211557126">मेमोरीको जाँच (द्रुत)</translation>
<translation id="1483971085438511843">कुनै विकल्प चयन गर्न इन्टर कुञ्जी प्रयोग गर्नुहोस्।</translation>
<translation id="1995660704900986789">निष्क्रिय पार्नुहोस्</translation>
<translation id="2022309272630265316">कुनै पनि वैध फोटो फेला परेन</translation>
<translation id="2164852388827548816">फर्मवेयरसम्बन्धी लग</translation>
<translation id="3174560100798162637">हामी तपाईंलाई आफ्नो यन्त्र चार्जिङको स्रोतमा जोड्न सिफारिस गर्छौँ।</translation>
<translation id="3294574173405124634">GBB फ्ल्यागमा तोकिएको नीतिअनुसार सुरक्षित मोडमा फर्कन मिल्दैन।</translation>
<translation id="3697087251845525042">आफै भण्डारणको जाँच गर्ने सुविधा (थोरै समय लाग्ने)</translation>
<translation id="385051799172605136">पछाडि जानुहोस्</translation>
<translation id="4002335453596341558">पेज डाउन</translation>
<translation id="4410491068110727276">माथि वा तल जान भोल्युम बटनहरू प्रयोग गर्नुहोस्।</translation>
<translation id="4773280894882892048">डिबगसम्बन्धी जानकारी</translation>
<translation id="4815374450404670311">मेमोरीको जाँच (पूर्ण)</translation>
<translation id="4986594717579135906">तपाईंको डिभाइस अपडेट गर्ने कार्य पूरा भइरहेको छ। यो कार्य गर्न १ देखि २ मिनेटसम्म लाग्न सक्छ।
कृपया आफ्नो डिभाइस अफ नगर्नुहोला।</translation>
<translation id="5232488980254489397">निदान प्रक्रिया सुरु गर्नुहोस्</translation>
<translation id="5477875595374685515">फर्मवेयर लग प्राप्त गर्न सकिएन।</translation>
<translation id="5592705604979238266">मद्दत केन्द्र:</translation>
<translation id="6172915643608608639">आन्तरिक डिस्कमार्फत बुट गर्नुहोस्</translation>
<translation id="635783852215913562">तल वा माथि जान तीर कुञ्जीहरू प्रयोग गर्नुहोस्।</translation>
<translation id="65237697078188559">फर्मवेयर सेल</translation>
<translation id="6972383785688794804">पेज अप</translation>
<translation id="7065553583078443466">कुनै अर्को बुटलोडर चयन गर्नुहोस्</translation>
<translation id="7126032376876878896">कुनै विकल्प चयन गर्न पावर बटन प्रयोग गर्नुहोस्।</translation>
<translation id="7321387134821904291">भण्डारणको अवस्थासम्बन्धी जानकारी</translation>
<translation id="7332672207700801967">इन्टरनेट रिकभरी (पुरानो संस्करण)</translation>
<translation id="7342794948394983731">डायग्नोस्टिक टुलहरू</translation>
<translation id="7352651011704765696">कुनै त्रुटि भयो</translation>
<translation id="7658239707568436148">रद्द गर्नुहोस्</translation>
<translation id="7939062555109487992">उन्नत विकल्पहरू</translation>
<translation id="8011335065515332253">समयसीमा समाप्त भएपछि यो डिभाइस तल चयन गरिएको कुनै विकल्पमार्फत स्वतः बुट हुने छ।</translation>
<translation id="8116993605321079294">अर्को बुटलोडर सुरु गर्ने क्रममा कुनै समस्या आयो। यससम्बन्धी विवरणका लागि फर्मवेयर लग हेर्नुहोस्।</translation>
<translation id="8131740175452115882">निश्चित गर्नुहोस्</translation>
<translation id="8377165353588213941">तपाईं पृष्ठको अन्त्यमा पुग्नुभएको छ</translation>
<translation id="8569584079758810124">डिबगसम्बन्धी जानकारी प्राप्त गर्न सकिएन।</translation>
<translation id="8720490351198901261">तपाईं पृष्ठको सिरानमा पुग्नुभएको छ</translation>
<translation id="8878311588372127478">आफै भण्डारणको जाँच गर्ने सुविधा (धेरै समय लाग्ने)</translation>
<translation id="8975826224585429326">कुनै अर्को बुटलोडर भेटाउन सकिएन। तपाईं बुटलोडर इन्स्टल गर्ने तरिका सिक्न चाहनुहुन्छ भने यहाँ जानुहोस्:</translation>
<translation id="9004305007436435169">डायग्नोस्टिक जानकारी प्राप्त गर्न सकिएन।</translation>
</translationbundle>