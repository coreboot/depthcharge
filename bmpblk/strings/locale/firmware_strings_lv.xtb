<translation id="1201402288615127009">Tālāk</translation>
<translation id="1327914510899744949">Operētājsistēmu ielādes rīka ātrā palaišana</translation>
<translation id="1428255359211557126">Atmiņas pārbaude (ātra)</translation>
<translation id="1472222389773595668">Iestatiet atkopšanas disku</translation>
<translation id="1483971085438511843">Opcijas atlasīšanai izmantojiet ievadīšanas taustiņu.</translation>
<translation id="1512607074848104909">Pievienojiet ārējo disku, kurā ir OS attēls. Jūsu ierīce tiks automātiski palaista.</translation>
<translation id="1618959600706780970">Kamēr operētājsistēmu ielādes rīks ir atbloķēts, ierīce nav aizsargāta. Lai atjaunotu ierīces drošību, bloķējiet operētājsistēmu ielādes rīku.</translation>
<translation id="1851498512110506461">Procesa laikā tiks notīrīti lietotāja dati.</translation>
<translation id="1880493276474218432">Lai izveidotu atkopšanas disku, jums būs nepieciešams tālāk norādītais.</translation>
<translation id="1995660704900986789">Izslēgt</translation>
<translation id="2022309272630265316">Nav noteikts neviens derīgs attēls</translation>
<translation id="2164852388827548816">Aparātprogrammatūras žurnāls</translation>
<translation id="2242127796967618375">Uzziniet vairāk tīmekļa vietnē</translation>
<translation id="2340902555262319714">2. Turot nospiestu atkopšanas pogu, nospiediet un atlaidiet barošanas pogu ( ⏻) un pēc tam atlaidiet atkopšanas pogu.</translation>
<translation id="2730585974895524161">Operētājsistēmu ielādes rīks ir atbloķēts</translation>
<translation id="2861620505929653443">Vai atbloķēt operētājsistēmu ielādes rīku?</translation>
<translation id="2969699099866537016">Pārbaudiet, vai atkopšanas diskā ir derīgs attēls, un mēģiniet vēlreiz.</translation>
<translation id="3165751548024554961">Jūsu ierīces akumulatora uzlādes līmenis ir zems. Lai turpinātu, pievienojiet barošanas avotu.</translation>
<translation id="3174560100798162637">Ieteicams ierīci pievienot barošanas avotam.</translation>
<translation id="3294574173405124634">Atgriešanās drošajā režīmā nav atļauta saskaņā ar GBB karodziņiem.</translation>
<translation id="330703583939423765">1. Noņemiet visas pievienotās ierīces.</translation>
<translation id="361826164482194215">Alternatīvie operētājsistēmu ielādes rīki ir atspējoti. Uzziniet vairāk tīmekļa vietnē</translation>
<translation id="3697087251845525042">Krātuves pašpārbaude (neilga)</translation>
<translation id="3784455785234192852">Bloķēt</translation>
<translation id="3848046184877245923">Atkopšanas procesa sākšana</translation>
<translation id="385051799172605136">Atpakaļ</translation>
<translation id="3931222419141306012">Novecojis atkopšanas attēls</translation>
<translation id="4002335453596341558">Pāriet vienu lapu uz leju</translation>
<translation id="4228286289437521015">Tādējādi tiks dzēsti visi dati no jūsu ierīces. Ierīces drošība tiks atspējota.</translation>
<translation id="4231467600151418708">2. Turiet nospiestu taustiņu kombināciju Esc+Refresh ( ⟳)+Power ( ⏻).</translation>
<translation id="4410491068110727276">Izmantojiet skaļuma pogas, lai pārietu uz augšu vai uz leju.</translation>
<translation id="46859019225980199">Lai novērstu šo problēmu, sāciet atkopšanas procesu.</translation>
<translation id="4773280894882892048">Atkļūdošanas informācija</translation>
<translation id="4815374450404670311">Atmiņas pārbaude (pilnīga)</translation>
<translation id="4986594717579135906">Atjaunina datoru. Tas var ilgt 1-2 min.
Neizsl. datoru.</translation>
<translation id="4991849386608920411">Nospiediet ierīces atkopšanas pogu, lai atbloķētu operētājsistēmu ielādes rīku, vai atlasiet Atcelt, lai saglabātu aizsardzību.</translation>
<translation id="5018618999152115810">Izmantot USB disku</translation>
<translation id="5184662919967270437">Ierīces atjaunināšana</translation>
<translation id="5232488980254489397">Palaist diagnostiku</translation>
<translation id="5258940999070776327">Atlasiet veicamo testu</translation>
<translation id="5288652088496335604">Lai sāktu, izvēlieties atkopšanas metodi.</translation>
<translation id="5447452894128399840">2. Izpildiet norādījumus otrā ierīcē</translation>
<translation id="5477875595374685515">Nevarēja iegūt aparātprogrammatūras žurnālu.</translation>
<translation id="5511340521509645831">Palaist no ārējā diska</translation>
<translation id="5592705604979238266">Palīdzības centrs:</translation>
<translation id="5704836750240170251">Bloķēt operētājsistēmu ielādes rīku</translation>
<translation id="5733004683773923934">Radās kļūda, veicot palaišanu no iekšējā diska. Detalizētu informāciju skatiet sadaļā Papildu opcijas &gt; Aparātprogrammatūras žurnāls.</translation>
<translation id="5831266751064943765">Operētājsistēmu ielādes rīka atbloķēšanai nevar izmantot ārēju tastatūru. Izmantojiet iebūvēto tastatūru.</translation>
<translation id="5846715299792649254">1. USB disks</translation>
<translation id="589807000231180230">Tiek gaidīta savienojuma izveide...</translation>
<translation id="6073029132385600270">Sagatavojieties ierīces atkopšanai</translation>
<translation id="6172915643608608639">Palaist no iekšējā diska</translation>
<translation id="6209959435052494013">Vai bloķēt operētājsistēmu ielādes rīku?</translation>
<translation id="6259657716425232440">Operētājsistēmu ielādes rīks jau ir atbloķēts.</translation>
<translation id="6326551461084488743">Ierīce:</translation>
<translation id="635783852215913562">Lai pārietu uz augšu vai leju, izmantojiet bultiņas.</translation>
<translation id="6437078769036639380">Pārbaudiet, vai ārējā diskā ir derīgs OS attēls, un atkārtoti ievietojiet to, kad tas ir gatavs.</translation>
<translation id="6453188622241717495">Atbloķēt operētājsistēmu ielādes rīku</translation>
<translation id="65237697078188559">Aparātprogrammatūras čaula</translation>
<translation id="6526005868180962531">Kad atkopšanas disks ir gatavs, pievienojiet to šai ierīcei, lai sāktu atkopšanas procesu.</translation>
<translation id="6870233504224262352">Ierīcei ir jābūt ieslēgtai. Tas var ilgt kādu brīdi.</translation>
<translation id="6933530204467815794">Savienojums izveidots, izmantojot TCP</translation>
<translation id="6972383785688794804">Pāriet vienu lapu uz augšu</translation>
<translation id="7065553583078443466">Atlasīt alternatīvu operētājsistēmu ielādes rīku</translation>
<translation id="7071202423630761214">Savienojums izveidots, izmantojot USB</translation>
<translation id="7126032376876878896">Izmantojiet barošanas pogu, lai atlasītu kādu no opcijām.</translation>
<translation id="714708458581824276">Interneta atkopšanas nodalījums ir bojāts vai tā trūkst. Tā vietā izmantojiet USB disku vai SD karti.</translation>
<translation id="7321387134821904291">Informācija par krātuves stāvokli</translation>
<translation id="7332672207700801967">Interneta atkopšana (vecāka versija)</translation>
<translation id="7342794948394983731">Diagnostikas rīki</translation>
<translation id="7352651011704765696">Radās problēma</translation>
<translation id="7356165460126686730">Izmantot interneta savienojumu</translation>
<translation id="7363327341920650426">Palaišana, izmantojot atbloķētu operētājsistēmu ielādes rīku, ir atspējota. Lai to iespējotu, atsāknējiet ierīci operētājsistēmā un izstrādātāju opcijās iespējojiet OAR atbloķēšanu. Uzziniet vairāk tīmekļa vietnē</translation>
<translation id="7379220436569534523">Tādējādi tiks bloķēts operētājsistēmu ielādes rīks un ierīcē tiks atjaunots sākotnējais stāvoklis.</translation>
<translation id="7658239707568436148">Atcelt</translation>
<translation id="7666722144169757891">Šis atkopšanas attēls ir pārāk vecs jūsu ierīcei. Lejupielādējiet jaunu atkopšanas attēlu un mēģiniet vēlreiz.</translation>
<translation id="7768922467835418715">Netika atrasts neviens ārējais disks</translation>
<translation id="786846615651935749">2. Cita ierīce ar interneta savienojumu</translation>
<translation id="7939062555109487992">Papildopcijas</translation>
<translation id="8003769027543821178">1. USB disks vai SD karte</translation>
<translation id="8011335065515332253">Pēc noildzes ierīce automātiski tiks palaista no tālāk atlasītā diska.</translation>
<translation id="8116993605321079294">Palaižot alternatīvo operētājsistēmu ielādes rīku, radās kļūda. Detalizētu informāciju skatiet aparātprogrammatūras žurnālā.</translation>
<translation id="8131740175452115882">Apstiprināt</translation>
<translation id="8182314305006465525">Jūs izmantojat operētājsistēmu ielādes rīka ātrās palaišanas režīmu</translation>
<translation id="8315682102205416794">Izmantot USB disku vai SD karti</translation>
<translation id="8377165353588213941">Ir sasniegtas beigas</translation>
<translation id="8547898031669202422">Palaišana no ārēja diska ir atspējota. Uzziniet vairāk tīmekļa vietnē</translation>
<translation id="8569584079758810124">Nevarēja iegūt atkļūdošanas informāciju.</translation>
<translation id="8609689706517017461">Interneta atkopšanas nodalījums ir bojāts vai tā trūkst. Tā vietā izmantojiet USB disku.</translation>
<translation id="8720490351198901261">Ir sasniegts sākums</translation>
<translation id="8738563743369620892">Operētājsistēmu ielādes rīka atbloķēšanai nevar izmantot tastatūru. Izmantojiet barošanas pogu ( ⏻).</translation>
<translation id="8856927881878864573">2. Nospiediet un vismaz 10 sekundes turiet skaļuma palielināšanas, skaļuma samazināšanas un barošanas pogu ( ⏻).</translation>
<translation id="8878311588372127478">Krātuves pašpārbaude (detalizēta)</translation>
<translation id="8975826224585429326">Nevarēja atrast alternatīvu operētājsistēmu ielādes rīku. Lai uzzinātu, kā instalēt šādu rīku, apmeklējiet šo vietni:</translation>
<translation id="9004305007436435169">Nevarēja iegūt diagnostikas informāciju.</translation>
<translation id="9037104512788860027">Palaišana, izmantojot atbloķētu operētājsistēmu ielādes rīku, nav atļauta. Uzziniet vairāk tīmekļa vietnē</translation>
