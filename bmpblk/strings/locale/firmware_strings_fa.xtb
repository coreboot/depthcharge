<translation id="1014836725110176376">‫۱. در دستگاه دیگرتان به ‎<ph name="REC_URL" /> بروید</translation>
<translation id="1038621235728757074">گزارش سفت‌افزار دریافت نشد</translation>
<translation id="1183220795526424917">اطلاعات عیب‌یابی دریافت نشد</translation>
<translation id="1201402288615127009">بعدی</translation>
<translation id="1327914510899744949">راه‌اندازی سریع Bootloader</translation>
<translation id="1428255359211557126">بررسی حافظه (سریع)</translation>
<translation id="1472222389773595668">راه‌اندازی درایو بازیابی</translation>
<translation id="1618959600706780970">وقتی قفل bootloader باز باشد، دستگاهتان ایمن نیست. برای بازیابی کردن امنیت دستگاه، bootloader را قفل کنید.</translation>
<translation id="1851498512110506461">داده‌های کاربر در این فرایند محو می‌شود.</translation>
<translation id="1870852367646684013">دستگاهتان را روشن نگه دارید. ممکن است کمی طول بکشد. ممکن است دستگاهتان درطول این فرایند چند بار بازراه‌اندازی شود.</translation>
<translation id="1880493276474218432">برای ایجاد درایو بازیابی، به موارد زیر نیاز دارید:</translation>
<translation id="194344289147253846">صفحه پایین / بالا</translation>
<translation id="1995660704900986789">خاموش کردن</translation>
<translation id="2022309272630265316">هیچ تصویر معتبری شناسایی نشد</translation>
<translation id="2164852388827548816">گزارش سفت‌افزار</translation>
<translation id="2242127796967618375">در اینجا اطلاعات بیشتری دریافت کنید:</translation>
<translation id="2607429849775953201">پرچم‌های GBB اجازه بازگشت به حالت ایمن را نمی‌دهند</translation>
<translation id="2730585974895524161">قفل Bootloader باز است</translation>
<translation id="2861620505929653443">قفل bootloader باز شود؟</translation>
<translation id="3122883569442693641">جزئیات بیشتر</translation>
<translation id="3165751548024554961">باتری دستگاهتان کم است. برای ادامه، به منبع برق متصل شوید.</translation>
<translation id="3174560100798162637">توصیه می‌شود دستگاه را به برق وصل کنید.</translation>
<translation id="3259148708821302840">‫۲. دکمه‌های «افزایش صدا» + «کاهش صدا» + «دکمه روشن/خاموش» ( ⏻ ) را فشار دهید و حداقل ۱۰ ثانیه نگه دارید</translation>
<translation id="361826164482194215">‫bootloader جایگزین غیرفعال است. در اینجا اطلاعات بیشتری دریافت کنید:</translation>
<translation id="3697087251845525042">خودآزمایی فضای ذخیره‌سازی (کوتاه)</translation>
<translation id="3784455785234192852">قفل</translation>
<translation id="3848046184877245923">شروع فرایند بازیابی</translation>
<translation id="385051799172605136">برگشتن</translation>
<translation id="3931222419141306012">روگرفت بازیابی قدیمی</translation>
<translation id="4214546439349483504">مطمئن شوید که درایو بازیابی‌تان تصویر معتبری داشته باشد و دوباره امتحان کنید</translation>
<translation id="4228286289437521015">با این کار همه داده‌های دستگاهتان پاک‌سازی خواهد شد. «امنیت دستگاه» غیرفعال خواهد شد.</translation>
<translation id="4359684972947512288">مطمئن شوید که درایوتان تصویر سیستم‌عامل داشته باشد و دوباره امتحان کنید</translation>
<translation id="4521842502554138285">از کلیدهای جهت‌نما برای پیمایش به بالا یا پایین استفاده کنید</translation>
<translation id="4588000611992606292">روگرفت بازیابی برای دستگاه شما خیلی قدیمی است. روگرفت بازیابی جدیدی بارگیری کنید و دوباره امتحان کنید.</translation>
<translation id="462344180544962573">‫۱. برداشتن همه دستگاه‌های متصل‌شده</translation>
<translation id="46859019225980199">برای برطرف کردن این مشکل، فرایند بازیابی را شروع کنید.</translation>
<translation id="4745966204184880013">‫۲. درحالی‌که دکمه «بازیابی» را نگه داشته‌اید، دکمه «روشن/خاموش» ( ⏻ ) را فشار دهید و رها کنید، سپس دکمه «بازیابی» را رها کنید</translation>
<translation id="4773280894882892048">اطلاعات اشکال‌زدایی</translation>
<translation id="4815374450404670311">بررسی حافظه (کامل)</translation>
<translation id="4986594717579135906">دستگاهتان به زودی به روزرسانی را به اتمام می رساند. این کار ممکن است 1 تا 2 دقیقه طول بکشد.
لطفاً دستگاهتان را خاموش نکنید.</translation>
<translation id="4991849386608920411">برای باز کردن قفل bootloader، دکمه Recovery (بازیابی) را در دستگاهتان فشار دهید یا برای ایمن ماندن، «لغو» را انتخاب کنید.</translation>
<translation id="5018618999152115810">استفاده از درایو USB</translation>
<translation id="5184662919967270437">درحال به‌روزرسانی دستگاه</translation>
<translation id="5232488980254489397">اجرای عیب‌یابی</translation>
<translation id="5258940999070776327">آزمایشی را برای اجرا انتخاب کنید</translation>
<translation id="5419899266869544797">نحوه پیمایش با صفحه‌کلید</translation>
<translation id="5447452894128399840">۲. دستورالعمل‌های روی دستگاه دیگرتان را دنبال کنید</translation>
<translation id="5511340521509645831">راه‌اندازی از درایو خارجی</translation>
<translation id="5561772551945016002">برای انتخاب گزینه، از دکمه روشن/خاموش استفاده کنید</translation>
<translation id="5704836750240170251">قفل کردن bootloader</translation>
<translation id="5733004683773923934">هنگام راه‌اندازی از دیسک داخلی مشکلی پیش آمد. برای جزئیات، به «گزینه‌های پیشرفته &gt; گزارش سفت‌افزار» بروید.</translation>
<translation id="5831266751064943765">نمی‌توانید از صفحه‌کلید خارجی برای باز کردن قفل bootloader استفاده کنید. از صفحه‌کلید داخلی استفاده کنید.</translation>
<translation id="5846715299792649254">۱. درایو USB</translation>
<translation id="589807000231180230">درانتظار برقراری اتصال…</translation>
<translation id="6073029132385600270">برای بازیابی کردن دستگاه آماده شوید</translation>
<translation id="6130923569408873099">نحوه پیمایش</translation>
<translation id="6172915643608608639">راه‌اندازی از دیسک داخلی</translation>
<translation id="6209959435052494013">‫bootloaderقفل شود؟</translation>
<translation id="6326551461084488743">دستگاه:</translation>
<translation id="6453188622241717495">باز کردن قفل bootloader</translation>
<translation id="65237697078188559">پوسته سفت‌افزار</translation>
<translation id="6526005868180962531">وقتی درایو بازیابی آماده شد، آن را به این دستگاه وصل کنید تا فرایند بازیابی شروع شود.</translation>
<translation id="6602196104287361867">برای انتخاب کردن گزینه موردنظر، از کلید Enter استفاده کنید</translation>
<translation id="6882952885087103298">پس از اتمام مهلت، دستگاهتان به‌طور خودکار از انتخاب زیر راه‌اندازی خواهد شد.</translation>
<translation id="6933530204467815794">متصل ازطریق TCP</translation>
<translation id="7065553583078443466">انتخاب bootloader جایگزین</translation>
<translation id="7071202423630761214">ازطریق USB متصل است</translation>
<translation id="714708458581824276">پارتیشن بازیابی اینترنتی خراب شده است یا وجود ندارد. درعوض از درایو USB یا کارت SD استفاده کنید.</translation>
<translation id="7171353208088046858">خارج شدن از این نما</translation>
<translation id="7276802117552141228">قفل راه‌انداز سیستم قبلاً باز شده است</translation>
<translation id="7321387134821904291">اطلاعات سلامتی فضای ذخیره‌سازی</translation>
<translation id="7332672207700801967">بازیابی اینترنتی (نسخه قدیمی)</translation>
<translation id="7342794948394983731">ابزارهای عیب‌یابی</translation>
<translation id="7352651011704765696">مشکلی پیش آمد</translation>
<translation id="7356165460126686730">استفاده از اتصال اینترنت</translation>
<translation id="7363327341920650426">راه‌اندازی با bootloader قفل‌بازشده غیرفعال است. برای فعال کردن آن، به سیستم‌عامل بازراه‌اندازی کنید و «باز کردن قفل سازنده اصلی محصول» را در «گزینه‌های توسعه‌دهندگان» فعال کنید. در اینجا اطلاعات بیشتری دریافت کنید:</translation>
<translation id="7379220436569534523">با این کار bootloader قفل می‌شود و دستگاهتان به حالت اصلی بازیابی می‌شود.</translation>
<translation id="7463831096826310589">برای شروع، روش بازیابی را انتخاب کنید</translation>
<translation id="7600239401768797182">مرکز راهنمایی:</translation>
<translation id="7658239707568436148">لغو</translation>
<translation id="7675343513005159382">اطلاعات اشکال‌زدایی دریافت نشد</translation>
<translation id="7768922467835418715">درایو خارجی شناسایی نشد</translation>
<translation id="786846615651935749">۲. دستگاهی دیگر با اتصال اینترنت</translation>
<translation id="7938294343553280695">از دکمه‌های میزان صدا برای پیمایش به بالا یا پایین</translation>
<translation id="7939062555109487992">گزینه‌های پیشرفته</translation>
<translation id="8003769027543821178">۱. درایو USB یا کارت SD</translation>
<translation id="8116993605321079294">هنگام راه‌اندازی bootloader جایگزین مشکلی پیش آمد. برای اطلاع از جزئیات، گزارش سفت‌افزار را مشاهده کنید.</translation>
<translation id="8131740175452115882">تأیید کردن</translation>
<translation id="8182314305006465525">در حالت راه‌اندازی سریع bootloader هستید</translation>
<translation id="8242491260545149602">‫۲. کلیدهای Esc + «بازآوری» ( ⟳ ) + «روشن/خاموش» ( ⏻ ) را نگه دارید</translation>
<translation id="8315682102205416794">استفاده از درایو USB یا کارت SD</translation>
<translation id="8547898031669202422">راه‌اندازی از درایو خارجی غیرفعال است. در اینجا اطلاعات بیشتری دریافت کنید:</translation>
<translation id="8609689706517017461">پارتیشن بازیابی اینترنتی خراب شده است یا وجود ندارد. به‌جای آن از درایو USB استفاده کنید.</translation>
<translation id="8738563743369620892">نمی‌توانید از صفحه‌کلید برای باز کردن قفل bootloader استفاده کنید. از دکمه «روشن/خاموش» ( ⏻ ) استفاده کنید.</translation>
<translation id="8878311588372127478">خودآزمایی فضای ذخیره‌سازی (گسترده)</translation>
<translation id="8975826224585429326">bootloader جایگزین پیدا نشد. برای آشنایی با نحوه نصب bootloader، به اینجا مراجعه کنید:</translation>
<translation id="9037104512788860027">راه‌اندازی با bootloader قفل‌بازشده مجاز نیست. در اینجا اطلاعات بیشتری دریافت کنید:</translation>
<translation id="9111102763498581341">بازکردن قفل</translation>
<translation id="9187342155216613537">درایو حاوی تصویر سیستم‌عامل را وصل کنید. دستگاهتان به‌طور خودکار راه‌اندازی خواهد شد.</translation>
</translationbundle>