<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="te">
<translation id="1014836725110176376">1. మీ ఇతర డివైజ్‌లో <ph name="REC_URL" />‌కు వెళ్లండి</translation>
<translation id="1201402288615127009">తర్వాత</translation>
<translation id="1327914510899744949">బూట్‌లోడర్ ఫాస్ట్‌బూట్</translation>
<translation id="1428255359211557126">మెమరీ చెక్ (వేగవంతమైనది)</translation>
<translation id="1472222389773595668">మీ రికవరీ డ్రైవ్‌ను సెటప్ చేయండి</translation>
<translation id="1483971085438511843">ఒక ఆప్షన్‌ను ఎంచుకోవడానికి ఎంటర్ కీని ఉపయోగించండి.</translation>
<translation id="1512607074848104909">OS ఇమేజ్‌తో ఎక్స్‌టర్నల్ డ్రైవ్‌ను ప్లగ్ ఇన్ చేయండి. మీ డివైజ్ ఆటోమేటిక్‌గా బూట్ అవుతుంది.</translation>
<translation id="1618959600706780970">బూట్‌లోడర్‌ను అన్‌లాక్ చేసినప్పుడు మీ డివైజ్ సురక్షితంగా ఉండదు. డివైజ్ సెక్యూరిటీని రీస్టోర్ చేయడానికి, బూట్‌లోడర్‌ను లాక్ చేయండి.</translation>
<translation id="1851498512110506461">ప్రాసెస్‌లో యూజర్ డేటాను తొలగించడం జరుగుతుంది.</translation>
<translation id="1880493276474218432">రికవరీ డ్రైవ్‌ను క్రియేట్ చేయడానికి, మీకు ఇవి అవసరం:</translation>
<translation id="1995660704900986789">పవర్ ఆఫ్ చేయి</translation>
<translation id="2022309272630265316">చెల్లుబాటయ్యే ఇమేజ్ గుర్తించబడలేదు</translation>
<translation id="2164852388827548816">ఫర్మ్‌వేర్ లాగ్</translation>
<translation id="2242127796967618375">ఇక్కడ మరింత తెలుసుకోండి:</translation>
<translation id="2340902555262319714">2. రికవరీ బటన్‌ను నొక్కి, పట్టుకుని ఉన్నప్పుడు, పవర్ బటన్‌ను ( ⏻ ) నొక్కి, రిలీజ్ చేసి, ఆపై రికవరీ బటన్‌ను రిలీజ్ చేయండి.</translation>
<translation id="2730585974895524161">బూట్‌లోడర్ అన్‌లాక్ అయింది</translation>
<translation id="2861620505929653443">బూట్‌లోడర్‌ను అన్‌లాక్ చేయాలా?</translation>
<translation id="2969699099866537016">మీ రికవరీ డ్రైవ్‌లో చెల్లుబాటు అయ్యే ఇమేజ్ ఉందని నిర్ధారించుకుని, మళ్లీ ట్రై చేయండి.</translation>
<translation id="3165751548024554961">మీ డివైజ్‌లో బ్యాటరీ తక్కువగా ఉంది. కొనసాగించడానికి పవర్ సోర్స్‌కు కనెక్ట్ చేయండి.</translation>
<translation id="3174560100798162637">మీ డివైజ్‌ను పవర్ సోర్స్‌కు కనెక్ట్ చేయమని సిఫార్సు చేయడమైనది.</translation>
<translation id="3294574173405124634">GBB ఫ్లాగ్‌లు అనుమతించని సురక్షిత మోడ్‌కు తిరిగి వస్తోంది.</translation>
<translation id="330703583939423765">1. కనెక్ట్ అయిన డివైజ్‌లన్నింటినీ తీసివేయండి</translation>
<translation id="361826164482194215">ప్రత్యామ్నాయ బూట్‌లోడర్‌లు డిజేబుల్ అయ్యాయి. ఇక్కడ మరింత తెలుసుకోండి:</translation>
<translation id="3697087251845525042">స్టోరేజ్ స్వీయ పరీక్ష (తగ్గించబడింది)</translation>
<translation id="3784455785234192852">లాక్ చేయండి</translation>
<translation id="3848046184877245923">రికవరీ ప్రాసెస్‌ను ప్రారంభించండి</translation>
<translation id="385051799172605136">వెనుకకు</translation>
<translation id="3931222419141306012">గడువు ముగిసిన రికవరీ ఇమేజ్</translation>
<translation id="4002335453596341558">పేజీ దిగువకు</translation>
<translation id="4228286289437521015">ఇది మీ డివైజ్ నుండి మొత్తం డేటాను ఫ్యాక్టరీ రీసెట్ చేస్తుంది. డివైజ్ర సెక్యూరిటీ డిజేబుల్ అవుతుంది.</translation>
<translation id="4231467600151418708">2. Esc + రిఫ్రెష్ ( ⟳ ) + పవర్ ( ⏻ ) కీలను నొక్కి ఉంచండి.</translation>
<translation id="4410491068110727276">పైకి లేదా కిందికి నావిగేట్ చేయడానికి వాల్యూమ్ బటన్‌లను ఉపయోగించండి.</translation>
<translation id="46859019225980199">ఈ సమస్యను పరిష్కరించడానికి, రికవరీ ప్రాసెస్‌ను ప్రారంభించండి.</translation>
<translation id="4773280894882892048">డీబగ్ సమాచారం</translation>
<translation id="4815374450404670311">మెమరీ చెక్ (మొత్తం)</translation>
<translation id="4986594717579135906">Your device is finishing an update. This may take 1-2 minutes.
Please do not turn off your device.</translation>
<translation id="4991849386608920411">బూట్‌లోడర్‌ను అన్‌లాక్ చేయడానికి మీ డివైజ్‌లో ఉన్న 'రికవరీ' బటన్‌ను నొక్కండి లేదా సురక్షితంగా ఉండటానికి 'రద్దు చేయండి'ని ఎంచుకోండి.</translation>
<translation id="5018618999152115810">USB డ్రైవ్‌ను ఉపయోగించండి</translation>
<translation id="5184662919967270437">మీ డివైజ్‌ను అప్‌డేట్ చేస్తోంది</translation>
<translation id="5232488980254489397">సమస్య విశ్లేషణలు ప్రారంభించండి</translation>
<translation id="5258940999070776327">రన్ చేయడానికి టెస్ట్‌ను ఎంచుకోండి</translation>
<translation id="5288652088496335604">ప్రారంభించడానికి రికవరీ పద్ధతిని ఎంచుకోండి.</translation>
<translation id="5447452894128399840">2. మీ ఇతర డివైజ్‌లో సూచనలను ఫాలో అవ్వండి</translation>
<translation id="5477875595374685515">ఫర్మ్‌వేర్ లాగ్‌ను పొందడం సాధ్యపడలేదు.</translation>
<translation id="5511340521509645831">ఎక్స్‌టర్నల్ డ్రైవ్ నుండి బూట్ చేయండి</translation>
<translation id="5592705604979238266">సహాయ కేంద్రం:</translation>
<translation id="5704836750240170251">బూట్‌లోడర్‌ను లాక్ చేయండి</translation>
<translation id="5733004683773923934">ఇంటర్నల్ డిస్క్ నుండి బూట్ చేయడంలో ఏదో పొరపాటు జరిగింది. వివరాల కోసం, అడ్వాన్స్‌డ్ ఆప్షన్‌లు &gt; ఫర్మ్‌వేర్ లాగ్‌కు వెళ్లండి.</translation>
<translation id="5831266751064943765">బూట్‌లోడర్‌ను అన్‌లాక్ చేయడానికి మీరు ఎక్స్‌టర్నల్ కీబోర్డ్‌ను ఉపయోగించలేరు. బిల్ట్-ఇన్ కీబోర్డ్‌ను ఉపయోగించండి.</translation>
<translation id="5846715299792649254">1. USB డ్రైవ్</translation>
<translation id="589807000231180230">కనెక్షన్ కోసం వేచి ఉంది...</translation>
<translation id="6073029132385600270">మీ డివైజ్‌ను రికవర్ చేయడానికి సిద్ధం అవ్వండి</translation>
<translation id="6172915643608608639">అంతర్గత డిస్క్‌ నుండి బూట్ చేయి</translation>
<translation id="6209959435052494013">బూట్‌లోడర్‌ను లాక్ చేయాలా?</translation>
<translation id="6259657716425232440">బూట్‌లోడర్ ఇప్పటికే అన్‌లాక్ అయింది.</translation>
<translation id="6326551461084488743">డివైజ్:</translation>
<translation id="635783852215913562">పైకి లేదా కిందకు నావిగేట్ చేయడానికి బాణం కీలను ఉపయోగించండి.</translation>
<translation id="6437078769036639380">మీ ఎక్స్‌టర్నల్ డ్రైవ్‌లో చెల్లుబాటయ్యే OS ఇమేజ్ ఉందని నిర్ధారించుకోండి, అది సిద్ధంగా ఉన్నప్పుడు దాన్ని మళ్లీ ఇన్‌సర్ట్ చేయండి.</translation>
<translation id="6453188622241717495">బూట్‌లోడర్‌ను అన్‌లాక్ చేయండి</translation>
<translation id="65237697078188559">ఫర్మ్‌వేర్ షెల్</translation>
<translation id="6526005868180962531">మీ రికవరీ డ్రైవ్ సిద్ధంగా ఉన్నప్పుడు, రికవరీ ప్రాసెస్‌ను ప్రారంభించడానికి దాన్ని ఈ డివైజ్‌కు ప్లగ్ ఇన్ చేయండి.</translation>
<translation id="6870233504224262352">మీ డివైజ్‌ను ఆన్‌లో ఉంచండి. దీనికి కొంత సమయం పట్టవచ్చు.</translation>
<translation id="6933530204467815794">TCP ద్వారా కనెక్ట్ అయింది</translation>
<translation id="6972383785688794804">పేజీ ఎగువకు</translation>
<translation id="7065553583078443466">ప్రత్యామ్నాయ బూట్‌లోడర్‌ను ఎంచుకోండి</translation>
<translation id="7071202423630761214">USB ద్వారా కనెక్ట్ అయింది</translation>
<translation id="7126032376876878896">ఒక ఆప్షన్‌ను ఎంచుకోవడానికి పవర్ బటన్‌ను ఉపయోగించండి.</translation>
<translation id="714708458581824276">ఇంటర్నెట్ రికవరీ పార్టిషన్ కరప్ట్ అయింది లేదా అది లేదు. బదులుగా USB డ్రైవ్‌ను లేదా SD కార్డ్‌ను ఉపయోగించండి.</translation>
<translation id="7321387134821904291">స్టోరేజ్ సంబంధిత ఆరోగ్య సమాచారం</translation>
<translation id="7332672207700801967">ఇంటర్నెట్ రికవరీ (పాత వెర్షన్)</translation>
<translation id="7342794948394983731">సమస్య విశ్లేషణా టూల్స్</translation>
<translation id="7352651011704765696">ఏదో తప్పు జరిగింది</translation>
<translation id="7356165460126686730">ఇంటర్నెట్ కనెక్షన్‌ను ఉపయోగించండి</translation>
<translation id="7363327341920650426">అన్‌లాక్ చేసిన బూట్‌లోడర్‌తో బూట్ చేయడం డిజేబుల్ అయింది. దీన్ని ఎనేబుల్ చేయడానికి, OSకు రీబూట్ చేసి, డెవలపర్ ఆప్షన్‌లలో OEM అన్‌లాకింగ్‌ను ఎనేబుల్ చేయండి. ఇక్కడ మరింత తెలుసుకోండి:</translation>
<translation id="7379220436569534523">ఇది బూట్‌లోడర్‌ను లాక్ చేస్తుంది, మీ డివైజ్‌ను దాని ఒరిజినల్ స్థితికి రీస్టోర్ చేస్తుంది.</translation>
<translation id="7658239707568436148">రద్దు చేయండి</translation>
<translation id="7666722144169757891">ఈ రికవరీ ఇమేజ్ మీ డివైజ్‌కు చాలా పాతది. కొత్త రికవరీ ఇమేజ్‌ను డౌన్‌లోడ్ చేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="7768922467835418715">ఎక్స్‌టర్నల్ డ్రైవ్ ఏదీ గుర్తించబడలేదు</translation>
<translation id="786846615651935749">2. ఇంటర్నెట్ కనెక్షన్ ఉన్న మరొక డివైజ్</translation>
<translation id="7939062555109487992">అడ్వాన్స్‌డ్ ఆప్షన్‌లు</translation>
<translation id="8003769027543821178">1. USB డ్రైవ్ లేదా SD కార్డ్</translation>
<translation id="8011335065515332253">గడువు ముగిసిన తర్వాత, పరికరం ఆటోమేటిక్‌గా దిగువ ఎంపిక నుండి బూట్ అవుతుంది.</translation>
<translation id="8116993605321079294">ప్రత్యామ్నాయ బూట్‌లోడర్‌ను లాంచ్ చేయడంలో ఏదో తప్పు జరిగింది. వివరాల కోసం ఫర్మ్‌వేర్ లాగ్‌ను చూడండి.</translation>
<translation id="8131740175452115882">నిర్ధారించండి</translation>
<translation id="8182314305006465525">మీరు బూట్‌లోడర్ ఫాస్ట్‌బూట్ మోడ్‌లో ఉన్నారు</translation>
<translation id="8315682102205416794">USB డ్రైవ్‌ను లేదా SD కార్డ్‌ను ఉపయోగించండి</translation>
<translation id="8377165353588213941">మీరు చివరి పేజీకి చేరుకున్నారు</translation>
<translation id="8547898031669202422">ఎక్స్‌టర్నల్ డ్రైవ్ నుండి బూటింగ్ డిజేబుల్ అయింది. ఇక్కడ మరింత తెలుసుకోండి:</translation>
<translation id="8569584079758810124">డీబగ్ సమాచారాన్ని పొందడం సాధ్యపడలేదు.</translation>
<translation id="8609689706517017461">ఇంటర్నెట్ రికవరీ పార్టిషన్ కరప్ట్ అయింది లేదా అది లేదు. బదులుగా USB డ్రైవ్‌ను ఉపయోగించండి.</translation>
<translation id="8720490351198901261">మీరు మొదటి పేజీకి చేరుకున్నారు</translation>
<translation id="8738563743369620892">బూట్‌లోడర్‌ను అన్‌లాక్ చేయడానికి మీరు కీబోర్డ్‌ను ఉపయోగించలేరు. పవర్ బటన్‌ను ( ⏻ ) ఉపయోగించండి.</translation>
<translation id="8856927881878864573">2. వాల్యూమ్ పెంపు + వాల్యూమ్ తగ్గింపు + పవర్ బటన్ ( ⏻ )ను కనీసం 10 సెకన్ల పాటు నొక్కి, పట్టుకోండి.</translation>
<translation id="8878311588372127478">స్టోరేజ్ స్వీయ పరీక్ష (పొడిగించబడింది)</translation>
<translation id="8975826224585429326">ప్రత్యామ్నాయ బూట్‌లోడర్‌ను కనుగొనడం సాధ్యపడలేదు. దానిని ఎలా ఇన్‌స్టాల్ చేయాలో తెలుసుకోవడానికి, లింక్‌లో చూడండి:</translation>
<translation id="9004305007436435169">సమస్య విశ్లేషణ సమాచారం పొందడం సాధ్యపడలేదు.</translation>
<translation id="9037104512788860027">అన్‌లాక్ చేసిన బూట్‌లోడర్‌తో బూట్ చేయడం అనుమతించబడదు. ఇక్కడ మరింత తెలుసుకోండి:</translation>
<translation id="9111102763498581341">అన్‌లాక్ చేయండి</translation>
</translationbundle>