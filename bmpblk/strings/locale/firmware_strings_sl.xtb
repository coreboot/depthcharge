<translation id="1014836725110176376">1. V drugi napravi odprite <ph name="REC_URL" /></translation>
<translation id="1201402288615127009">Naprej</translation>
<translation id="1327914510899744949">Hiter zagon zagonskega nalagalnika</translation>
<translation id="1428255359211557126">Preverjanje pomnilnika (hitro)</translation>
<translation id="1472222389773595668">Nastavitev pogona za obnovitev</translation>
<translation id="1483971085438511843">Uporabite tipko Enter za izbiro možnosti.</translation>
<translation id="1512607074848104909">Priključite zunanji pogon s posnetkom operacijskega sistema. Naprava se bo samodejno zagnala.</translation>
<translation id="1618959600706780970">Ko je zagonski nalagalnik odklenjen, naprava ni varna. Če želite obnoviti varnost naprave, zaklenite zagonski nalagalnik.</translation>
<translation id="1851498512110506461">Podatki o uporabniku bodo pri tem izbrisani.</translation>
<translation id="1880493276474218432">Če želite ustvariti pogon za obnovitev, potrebujete:</translation>
<translation id="1995660704900986789">Izklop</translation>
<translation id="2022309272630265316">Nobena veljavna slika ni zaznana</translation>
<translation id="2164852388827548816">Dnevnik vdelane programske opreme</translation>
<translation id="2242127796967618375">Več informacij je na voljo na:</translation>
<translation id="2340902555262319714">2. Medtem ko držite gumb za obnovitev, pritisnite in izpustite gumb za vklop (⏻), nato izpustite gumb za obnovitev.</translation>
<translation id="2730585974895524161">Zagonski nalagalnik je odklenjen</translation>
<translation id="2861620505929653443">Želite odkleniti zagonski nalagalnik?</translation>
<translation id="2969699099866537016">Preverite, ali je v pogonu za obnovitev veljaven posnetek, in poskusite znova.</translation>
<translation id="3165751548024554961">Baterija naprave je skoraj prazna. Če želite nadaljevati, priključite na vir napajanja.</translation>
<translation id="3174560100798162637">Priporočamo, da napravo priklopite na napajanje.</translation>
<translation id="3294574173405124634">Vrnitev v varni način so onemogočile zastavice GBB.</translation>
<translation id="330703583939423765">1. Odstranite vse povezane naprave.</translation>
<translation id="361826164482194215">Drugi zagonski nalagalniki so onemogočeni. Več informacij je na voljo na:</translation>
<translation id="3697087251845525042">Samopreizkus shrambe (kratek)</translation>
<translation id="3784455785234192852">Zakleni</translation>
<translation id="3848046184877245923">Začetek postopka obnovitve</translation>
<translation id="385051799172605136">Nazaj</translation>
<translation id="3931222419141306012">Zastarel posnetek za obnovitev</translation>
<translation id="4002335453596341558">Stran navzdol</translation>
<translation id="4228286289437521015">S tem boste izbrisali vse podatke iz naprave. Varnost naprave bo onemogočena.</translation>
<translation id="4231467600151418708">2. Pridržite tipko Esc + tipko za osvežitev (⟳) + tipko za vklop (⏻).</translation>
<translation id="4410491068110727276">Uporabite gumba za glasnost za pomikanje gor ali dol.</translation>
<translation id="46859019225980199">Če želite odpraviti to težavo, začnite postopek obnovitve.</translation>
<translation id="4773280894882892048">Informacije o iskanju napak</translation>
<translation id="4815374450404670311">Preverjanje pomnilnika (polno)</translation>
<translation id="4986594717579135906">V napravi poteka posodobitev. To lahko traja do 2 minuti.
Ne izklopite naprave.</translation>
<translation id="4991849386608920411">Na napravi pritisnite gumb za obnovitev, če želite odkleniti zagonski nalagalnik, ali izberite Prekliči, če želite obdržati zaščito.</translation>
<translation id="5018618999152115810">Uporabi pogon USB</translation>
<translation id="5184662919967270437">Posodabljanje naprave</translation>
<translation id="5232488980254489397">Zaženi diagnostiko</translation>
<translation id="5258940999070776327">Izberite preizkus, ki ga želite zagnati</translation>
<translation id="5288652088496335604">Izberite način obnovitve, če želite začeti.</translation>
<translation id="5447452894128399840">2. Upoštevajte navodila v drugi napravi</translation>
<translation id="5477875595374685515">Ni bilo mogoče dobiti dnevnika vdelane programske opreme.</translation>
<translation id="5511340521509645831">Zaženi iz zunanjega pogona</translation>
<translation id="5592705604979238266">Center za pomoč:</translation>
<translation id="5704836750240170251">Zakleni zagonski nalagalnik</translation>
<translation id="5733004683773923934">Pri zagonu z notranjega diska je prišlo do napake. Podrobnosti so na voljo v Dodatne možnosti &gt; Dnevnik vdelane programske opreme.</translation>
<translation id="5831266751064943765">Zagonskega nalagalnika ni mogoče odkleniti z zunanjo tipkovnico. Uporabite vgrajeno tipkovnico.</translation>
<translation id="5846715299792649254">1. Pogon USB</translation>
<translation id="589807000231180230">Čakanje na povezavo …</translation>
<translation id="6073029132385600270">Pripravite se na obnovitev naprave</translation>
<translation id="6172915643608608639">Zagon z notranjega diska</translation>
<translation id="6209959435052494013">Želite zakleniti zagonski nalagalnik?</translation>
<translation id="6259657716425232440">Zagonski nalagalnik je že odklenjen.</translation>
<translation id="6326551461084488743">Naprava:</translation>
<translation id="635783852215913562">Uporabite puščične tipke za pomikanje gor ali dol.</translation>
<translation id="6437078769036639380">Poskrbite, da je v zunanjem pogonu veljaven posnetek operacijskega sistema, in ga znova vstavite, ko bo pripravljen.</translation>
<translation id="6453188622241717495">Odkleni zagonski nalagalnik</translation>
<translation id="65237697078188559">Lupina vdelane programske opreme</translation>
<translation id="6526005868180962531">Ko je pogon za obnovitev pripravljen, ga priključite v to napravo in začnite postopek obnovitve.</translation>
<translation id="6870233504224262352">Naprava naj bo vklopljena. To lahko traja nekaj trenutkov.</translation>
<translation id="6933530204467815794">Povezano prek protokola TCP</translation>
<translation id="6972383785688794804">Stran navzgor</translation>
<translation id="7065553583078443466">Izberi drugi zagonski nalagalnik</translation>
<translation id="7071202423630761214">Povezano prek USB-ja</translation>
<translation id="7126032376876878896">Z gumbom za vklop izberite možnost.</translation>
<translation id="714708458581824276">Particija za obnovitev v internetu je poškodovana ali je ni. Namesto tega uporabite pogon USB ali kartico SD.</translation>
<translation id="7321387134821904291">Podatki o zdravju shrambe</translation>
<translation id="7332672207700801967">Obnovitev iz interneta (starejša različica)</translation>
<translation id="7342794948394983731">Orodja za diagnostiko</translation>
<translation id="7352651011704765696">Prišlo je do neznane težave</translation>
<translation id="7356165460126686730">Uporabi internetno povezavo</translation>
<translation id="7363327341920650426">Zagon z odklenjenim zagonskim nalagalnikom je onemogočen. Če ga želite omogočiti, znova zaženite v operacijski sistem in v možnostih za razvijalce omogočite odklepanje OEM. Več informacij je na voljo na:</translation>
<translation id="7379220436569534523">S tem boste zaklenili zagonski nalagalnik in obnovili napravo v prvotno stanje.</translation>
<translation id="7658239707568436148">Prekliči</translation>
<translation id="7666722144169757891">Ta posnetek za obnovitev je prestar za vašo napravo. Prenesite nov posnetek za obnovitev in poskusite znova.</translation>
<translation id="7768922467835418715">Zaznan ni noben zunanji pogon</translation>
<translation id="786846615651935749">2. Druga naprava z internetno povezavo</translation>
<translation id="7939062555109487992">Dodatne možnosti</translation>
<translation id="8003769027543821178">1. Pogon USB ali kartica SD</translation>
<translation id="8011335065515332253">Po preteku časovne omejitve se bo naprava samodejno zagnala s spodaj izbrane možnosti.</translation>
<translation id="8116993605321079294">Pri zagonu drugega zagonskega nalagalnika je prišlo do napake. Če želite podrobnosti, glejte dnevnik vdelane programske opreme.</translation>
<translation id="8131740175452115882">Potrdi</translation>
<translation id="8182314305006465525">Ste v načinu za hiter zagon zagonskega nalagalnika (Fastboot mode)</translation>
<translation id="8315682102205416794">Uporabi pogon USB ali kartico SD</translation>
<translation id="8377165353588213941">Prišli ste do konca</translation>
<translation id="8547898031669202422">Zagon iz zunanjega pogona je onemogočen. Več informacij je na voljo na:</translation>
<translation id="8569584079758810124">Ni bilo mogoče dobiti podatkov o odpravljanju napak.</translation>
<translation id="8609689706517017461">Particija za obnovitev v internetu je poškodovana ali je ni. Namesto tega uporabite pogon USB.</translation>
<translation id="8720490351198901261">Prišli ste na vrh</translation>
<translation id="8738563743369620892">Zagonskega nalagalnika ni mogoče odkleniti s tipkovnico. Uporabite gumb za vklop (⏻).</translation>
<translation id="8856927881878864573">2. Za vsaj 10 sekund pridržite gumbe za povečanje glasnosti, zmanjšanje glasnosti in vklop (⏻).</translation>
<translation id="8878311588372127478">Samopreizkus shrambe (razširjen)</translation>
<translation id="8975826224585429326">Ni bilo mogoče najti drugega zagonskega nalagalnika. Če želite izvedeti, kako ga namestite, odprite:</translation>
<translation id="9004305007436435169">Ni bilo mogoče dobiti diagnostičnih podatkov.</translation>
<translation id="9037104512788860027">Zagon z odklenjenim zagonskim nalagalnikom ni dovoljen. Več informacij je na voljo na:</translation>
<translation id="9111102763498581341">Odkleni</translation>
