<translation id="7939062555109487992">خيارات متقدمة</translation>
<translation id="8003769027543821178">‫1. محرّك أقراص USB أو بطاقة SD</translation>
<translation id="8011335065515332253">بعد انتهاء المهلة، سيتم تشغيل الجهاز تلقائيًا من الاختيار المحدّد أدناه.</translation>
<translation id="8116993605321079294">حدث خطأ أثناء إطلاق برنامج الإقلاع البديل. يُرجى الاطّلاع على سجلّ البرامج الثابتة لمعرفة التفاصيل.</translation>
<translation id="8131740175452115882">التأكيد</translation>
<translation id="8182314305006465525">أنت حاليًا في وضع Fastboot لبرنامج الإقلاع</translation>
<translation id="8315682102205416794">استخدام محرّك أقراص USB أو بطاقة SD</translation>
<translation id="8377165353588213941">لقد وصلت إلى آخر صفحة.</translation>
<translation id="8547898031669202422">تم إيقاف ميزة التشغيل من محرّك أقراص خارجي. مزيد من المعلومات على:</translation>
<translation id="8569584079758810124">تعذَّر العثور على معلومات تصحيح الأخطاء.</translation>
<translation id="8609689706517017461">قسم استرداد نظام التشغيل عبر الإنترنت تالف أو غير متوفّر. يمكنك استخدام محرّك أقراص USB بدلاً من ذلك.</translation>
<translation id="8720490351198901261">لقد وصلت إلى أول صفحة.</translation>
<translation id="8738563743369620892">لا يمكنك فتح قفل برنامج الإقلاع باستخدام لوحة مفاتيح. استخدِم زر التشغيل ( ⏻ ).</translation>
<translation id="8856927881878864573">‫2. اضغط مع الاستمرار على زر رفع الصوت + زر خفض الصوت + زر التشغيل ( ⏻ ) لعشر ثوانٍ على الأقل.</translation>
<translation id="8878311588372127478">اختبار ذاتي موسَّع لوحدة التخزين</translation>
<translation id="8975826224585429326">تعذَّر العثور على برنامج إقلاع بديل. لمعرفة خطوات تثبيت برنامج الإقلاع البديل، يُرجى الانتقال إلى الرابط التالي:</translation>
<translation id="9004305007436435169">تعذَّر الحصول على معلومات التشخيص.</translation>
<translation id="9037104512788860027">غير مسموح بإيقاف ميزة التشغيل باستخدام برنامج إقلاع غير مُقفَل. مزيد من المعلومات على:</translation>
<translation id="9111102763498581341">فتح القفل</translation>
</translationbundle>