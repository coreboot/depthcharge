<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ta">
<translation id="1014836725110176376">1. உங்கள் மற்றொரு சாதனத்தில் <ph name="REC_URL" /> என்பதற்குச் செல்லவும்</translation>
<translation id="1201402288615127009">அடுத்து</translation>
<translation id="1327914510899744949">பூட்லோடர் fastboot</translation>
<translation id="1428255359211557126">நினைவகச் சோதனை (விரைவானது)</translation>
<translation id="1472222389773595668">மீட்பு டிரைவை அமையுங்கள்</translation>
<translation id="1483971085438511843">விருப்பத்தைத் தேர்ந்தெடுக்க, enter விசையைப் பயன்படுத்தவும்.</translation>
<translation id="1512607074848104909">OS இமேஜ் உள்ள வெளிப்புற டிரைவை இணைக்கவும். உங்கள் சாதனம் தானாகவே தொடங்கும்.</translation>
<translation id="1618959600706780970">பூட்லோடர் அன்லாக் செய்யப்பட்டிருக்கும்போது உங்கள் சாதனம் பாதுகாப்பாக இருக்காது. சாதனத்தின் பாதுகாப்பை மீட்டெடுக்க, பூட்லோடரை லாக் செய்யவும்.</translation>
<translation id="1851498512110506461">இந்தச் செயல்முறையின்போது பயனர் தரவு அழிக்கப்படும்.</translation>
<translation id="1880493276474218432">மீட்பு டிரைவை உருவாக்க, இவை தேவை:</translation>
<translation id="1995660704900986789">முடக்கு</translation>
<translation id="2022309272630265316">சரியான இமேஜ் எதுவும் கண்டறியப்படவில்லை</translation>
<translation id="2164852388827548816">நிலைபொருள் பதிவு</translation>
<translation id="2242127796967618375">இதற்குச் சென்று மேலும் தெரிந்துகொள்ளவும்:</translation>
<translation id="2340902555262319714">2. ரெக்கவரி பட்டனை அழுத்திப் பிடித்துக்கொண்டே பவர் பட்டனை ( ⏻ ) அழுத்தி விடுவித்துவிட்டு ரெக்கவரி பட்டனை விடுவிக்கவும்.</translation>
<translation id="2730585974895524161">பூட்லோடர் அன்லாக் செய்யப்பட்டுள்ளது</translation>
<translation id="2861620505929653443">பூட்லோடரை அன்லாக் செய்யவா?</translation>
<translation id="2969699099866537016">உங்கள் மீட்பு டிரைவில் சரியான பிரதி இருப்பதை உறுதிசெய்துகொண்டு மீண்டும் முயலவும்.</translation>
<translation id="3165751548024554961">உங்கள் சாதனத்தின் பேட்டரியில் சார்ஜ் குறைவாக உள்ளது. தொடர, மின் மூலத்துடன் இணைக்கவும்.</translation>
<translation id="3174560100798162637">சாதனத்தை மின் மூலத்துடன் இணைக்குமாறு பரிந்துரைக்கப்படுகிறது.</translation>
<translation id="3294574173405124634">பாதுகாப்புப் பயன்முறைக்குச் செல்வதை GBB கொடிகள் அனுமதிக்கவில்லை.</translation>
<translation id="330703583939423765">1. இணைக்கப்பட்டுள்ள எல்லாச் சாதனங்களையும் அகற்றவும்.</translation>
<translation id="361826164482194215">மாற்று பூட்லோடர்கள் ஆஃப் செய்யப்பட்டுள்ளன. இதற்குச் சென்று மேலும் தெரிந்துகொள்ளவும்:</translation>
<translation id="3697087251845525042">சேமிப்பகச் சுயச் சோதனை (விரைவானது)</translation>
<translation id="3784455785234192852">லாக் செய்</translation>
<translation id="3848046184877245923">மீட்புச் செயல்முறையைத் தொடங்குங்கள்</translation>
<translation id="385051799172605136">திரும்பு</translation>
<translation id="3931222419141306012">பழைய மீட்புப் படம்</translation>
<translation id="4002335453596341558">கீழே செல்</translation>
<translation id="4228286289437521015">உங்கள் சாதனத்தில் உள்ள எல்லாத் தரவும் அழிக்கப்படும். சாதனப் பாதுகாப்பு ஆஃப் செய்யப்படும்.</translation>
<translation id="4231467600151418708">2. Esc + ரெஃப்ரெஷ் ( ⟳ ) + பவர் ( ⏻ ) பட்டன்களை அழுத்திப் பிடிக்கவும்.</translation>
<translation id="4410491068110727276">மேலே அல்லது கீழே செல்ல, ஒலியளவு பட்டன்களைப் பயன்படுத்தவும்.</translation>
<translation id="46859019225980199">இந்தச் சிக்கலைச் சரிசெய்ய, மீட்புச் செயல்முறையைத் தொடங்கவும்.</translation>
<translation id="4773280894882892048">பிழைத்திருத்தத் தகவல்</translation>
<translation id="4815374450404670311">நினைவகச் சோதனை (முழுமையானது)</translation>
<translation id="4986594717579135906">உங்கள் சாதனம் புதுப்பிக்கப்படுகிறது. இதற்குச் சில நிமிடங்கள் ஆகலாம்.
சாதனத்தை ஆஃப் செய்ய வேண்டாம்.</translation>
<translation id="4991849386608920411">பூட்லோடரை அன்லாக் செய்ய சாதனத்தில் உள்ள ரெக்கவரி பட்டனை அழுத்தவும். பாதுகாப்பைத் தக்கவைக்க ‘ரத்துசெய்’ என்பதைத் தேர்ந்தெடுக்கவும்.</translation>
<translation id="5018618999152115810">USB டிரைவைப் பயன்படுத்து</translation>
<translation id="5184662919967270437">சாதனத்தைப் புதுப்பிக்கிறது</translation>
<translation id="5232488980254489397">பிழைக் கண்டறிதலைத் தொடங்கு</translation>
<translation id="5258940999070776327">இயக்க வேண்டிய சோதனையைத் தேர்ந்தெடுக்கவும்</translation>
<translation id="5288652088496335604">தொடங்க, மீட்பு முறையைத் தேர்வுசெய்யவும்.</translation>
<translation id="5447452894128399840">2. சாதனத்தில் காட்டப்படும் வழிமுறைகளைப் பின்பற்றவும்</translation>
<translation id="5477875595374685515">நிலைபொருள் பதிவைப் பெற முடியவில்லை.</translation>
<translation id="5511340521509645831">வெளிப்புற டிரைவில் இருந்து தொடங்கு</translation>
<translation id="5592705604979238266">உதவி மையம்:</translation>
<translation id="5704836750240170251">பூட்லோடரை லாக் செய்</translation>
<translation id="5733004683773923934">சாதனத்தின் டிஸ்க்கில் இருந்து தொடங்கும்போது ஏதோ தவறாகிவிட்டது. விவரங்களுக்கு, மேம்பட்ட விருப்பங்கள் &gt; ஃபர்ம்வேர் பதிவு என்பதற்குச் செல்லவும்.</translation>
<translation id="5831266751064943765">பூட்லோடரை அன்லாக் செய்ய வெளிப்புறக் கீபோர்டைப் பயன்படுத்த முடியாது. உள்ளமைந்த கீபோர்டைப் பயன்படுத்தவும்.</translation>
<translation id="5846715299792649254">1. USB டிரைவ்</translation>
<translation id="589807000231180230">இணைப்பிற்காகக் காத்திருக்கிறது...</translation>
<translation id="6073029132385600270">உங்கள் சாதனத்தை மீட்டெடுக்கத் தயாராகுங்கள்</translation>
<translation id="6172915643608608639">சாதன டிஸ்க்கிலிருந்து தொடங்கு</translation>
<translation id="6209959435052494013">பூட்லோடரை லாக் செய்யவா?</translation>
<translation id="6259657716425232440">பூட்லோடர் ஏற்கெனவே அன்லாக் செய்யப்பட்டுள்ளது.</translation>
<translation id="6326551461084488743">சாதனம்:</translation>
<translation id="635783852215913562">மேலே அல்லது கீழே செல்ல, அம்புக்குறி விசைகளைப் பயன்படுத்தவும்.</translation>
<translation id="6437078769036639380">உங்கள் வெளிப்புற டிரைவில் சரியான OS இமேஜ் இருப்பதை உறுதிசெய்துகொள்ளவும், தயாரானதும் அதை மீண்டும் இணைக்கவும்.</translation>
<translation id="6453188622241717495">பூட்லோடரை அன்லாக் செய்</translation>
<translation id="65237697078188559">நிலைபொருள் ஷெல்</translation>
<translation id="6526005868180962531">உங்கள் மீட்பு டிரைவ் தயாரானதும், மீட்புச் செயல்முறையைத் தொடங்க இந்தச் சாதனத்தில் அதை இணைக்கவும்.</translation>
<translation id="6870233504224262352">உங்கள் சாதனத்தை ஆன் செய்தே வைத்திருக்கவும். இதற்குச் சிறிது நேரம் ஆகலாம்.</translation>
<translation id="6933530204467815794">TCP மூலம் இணைக்கப்பட்டுள்ளது</translation>
<translation id="6972383785688794804">மேலே செல்</translation>
<translation id="7065553583078443466">மாற்று பூட்லோடரைத் தேர்ந்தெடு</translation>
<translation id="7071202423630761214">USB மூலம் இணைக்கப்பட்டுள்ளது</translation>
<translation id="7126032376876878896">விருப்பத்தைத் தேர்ந்தெடுக்க, பவர் பட்டனைப் பயன்படுத்தவும்.</translation>
<translation id="714708458581824276">இணையத்தின் மூலம் மீட்டெடுப்பதற்கான பார்ட்டிஷன் இல்லை அல்லது சிதைந்துள்ளது. அதற்குப் பதிலாக USB டிரைவையோ SD கார்டையோ பயன்படுத்தவும்.</translation>
<translation id="7321387134821904291">சேமிப்பகத்தின் நிலை குறித்த தகவல்</translation>
<translation id="7332672207700801967">இணையத்தின் மூலம் மீட்டெடுத்தல் (பழைய பதிப்பு)</translation>
<translation id="7342794948394983731">சரிபார்ப்புக் கருவிகள்</translation>
<translation id="7352651011704765696">ஏதோ தவறு ஏற்பட்டது</translation>
<translation id="7356165460126686730">இணைய இணைப்பைப் பயன்படுத்து</translation>
<translation id="7363327341920650426">அன்லாக் செய்யப்பட்ட பூட்லோடருடன் தொடங்குவது ஆஃப் செய்யப்பட்டுள்ளது. அதை ஆன் செய்ய, சாதனத்தை மறுபடி தொடங்கி OS லோடான பிறகு டெவெலப்பர் விருப்பங்களில் OEM அன்லாக்கை ஆன் செய்யவும். இதற்குச் சென்று மேலும் தெரிந்துகொள்ளவும்:</translation>
<translation id="7379220436569534523">பூட்லோடர் லாக் செய்யப்படும், உங்கள் சாதனம் அதன் அசல் நிலைக்கு மீட்டெடுக்கப்படும்.</translation>
<translation id="7658239707568436148">ரத்து செய்</translation>
<translation id="7666722144169757891">இந்த மீட்புப் படம் சாதனத்தில் பயன்படுத்த முடியாத அளவு மிகவும் பழையது. புதிய மீட்புப் படத்தைப் பதிவிறக்கி மீண்டும் முயலவும்.</translation>
<translation id="7768922467835418715">வெளிப்புற டிரைவ் எதுவும் கண்டறியப்படவில்லை</translation>
<translation id="786846615651935749">2. இணைய இணைப்பு உள்ள மற்றொரு சாதனம்</translation>
<translation id="7939062555109487992">மேம்பட்ட விருப்பங்கள்</translation>
<translation id="8003769027543821178">1. USB டிரைவ் அல்லது SD கார்டு</translation>
<translation id="8011335065515332253">நேரம் முடிந்த பிறகு கீழே நீங்கள் தேர்ந்தெடுப்பதிலிருந்து சாதனம் தானாகத் தொடங்கும்.</translation>
<translation id="8116993605321079294">மாற்று பூட்லோடரைத் தொடங்குவதில் ஏதோ தவறாகிவிட்டது. விவரங்களை அறிய நிலைபொருள் பதிவைப் பார்க்கவும்.</translation>
<translation id="8131740175452115882">உறுதிப்படுத்து</translation>
<translation id="8182314305006465525">பூட்லோடர் fastboot modeல் உள்ளீர்கள்</translation>
<translation id="8315682102205416794">USB டிரைவ்/SD கார்டு பயன்படுத்து</translation>
<translation id="8377165353588213941">கடைசிப் பக்கத்தில் உள்ளீர்கள்</translation>
<translation id="8547898031669202422">வெளிப்புற டிரைவில் இருந்து தொடங்குவது ஆஃப் செய்யப்பட்டுள்ளது. இதற்குச் சென்று மேலும் தெரிந்துகொள்ளவும்:</translation>
<translation id="8569584079758810124">பிழைதிருத்தத் தகவலைப் பெற முடியவில்லை.</translation>
<translation id="8609689706517017461">இணையத்தின் மூலம் மீட்டெடுப்பதற்கான பார்ட்டிஷன் இல்லை அல்லது சிதைந்துள்ளது. அதற்குப் பதிலாக USB டிரைவைப் பயன்படுத்தவும்.</translation>
<translation id="8720490351198901261">முதல் பக்கத்தில் உள்ளீர்கள்</translation>
<translation id="8738563743369620892">பூட்லோடரை அன்லாக் செய்ய கீபோர்டைப் பயன்படுத்த முடியாது. பவர் பட்டனை ( ⏻ ) பயன்படுத்தவும்.</translation>
<translation id="8856927881878864573">2. ஒலியளவை அதிகரிக்கும் பட்டன் + ஒலியளவைக் குறைக்கும் பட்டன் + பவர் பட்டன் ( ⏻ ) ஆகியவற்றைக் குறைந்தபட்சம் 10 வினாடிகளுக்கு அழுத்திப் பிடிக்கவும்.</translation>
<translation id="8878311588372127478">சேமிப்பகச் சுயச் சோதனை (நீட்டிக்கப்பட்டது)</translation>
<translation id="8975826224585429326">மாற்று பூட்லோடரைக் கண்டறிய முடியவில்லை. அதை எப்படி நிறுவுவது என அறிய இதைப் பார்க்கவும்:</translation>
<translation id="9004305007436435169">கண்டறிதல் தகவல்களைப் பெற முடியவில்லை.</translation>
<translation id="9037104512788860027">அன்லாக் செய்யப்பட்ட பூட்லோடருடன் தொடங்குவதற்கு அனுமதியில்லை. இதற்குச் சென்று மேலும் தெரிந்துகொள்ளவும்:</translation>
<translation id="9111102763498581341">அன்லாக் செய்</translation>
</translationbundle>