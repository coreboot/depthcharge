<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ml">
<translation id="1014836725110176376">1. നിങ്ങളുടെ മറ്റൊരു ഉപകരണത്തിൽ <ph name="REC_URL" /> എന്നതിലേക്ക് പോകുക</translation>
<translation id="1201402288615127009">അടുത്തത്</translation>
<translation id="1327914510899744949">ബൂട്ട് ലോഡർ ഫാസ്റ്റ്ബൂട്ട്</translation>
<translation id="1428255359211557126">മെമ്മറി പരിശോധന (വേഗത്തിൽ)</translation>
<translation id="1472222389773595668">നിങ്ങളുടെ വീണ്ടെടുക്കൽ ഡ്രൈവ് സജ്ജീകരിക്കുക</translation>
<translation id="1483971085438511843">ഒരു ഓപ്ഷൻ തിരഞ്ഞെടുക്കാൻ Enter കീ ഉപയോഗിക്കുക.</translation>
<translation id="1512607074848104909">OS ഇമേജ് ഉള്ള ഒരു എക്‌സ്റ്റേണൽ ഡ്രൈവ് പ്ലഗ് ഇൻ ചെയ്യുക. നിങ്ങളുടെ ഉപകരണം സ്വയമേവ ബൂട്ട് ചെയ്യും.</translation>
<translation id="1618959600706780970">ബൂട്ട് ലോഡർ അൺലോക്ക് ചെയ്തിരിക്കുമ്പോൾ നിങ്ങളുടെ ഉപകരണം സുരക്ഷിതമല്ല. ഉപകരണ സുരക്ഷ പുനഃസ്ഥാപിക്കാൻ, ബൂട്ട് ലോഡർ ലോക്ക് ചെയ്യുക.</translation>
<translation id="1851498512110506461">പ്രോസസിനിടയിൽ ഉപയോക്തൃ ഡാറ്റ മായ്ക്കും.</translation>
<translation id="1880493276474218432">വീണ്ടെടുക്കൽ ഡ്രൈവ് സൃഷ്ടിക്കാൻ, നിങ്ങൾക്ക് ഇനിപ്പറയുന്നവ ആവശ്യമാണ്:</translation>
<translation id="1995660704900986789">പവർ ഓഫാക്കുക</translation>
<translation id="2022309272630265316">സാധുവായ ചിത്രം കണ്ടെത്തിയില്ല</translation>
<translation id="2164852388827548816">ഫേംവെയർ ലോഗ്</translation>
<translation id="2242127796967618375">ഇനിപ്പറയുന്നതിൽ കൂടുതലറിയുക:</translation>
<translation id="2340902555262319714">2. വീണ്ടെടുക്കൽ ബട്ടൺ അമർത്തിപ്പിടിച്ചിരിക്കുമ്പോൾ, പവർ ബട്ടൺ ( ⏻ ) അമർത്തിപ്പിടിച്ച് വിട്ട ശേഷം വീണ്ടെടുക്കൽ ബട്ടൺ വിടുക.</translation>
<translation id="2730585974895524161">ബൂട്ട് ലോഡർ അൺലോക്ക് ചെയ്തിരിക്കുന്നു</translation>
<translation id="2861620505929653443">ബൂട്ട് ലോഡർ അൺലോക്ക് ചെയ്യണോ?</translation>
<translation id="2969699099866537016">നിങ്ങളുടെ വീണ്ടെടുക്കൽ ഡ്രൈവിൽ സാധുതയുള്ള ഒരു ചിത്രം ഉണ്ടെന്ന് ഉറപ്പാക്കി വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="3165751548024554961">നിങ്ങളുടെ ഉപകരണത്തിന്റെ ബാറ്ററി ചാർജ് കുറവാണ്. തുടരാൻ, ഒരു വൈദ്യുതി സ്രോതസ്സിലേക്ക് കണക്റ്റ് ചെയ്യുക.</translation>
<translation id="3174560100798162637">നിങ്ങളുടെ ഉപകരണം വൈദ്യുത ഉറവിടത്തിലേക്ക് കണക്റ്റ് ചെയ്യുന്നത് ശുപാർശ ചെയ്യുന്നു.</translation>
<translation id="3294574173405124634">സുരക്ഷിത മോഡിലേക്ക് മടങ്ങുന്നത് GBB ഫ്ലാഗുകൾ അനുവദിച്ചില്ല.</translation>
<translation id="330703583939423765">1. കണക്റ്റ് ചെയ്ത എല്ലാ ഉപകരണങ്ങളും നീക്കം ചെയ്യുക.</translation>
<translation id="361826164482194215">ഇതര ബൂട്ട് ലോഡറുകൾ പ്രവർത്തനരഹിതമാക്കി. ഇനിപ്പറയുന്നതിൽ കൂടുതലറിയുക:</translation>
<translation id="3697087251845525042">സ്‌റ്റോറേജ് സ്വയപരിശോധന (ഹ്രസ്വം)</translation>
<translation id="3784455785234192852">ലോക്ക് ചെയ്യുക</translation>
<translation id="3848046184877245923">വീണ്ടെടുക്കൽ പ്രോസസ് ആരംഭിക്കുക</translation>
<translation id="385051799172605136">പിന്നോട്ട്</translation>
<translation id="3931222419141306012">കാലഹരണപ്പെട്ട വീണ്ടെടുക്കൽ ചിത്രം</translation>
<translation id="4002335453596341558">പേജ് താഴോട്ട്</translation>
<translation id="4228286289437521015">ഇത് നിങ്ങളുടെ ഉപകരണത്തിൽ നിന്നുള്ള എല്ലാ ഡാറ്റയും മായ്ക്കും. ഉപകരണ സുരക്ഷ പ്രവർത്തനരഹിതമാക്കും.</translation>
<translation id="4231467600151418708">2. Esc + Refresh ( ⟳ ) + Power ( ⏻ ) അമർത്തിപ്പിടിക്കുക.</translation>
<translation id="4410491068110727276">മുകളിലോട്ടോ താഴോട്ടോ നാവിഗേറ്റ് ചെയ്യാൻ ശബ്‌ദ ബട്ടണുകൾ ഉപയോഗിക്കുക.</translation>
<translation id="46859019225980199">ഈ പ്രശ്നം പരിഹരിക്കാൻ, വീണ്ടെടുക്കൽ പ്രോസസ് ആരംഭിക്കുക.</translation>
<translation id="4773280894882892048">ഡീബഗ് വിവരങ്ങൾ</translation>
<translation id="4815374450404670311">മെമ്മറി പരിശോധന (പൂർണ്ണം)</translation>
<translation id="4986594717579135906">Your device is finishing an update. This may take 1-2 minutes.
Please do not turn off your device.</translation>
<translation id="4991849386608920411">ബൂട്ട് ലോഡർ അൺലോക്ക് ചെയ്യാൻ നിങ്ങളുടെ ഉപകരണത്തിലെ വീണ്ടെടുക്കൽ ബട്ടൺ അമർത്തുക, അല്ലെങ്കിൽ പരിരക്ഷ തുടരാൻ 'റദ്ദാക്കുക' തിരഞ്ഞെടുക്കുക.</translation>
<translation id="5018618999152115810">USB ഡ്രൈവ് ഉപയോഗിക്കുക</translation>
<translation id="5184662919967270437">നിങ്ങളുടെ ഉപകരണം അപ്‌ഡേറ്റ് ചെയ്യുന്നു</translation>
<translation id="5232488980254489397">പ്രശ്‌നനിർണ്ണയം ലോഞ്ച് ചെയ്യുക</translation>
<translation id="5258940999070776327">റൺ ചെയ്യാൻ ഒരു ടെസ്റ്റ് തിരഞ്ഞെടുക്കുക</translation>
<translation id="5288652088496335604">ആരംഭിക്കാൻ ഒരു വീണ്ടെടുക്കൽ രീതി തിരഞ്ഞെടുക്കുക.</translation>
<translation id="5447452894128399840">2. നിങ്ങളുടെ മറ്റേ ഉപകരണത്തിലെ നിർദ്ദേശങ്ങൾ പാലിക്കുക</translation>
<translation id="5477875595374685515">ഫേംവെയർ ലോഗ് നേടാനായില്ല.</translation>
<translation id="5511340521509645831">എക്‌സ്‌റ്റേണൽ ഡ്രൈവിൽ നിന്ന് ബൂട്ട് ചെയ്യുക</translation>
<translation id="5592705604979238266">സഹായകേന്ദ്രം:</translation>
<translation id="5704836750240170251">ബൂട്ട് ലോഡർ ലോക്ക് ചെയ്യുക</translation>
<translation id="5733004683773923934">ഇന്റേണൽ ഡിസ്‌കിൽ നിന്ന് ബൂട്ട് ചെയ്യുന്നതിൽ എന്തോ പിശകുണ്ടായി. വിശദാംശങ്ങൾക്ക്, വിപുലമായ ഓപ്ഷനുകൾ &gt; ഫേംവെയർ ലോഗ് എന്നതിലേക്ക് പോകുക.</translation>
<translation id="5831266751064943765">ബൂട്ട് ലോഡർ അൺലോക്ക് ചെയ്യാൻ നിങ്ങൾക്ക് ഒരു എക്‌സ്റ്റേണൽ കീബോർഡ് ഉപയോഗിക്കാനാകില്ല. ബിൽറ്റ് ഇൻ കീബോർഡ് ഉപയോഗിക്കുക.</translation>
<translation id="5846715299792649254">1. USB ഡ്രൈവ്</translation>
<translation id="589807000231180230">കണക്ഷനായി കാത്തിരിക്കുന്നു...</translation>
<translation id="6073029132385600270">നിങ്ങളുടെ ഉപകരണം വീണ്ടെടുക്കാൻ തയ്യാറാകുക</translation>
<translation id="6172915643608608639">ആന്തരിക ഡിസ്‌ക്കിൽ നിന്ന് ബൂട്ട് ചെയ്യുക</translation>
<translation id="6209959435052494013">ബൂട്ട് ലോഡർ ലോക്ക് ചെയ്യണോ?</translation>
<translation id="6259657716425232440">ബൂട്ട് ലോഡർ ഇതിനകം അൺലോക്ക് ചെയ്ത നിലയിലാണ്.</translation>
<translation id="6326551461084488743">ഉപകരണം:</translation>
<translation id="635783852215913562">മുകളിലോട്ടോ താഴോട്ടോ നാവിഗേറ്റ് ചെയ്യാൻ അമ്പടയാള കീകൾ ഉപയോഗിക്കുക.</translation>
<translation id="6437078769036639380">നിങ്ങളുടെ എക‌സ്റ്റേണൽ ഡ്രൈവിൽ സാധുതയുള്ള OS ഇമേജ് ഉണ്ടെന്ന് ഉറപ്പാക്കുക, തയ്യാറാകുമ്പോൾ അത് വീണ്ടും ചേർക്കുക.</translation>
<translation id="6453188622241717495">ബൂട്ട് ലോഡർ അൺലോക്ക് ചെയ്യുക</translation>
<translation id="65237697078188559">ഫേംവെയർ ഷെൽ</translation>
<translation id="6526005868180962531">നിങ്ങളുടെ വീണ്ടെടുക്കൽ ഡ്രൈവ് തയ്യാറാകുമ്പോൾ, വീണ്ടെടുക്കൽ പ്രോസസ് ആരംഭിക്കാൻ അത് ഈ ഉപകരണത്തിലേക്ക് പ്ലഗ് ഇൻ ചെയ്യുക.</translation>
<translation id="6870233504224262352">നിങ്ങളുടെ ഉപകരണം ഓണാക്കി നിലനിർത്തുക. ഇതിന് അൽപ്പസമയമെടുത്തേക്കാം.</translation>
<translation id="6933530204467815794">TCP വഴി കണക്റ്റ് ചെയ്തു</translation>
<translation id="6972383785688794804">പേജ് മുകളിലോട്ട്</translation>
<translation id="7065553583078443466">മറ്റൊരു ബൂട്ട് ലോഡർ തിരഞ്ഞെടുക്കുക</translation>
<translation id="7071202423630761214">USB വഴി കണക്റ്റ് ചെയ്തു</translation>
<translation id="7126032376876878896">ഓപ്ഷൻ തിരഞ്ഞെടുക്കാൻ പവർ ബട്ടൺ ഉപയോഗിക്കുക.</translation>
<translation id="714708458581824276">ഇന്റർനെറ്റ് വീണ്ടെടുക്കൽ പാർട്ടീഷൻ കേടായി അല്ലെങ്കിൽ വിട്ടുപോയിരിക്കുന്നു. പകരം ഒരു USB ഡ്രൈവോ SD കാർഡോ ഉപയോഗിക്കുക.</translation>
<translation id="7321387134821904291">സ്‌റ്റോറേജ് ഹെൽത്ത് വിവരങ്ങൾ</translation>
<translation id="7332672207700801967">ഇന്റർനെറ്റ് വീണ്ടെടുക്കൽ (പഴയ പതിപ്പ്)</translation>
<translation id="7342794948394983731">പ്രശ്‌നനിർണ്ണയ ടൂളുകൾ</translation>
<translation id="7352651011704765696">എന്തോ കുഴപ്പം സംഭവിച്ചു</translation>
<translation id="7356165460126686730">ഇന്റർനെറ്റ് കണക്ഷൻ ഉപയോഗിക്കുക</translation>
<translation id="7363327341920650426">അൺലോക്ക് ചെയ്ത ബൂട്ട് ലോഡർ ഉപയോഗിച്ചുള്ള ബൂട്ടിംഗ് പ്രവർത്തനരഹിതമാക്കി. അത് പ്രവർത്തനക്ഷമമാക്കാൻ, OS-ലേക്ക് റീബൂട്ട് ചെയ്ത് ഡെവലപ്പർ ഓപ്ഷനുകളിൽ OEM അൺലോക്ക് ചെയ്യൽ പ്രവർത്തനക്ഷമമാക്കുക. ഇനിപ്പറയുന്നതിൽ കൂടുതലറിയുക:</translation>
<translation id="7379220436569534523">ഇത് ബൂട്ട് ലോഡർ ലോക്ക് ചെയ്യുകയും നിങ്ങളുടെ ഉപകരണത്തെ അതിന്റെ ഒറിജിനൽ നിലയിലേക്ക് പുനഃസ്ഥാപിക്കുകയും ചെയ്യും.</translation>
<translation id="7658239707568436148">റദ്ദാക്കൂ</translation>
<translation id="7666722144169757891">ഈ വീണ്ടെടുക്കൽ ചിത്രം നിങ്ങളുടെ ഉപകരണത്തിന് അനുയോജ്യമല്ലാത്തവിധം പഴയതാണ്. പുതിയൊരു വീണ്ടെടുക്കൽ ചിത്രം ഡൗൺലോഡ് ചെയ്ത് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="7768922467835418715">എക്‌സ്‌റ്റേണൽ ഡ്രൈവുകളൊന്നും കണ്ടെത്തിയില്ല</translation>
<translation id="786846615651935749">2. ഇന്റർനെറ്റ് കണക്ഷനുള്ള മറ്റൊരു ഉപകരണം</translation>
<translation id="7939062555109487992">വിപുലമായ ഓപ്ഷനുകൾ</translation>
<translation id="8003769027543821178">1. USB ഡ്രൈവ് അല്ലെങ്കിൽ SD കാർഡ്</translation>
<translation id="8011335065515332253">ടൈംഔട്ടിന് ശേഷം, ചുവടെയുള്ള ഓപ്ഷനുകളിൽ നിന്ന് ഉപകരണം സ്വയമേവ ബൂട്ട് ചെയ്യും.</translation>
<translation id="8116993605321079294">ഇതര ബൂട്ട് ലോഡർ ലോഞ്ച് ചെയ്യുമ്പോൾ എന്തോ കുഴപ്പമുണ്ടായി. വിശദാംശങ്ങൾക്ക് ഫേംവെയർ ലോഗ് കാണുക.</translation>
<translation id="8131740175452115882">സ്ഥിരീകരിക്കുക</translation>
<translation id="8182314305006465525">നിങ്ങൾ ബൂട്ട് ലോഡർ ഫാസ്റ്റ്ബൂട്ട് മോഡിലാണ്</translation>
<translation id="8315682102205416794">USB ഡ്രൈവ് അല്ലെങ്കിൽ SD കാർഡ് ഉപയോഗിക്കുക</translation>
<translation id="8377165353588213941">നിങ്ങൾ അവസാന പേജിലെത്തി</translation>
<translation id="8547898031669202422">എക്സ്റ്റേണൽ ഡ്രൈവിൽ നിന്ന് ബൂട്ട് ചെയ്യുന്നത് പ്രവർത്തനരഹിതമാക്കി. ഇനിപ്പറയുന്നതിൽ കൂടുതലറിയുക:</translation>
<translation id="8569584079758810124">ഡീബഗ് വിവരങ്ങൾ നേടാനായില്ല.</translation>
<translation id="8609689706517017461">ഇന്റർനെറ്റ് വീണ്ടെടുക്കൽ പാർട്ടീഷൻ കേടായി അല്ലെങ്കിൽ വിട്ടുപോയിരിക്കുന്നു. പകരം ഒരു USB ഡ്രൈവ് ഉപയോഗിക്കുക.</translation>
<translation id="8720490351198901261">നിങ്ങൾ പേജിന്റെ ഏറ്റവും മുകളിലെത്തി</translation>
<translation id="8738563743369620892">ബൂട്ട് ലോഡർ അൺലോക്ക് ചെയ്യാൻ നിങ്ങൾക്ക് കീബോർഡ് ഉപയോഗിക്കാനാകില്ല. പവർ ബട്ടൺ ( ⏻ ) ഉപയോഗിക്കുക.</translation>
<translation id="8856927881878864573">2. ശബ്‌ദം കൂട്ടുക + ശബ്‌ദം കുറയ്ക്കുക + പവർ ബട്ടൺ ( ⏻ ) കുറഞ്ഞത് 10 സെക്കൻഡ് അമർത്തിപ്പിടിക്കുക.</translation>
<translation id="8878311588372127478">സ്‌റ്റോറേജ് സ്വയപരിശോധന (വിപുലീകരിച്ചത്)</translation>
<translation id="8975826224585429326">ഇതര ബൂട്ട് ലോഡർ കണ്ടെത്താനായില്ല. ഇൻസ്റ്റാൾ ചെയ്യേണ്ടത് എങ്ങനെയെന്ന് മനസ്സിലാക്കാൻ ഇവിടെ സന്ദർശിക്കുക:</translation>
<translation id="9004305007436435169">പ്രശ്നനിർണ്ണയ വിവരങ്ങൾ നേടാനായില്ല.</translation>
<translation id="9037104512788860027">അൺലോക്ക് ചെയ്ത ബൂട്ട് ലോഡർ ഉപയോഗിച്ചുള്ള ബൂട്ടിംഗ് അനുവദനീയമല്ല. ഇനിപ്പറയുന്നതിൽ കൂടുതലറിയുക:</translation>
<translation id="9111102763498581341">അൺലോക്ക് ചെയ്യുക</translation>
</translationbundle>