<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="1014836725110176376">1. נכנסים לכתובת <ph name="REC_URL" /> במכשיר השני</translation>
<translation id="1201402288615127009">הבא</translation>
<translation id="1327914510899744949">תוכנת אתחול מהיר (fastboot)</translation>
<translation id="1428255359211557126">בדיקת זיכרון (מהירה)</translation>
<translation id="1472222389773595668">הגדרת הכונן לשחזור</translation>
<translation id="1483971085438511843">יש להקיש על Enter כדי לבחור.</translation>
<translation id="1512607074848104909">צריך לחבר כונן חיצוני עם קובץ אימג' של מערכת ההפעלה. המכשיר יופעל אוטומטית.</translation>
<translation id="1618959600706780970">כשתוכנת האתחול פתוחה, המכשיר לא מאובטח. כדי שהמכשיר יחזור להיות מאובטח, צריך לנעול את תוכנת האתחול.</translation>
<translation id="1851498512110506461">נתוני המשתמש יימחקו בתהליך הזה.</translation>
<translation id="1880493276474218432">כדי ליצור כונן שחזור, צריך:</translation>
<translation id="1995660704900986789">כיבוי</translation>
<translation id="2022309272630265316">לא זוהתה תמונה חוקית</translation>
<translation id="2164852388827548816">יומן הקושחה</translation>
<translation id="2242127796967618375">למידע נוסף:</translation>
<translation id="2340902555262319714">2. בזמן לחיצה ארוכה על כפתור השחזור, צריך ללחוץ פעם אחת על כפתור ההפעלה ( ⏻ ) ואז לשחרר את כפתור השחזור.</translation>
<translation id="2730585974895524161">תוכנת האתחול פתוחה</translation>
<translation id="2861620505929653443">לפתוח את תוכנת האתחול?</translation>
<translation id="2969699099866537016">צריך לוודא שבכונן השחזור יש קובץ אימג' תקין ולנסות שוב.</translation>
<translation id="3165751548024554961">הסוללה של המכשיר חלשה. כדי להמשיך צריך להתחבר אותו למטען.</translation>
<translation id="3174560100798162637">מומלץ לחבר את המכשיר למקור חשמל.</translation>
<translation id="3294574173405124634">התכונות הניסיוניות של GBB לא מתירות לחזור למצב מאובטח.</translation>
<translation id="330703583939423765">‏1. צריך להסיר את כל המכשירים המחוברים.</translation>
<translation id="361826164482194215">האפשרות להשתמש בתוכנות אתחול חלופיות מושבתת. למידע נוסף:</translation>
<translation id="3697087251845525042">בדיקה עצמית של האחסון (קצרה)</translation>
<translation id="3784455785234192852">נעילה</translation>
<translation id="3848046184877245923">התחלת תהליך השחזור</translation>
<translation id="385051799172605136">חזרה</translation>
<translation id="3931222419141306012">קובץ אימג' מיושן לשחזור מערכת ההפעלה</translation>
<translation id="4002335453596341558">הזזת הדף למטה</translation>
<translation id="4228286289437521015">הפעולה הזאת תגרום למחיקה של כל הנתונים במכשיר. אבטחת המכשיר תושבת.</translation>
<translation id="4231467600151418708">2. צריך ללחוץ לחיצה ארוכה על Esc + רענון ( ⟳ ) + הפעלה ( ⏻ ).</translation>
<translation id="4410491068110727276">יש להשתמש בכפתורי עוצמת הקול כדי לנווט מעלה ומטה</translation>
<translation id="46859019225980199">כדי לפתור את הבעיה, צריך להתחיל את תהליך השחזור.</translation>
<translation id="4773280894882892048">מידע על תוצאות ניפוי באגים</translation>
<translation id="4815374450404670311">בדיקת זיכרון (מלאה)</translation>
<translation id="4986594717579135906">המכשיר בתהליך עדכון שיסתיים בקרוב. התהליך עשוי להימשך דקה עד שתי דקות.
אין לכבות את המכשיר.</translation>
<translation id="4991849386608920411">צריך ללחוץ על כפתור השחזור במכשיר כדי לפתוח את תוכנת האתחול, או ללחוץ על "ביטול" כדי לא לפגוע באבטחת החשבון.</translation>
<translation id="5018618999152115810">שימוש בכונן USB</translation>
<translation id="5184662919967270437">המכשיר מתעדכן</translation>
<translation id="5232488980254489397">הפעלת האבחון</translation>
<translation id="5258940999070776327">בחירה של בדיקה להפעלה</translation>
<translation id="5288652088496335604">כדי להתחיל, צריך לבחור שיטת שחזור.</translation>
<translation id="5447452894128399840">2. צריך לפעול לפי ההוראות במכשיר האחר</translation>
<translation id="5477875595374685515">לא ניתן לקבל את יומן הקושחה.</translation>
<translation id="5511340521509645831">הפעלה מכונן חיצוני</translation>
<translation id="5592705604979238266">מרכז העזרה:</translation>
<translation id="5704836750240170251">נעילת תוכנת האתחול</translation>
<translation id="5733004683773923934">משהו השתבש במהלך ההפעלה מהכונן הפנימי. בשביל לקבל פרטים נוספים, צריך להיכנס ל"אפשרויות מתקדמות" &gt; "יומן הקושחה".</translation>
<translation id="5831266751064943765">אי אפשר להשתמש במקלדת חיצונית כדי לפתוח את הנעילה של תוכנת האתחול. צריך להשתמש במקלדת המובנית.</translation>
<translation id="5846715299792649254">‏1. כונן USB</translation>
<translation id="589807000231180230">בהמתנה לחיבור לאינטרנט...</translation>
<translation id="6073029132385600270">הכנה לשחזור של המכשיר שלך</translation>
<translation id="6172915643608608639">הפעלה מדיסק פנימי</translation>
<translation id="6209959435052494013">לנעול את תוכנת האתחול?</translation>
<translation id="6259657716425232440">תוכנת האתחול כבר פתוחה.</translation>
<translation id="6326551461084488743">המכשיר:</translation>
<translation id="635783852215913562">יש להשתמש במקשי החיצים כדי לנווט מעלה או מטה.</translation>
<translation id="6437078769036639380">צריך לוודא שהכונן החיצוני מכיל קובץ אימג' תקין של מערכת ההפעלה, ולהכניס אותו מחדש כשהוא מוכן.</translation>
<translation id="6453188622241717495">פתיחת תוכנת האתחול</translation>
<translation id="65237697078188559">מעטפת הקושחה</translation>
<translation id="6526005868180962531">כשהכונן לשחזור מוכן, צריך לחבר אותו למכשיר הזה כדי להתחיל את תהליך השחזור.</translation>
<translation id="6870233504224262352">צריך להשאיר את המכשיר פועל. הפעולה תימשך כמה רגעים.</translation>
<translation id="6933530204467815794">חיבור באמצעות TCP</translation>
<translation id="6972383785688794804">הזזת הדף למעלה</translation>
<translation id="7065553583078443466">בחירת תוכנת אתחול אחרת</translation>
<translation id="7071202423630761214">חיבור באמצעות USB</translation>
<translation id="7126032376876878896">יש להשתמש בכפתור ההפעלה כדי לבחור אפשרות.</translation>
<translation id="714708458581824276">מחיצת שחזור האינטרנט לא תקינה או חסרה. במקומה, אפשר להשתמש בכונן USB או כרטיס SD.</translation>
<translation id="7321387134821904291">מידע על תקינות האחסון</translation>
<translation id="7332672207700801967">שחזור אינטרנט (גרסה ישנה יותר)</translation>
<translation id="7342794948394983731">כלי אבחון</translation>
<translation id="7352651011704765696">משהו השתבש</translation>
<translation id="7356165460126686730">שימוש בחיבור לאינטרנט</translation>
<translation id="7363327341920650426">האפשרות לבצע אתחול באמצעות תוכנת אתחול פתוחה מושבתת. כדי להפעיל אותה, צריך להפעיל מחדש את מערכת ההפעלה ולהפעיל את מצב OEM באפשרויות למפתחים. למידע נוסף:</translation>
<translation id="7379220436569534523">הפעולה הזו תנעל את תוכנת האתחול ותחזיר את המכשיר למצבו המקורי.</translation>
<translation id="7658239707568436148">ביטול</translation>
<translation id="7666722144169757891">קובץ האימג' לשחזור מערכת ההפעלה הזה ישן מדי למכשיר שלך. צריך להוריד קובץ אימג' חדש לשחזור מערכת ההפעלה ולנסות שוב.</translation>
<translation id="7768922467835418715">לא זוהה כונן חיצוני</translation>
<translation id="786846615651935749">2. מכשיר אחר עם חיבור לאינטרנט</translation>
<translation id="7939062555109487992">אפשרויות מתקדמות</translation>
<translation id="8003769027543821178">‏1. כונן USB או כרטיס SD</translation>
<translation id="8011335065515332253">אחרי הזמן הקצוב לתפוגה, המכשיר יופעל באופן אוטומטי לפי אפשרות הבחירה שלמטה.</translation>
<translation id="8116993605321079294">משהו השתבש בהפעלה של תוכנת האתחול החלופית. לפרטים, יש לעיין ביומן הקושחה.</translation>
<translation id="8131740175452115882">אישור</translation>
<translation id="8182314305006465525">הפעלת את מצב האתחול המהיר (Fastboot mode) של תוכנת האתחול</translation>
<translation id="8315682102205416794">שימוש בכונן USB או כרטיס SD</translation>
<translation id="8377165353588213941">הגעת לסוף</translation>
<translation id="8547898031669202422">האפשרות לבצע הפעלה מכונן חיצוני מושבתת. למידע נוסף:</translation>
<translation id="8569584079758810124">לא ניתן לקבל מידע על תוצאות ניפוי הבאגים.</translation>
<translation id="8609689706517017461">מחיצת שחזור האינטרנט לא תקינה או חסרה. במקומה אפשר להשתמש בכונן USB.</translation>
<translation id="8720490351198901261">הגעת לחלק העליון</translation>
<translation id="8738563743369620892">אי אפשר להשתמש במקלדת כדי לפתוח את הנעילה של תוכנת האתחול. אפשר להשתמש בכפתור ההפעלה ( ⏻ ).</translation>
<translation id="8856927881878864573">2. צריך ללחוץ לחיצה ארוכה על הכפתורים להגברה והחלשה של עוצמת הקול ועל כפתור ההפעלה ( ⏻ ) במשך 10 שניות לפחות.</translation>
<translation id="8878311588372127478">בדיקה עצמית של האחסון (מורחבת)</translation>
<translation id="8975826224585429326">לא נמצאה תוכנת אתחול חלופית. הוראות להתקנת תוכנה כזו זמינות בכתובת:</translation>
<translation id="9004305007436435169">לא ניתן לקבל מידע על האבחון.</translation>
<translation id="9037104512788860027">אסור לבצע אתחול באמצעות תוכנת אתחול פתוחה. למידע נוסף:</translation>
<translation id="9111102763498581341">פתיחת הנעילה</translation>
</translationbundle>