<!DOCTYPE translationbundle>
<translationbundle lang="kn">
<translation id="1014836725110176376">1. ನಿಮ್ಮ ಇತರ ಸಾಧನದಲ್ಲಿ <ph name="REC_URL" /> ಗೆ ಹೋಗಿ</translation>
<translation id="1201402288615127009">ಮುಂದೆ</translation>
<translation id="1327914510899744949">ಬೂಟ್‌ಲೋಡರ್ ಫಾಸ್ಟ್‌ಬೂಟ್</translation>
<translation id="1428255359211557126">ಮೆಮೊರಿ ಪರಿಶೀಲನೆ (ತ್ವರಿತ)</translation>
<translation id="1472222389773595668">ನಿಮ್ಮ ರಿಕವರಿ ಡ್ರೈವ್ ಅನ್ನು ಸೆಟಪ್ ಮಾಡಿ</translation>
<translation id="1483971085438511843">ಆಯ್ಕೆಯನ್ನು ಆರಿಸಲು, enter ಕೀ ಬಳಸಿ.</translation>
<translation id="1512607074848104909">OS ಚಿತ್ರವನ್ನು ಹೊಂದಿರುವ ಬಾಹ್ಯ ಡ್ರೈವ್ ಅನ್ನು ಪ್ಲಗ್ ಇನ್ ಮಾಡಿ. ನಿಮ್ಮ ಸಾಧನವು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬೂಟ್ ಆಗುತ್ತದೆ.</translation>
<translation id="1618959600706780970">ಬೂಟ್‌ಲೋಡರ್ ಅನ್‌ಲಾಕ್ ಆಗಿರುವಾಗ ನಿಮ್ಮ ಸಾಧನವು ಸುರಕ್ಷಿತವಾಗಿರುವುದಿಲ್ಲ. ಸಾಧನದ ಭದ್ರತೆಯನ್ನು ಮರುಸ್ಥಾಪಿಸಲು, ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಲಾಕ್ ಮಾಡಿ.</translation>
<translation id="1851498512110506461">ಈ ಪ್ರಕ್ರಿಯೆಯಲ್ಲಿ ಬಳಕೆದಾರರ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="1880493276474218432">ರಿಕವರಿ ಡ್ರೈವ್ ಅನ್ನು ರಚಿಸಲು, ನಿಮಗೆ ಇವುಗಳ ಅಗತ್ಯವಿದೆ:</translation>
<translation id="1995660704900986789">ಪವರ್ ಆಫ್</translation>
<translation id="2022309272630265316">ಯಾವುದೇ ಮಾನ್ಯ ಚಿತ್ರ ಪತ್ತೆಯಾಗಿಲ್ಲ</translation>
<translation id="2164852388827548816">ಫರ್ಮ್‌‌ವೇರ್‌‌ ಲಾಗ್‌</translation>
<translation id="2242127796967618375">ಇಲ್ಲಿ ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ:</translation>
<translation id="2340902555262319714">2. ರಿಕವರಿ ಬಟನ್ ಅನ್ನು ಒತ್ತಿ ಹಿಡಿದುಕೊಂಡು, ಪವರ್ ಬಟನ್ ( ⏻ ) ಅನ್ನು ಒತ್ತಿ ಮತ್ತು ಬಿಡುಗಡೆ ಮಾಡಿ, ನಂತರ ರಿಕವರಿ ಬಟನ್ ಅನ್ನು ಬಿಡುಗಡೆ ಮಾಡಿ.</translation>
<translation id="2730585974895524161">ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="2861620505929653443">ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಬೇಕೇ?</translation>
<translation id="2969699099866537016">ನಿಮ್ಮ ರಿಕವರಿ ಡ್ರೈವ್ ಮಾನ್ಯವಾದ ಚಿತ್ರವನ್ನು ಹೊಂದಿದೆ ಎಂಬುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="3165751548024554961">ನಿಮ್ಮ ಸಾಧನದ ಬ್ಯಾಟರಿ ಮಟ್ಟ ಕಡಿಮೆಯಿದೆ. ಮುಂದುವರಿಸಲು ವಿದ್ಯುತ್ ಮೂಲಕ್ಕೆ ಕನೆಕ್ಟ್ ಮಾಡಿ.</translation>
<translation id="3174560100798162637">ನಿಮ್ಮ ಸಾಧನವನ್ನು ವಿದ್ಯುತ್ ಮೂಲ ಒಂದಕ್ಕೆ ಸಂಪರ್ಕಿಸಲು ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ.</translation>
<translation id="3294574173405124634">GBB ಫ್ಲ್ಯಾಗ್‌ಗಳು ಅನುಮತಿಸದ ಸುರಕ್ಷಿತ ಮೋಡ್‌ಗೆ ಹಿಂತಿರುಗಲಾಗುತ್ತಿದೆ.</translation>
<translation id="330703583939423765">1. ಕನೆಕ್ಟ್ ಮಾಡಿರುವ ಎಲ್ಲಾ ಸಾಧನಗಳನ್ನು ತೆಗೆದುಹಾಕಿ.</translation>
<translation id="361826164482194215">ಪರ್ಯಾಯ ಬೂಟ್‌ಲೋಡರ್‌ಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ. ಇಲ್ಲಿ ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ:</translation>
<translation id="3697087251845525042">ಸಂಗ್ರಹಣೆ ಸ್ವಯಂ ಪರೀಕ್ಷೆ (ಚಿಕ್ಕದು)</translation>
<translation id="3784455785234192852">ಲಾಕ್ ಮಾಡಿ</translation>
<translation id="3848046184877245923">ರಿಕವರಿ ಪ್ರಕ್ರಿಯೆಯನ್ನು ಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="385051799172605136">ಹಿಂದೆ</translation>
<translation id="3931222419141306012">ಹಳೆಯ ರಿಕವರಿ ಚಿತ್ರ</translation>
<translation id="4002335453596341558">ಪೇಜ್ ಡೌನ್</translation>
<translation id="4228286289437521015">ಇದು ನಿಮ್ಮ ಸಾಧನದಿಂದ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಅಳಿಸಿಹಾಕುತ್ತದೆ. ಸಾಧನದ ಭದ್ರತೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="4231467600151418708">2. Esc + ರಿಫ್ರೆಶ್ ( ⟳ ) + ಪವರ್ ( ⏻ ) ಅನ್ನು ಒತ್ತಿ ಹಿಡಿಯಿರಿ.</translation>
<translation id="4410491068110727276">ಮೇಲಕ್ಕೆ ಅಥವಾ ಕೆಳಕ್ಕೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಲು ವಾಲ್ಯೂಮ್ ಬಟನ್‌ಗಳನ್ನು ಬಳಸಿ.</translation>
<translation id="46859019225980199">ಈ ಸಮಸ್ಯೆಯನ್ನು ಸರಿಪಡಿಸಲು, ರಿಕವರಿ ಪ್ರಕ್ರಿಯೆಯನ್ನು ಪ್ರಾರಂಭಿಸಿ.</translation>
<translation id="4773280894882892048">ಡೀಬಗ್ ಕುರಿತ ಮಾಹಿತಿ</translation>
<translation id="4815374450404670311">ಮೆಮೊರಿ ಪರಿಶೀಲನೆ (ಸಂಪೂರ್ಣ)</translation>
<translation id="4986594717579135906">Your device is finishing an update. This may take 1-2 minutes.
Please do not turn off your device.</translation>
<translation id="4991849386608920411">ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಲು ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿರುವ ರಿಕವರಿ ಬಟನ್ ಅನ್ನು ಒತ್ತಿರಿ ಅಥವಾ ಸುರಕ್ಷಿತವಾಗಿರಲು ರದ್ದುಗೊಳಿಸಿ ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ.</translation>
<translation id="5018618999152115810">USB ಡ್ರೈವ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="5184662919967270437">ನಿಮ್ಮ ಸಾಧನವನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="5232488980254489397">ಡಯಾಗ್ನಾಸ್ಟಿಕ್‌ಗಳನ್ನು ಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="5258940999070776327">ರನ್ ಮಾಡುವುದಕ್ಕಾಗಿ ಟೆಸ್ಟ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="5288652088496335604">ಪ್ರಾರಂಭಿಸಲು, ರಿಕವರಿ ವಿಧಾನವನ್ನು ಆಯ್ಕೆಮಾಡಿ.</translation>
<translation id="5447452894128399840">2. ನಿಮ್ಮ ಇನ್ನೊಂದು ಸಾಧನದಲ್ಲಿ ಸೂಚನೆಗಳನ್ನು ಅನುಸರಿಸಿ</translation>
<translation id="5477875595374685515">ಫರ್ಮ್‌ವೇರ್ ಲಾಗ್ ಪಡೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.</translation>
<translation id="5511340521509645831">ಬಾಹ್ಯ ಡ್ರೈವ್‌ನಿಂದ ಬೂಟ್ ಮಾಡಿ</translation>
<translation id="5592705604979238266">ಸಹಾಯ ಕೇಂದ್ರ:</translation>
<translation id="5704836750240170251">ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಲಾಕ್ ಮಾಡಿ</translation>
<translation id="5733004683773923934">ಆಂತರಿಕ ಡಿಸ್ಕ್‌ನಿಂದ ಬೂಟ್ ಮಾಡುವಾಗ ಏನೋ ತಪ್ಪಾಗಿದೆ. ವಿವರಗಳಿಗಾಗಿ, ಸುಧಾರಿತ ಆಯ್ಕೆಗಳು &gt; ಫರ್ಮ್‌ವೇರ್ ಲಾಗ್ ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ.</translation>
<translation id="5831266751064943765">ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡುವುದಕ್ಕಾಗಿ ಬಾಹ್ಯ ಕೀಬೋರ್ಡ್ ಅನ್ನು ಬಳಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ಬಿಲ್ಟ್-ಇನ್ ಕೀಬೋರ್ಡ್ ಅನ್ನು ಬಳಸಿ.</translation>
<translation id="5846715299792649254">1. USB ಡ್ರೈವ್</translation>
<translation id="589807000231180230">ಕನೆಕ್ಷನ್‌ಗಾಗಿ ನಿರೀಕ್ಷಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="6073029132385600270">ನಿಮ್ಮ ಸಾಧನವನ್ನು ರಿಕವರ್ ಮಾಡಲು ಸಿದ್ಧರಾಗಿ</translation>
<translation id="6172915643608608639">ಆಂತರಿಕ ಡಿಸ್ಕ್‌ ಮೂಲಕ ಬೂಟ್ ಮಾಡಿ</translation>
<translation id="6209959435052494013">ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಲಾಕ್ ಮಾಡಬೇಕೇ?</translation>
<translation id="6259657716425232440">ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಈಗಾಗಲೇ ಅನ್‌ಲಾಕ್ ಮಾಡಲಾಗಿದೆ.</translation>
<translation id="6326551461084488743">ಸಾಧನ:</translation>
<translation id="635783852215913562">ಮೇಲಕ್ಕೆ ಅಥವಾ ಕೆಳಗೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಲು ಬಾಣದ ಕೀಗಳನ್ನು ಬಳಸಿ.</translation>
<translation id="6437078769036639380">ನಿಮ್ಮ ಬಾಹ್ಯ ಡ್ರೈವ್ ಮಾನ್ಯವಾದ OS ಚಿತ್ರವನ್ನು ಹೊಂದಿದೆ ಎಂಬುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ ಮತ್ತು ಅದು ಸಿದ್ಧವಾದಾಗ ಅದನ್ನು ಪುನಃ ಸೇರಿಸಿ.</translation>
<translation id="6453188622241717495">ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಿ</translation>
<translation id="65237697078188559">ಫರ್ಮ್‌ವೇರ್ ಶೆಲ್</translation>
<translation id="6526005868180962531">ನಿಮ್ಮ ರಿಕವರಿ ಡ್ರೈವ್ ಸಿದ್ಧವಾದಾಗ, ರಿಕವರಿ ಪ್ರಕ್ರಿಯೆಯನ್ನು ಪ್ರಾರಂಭಿಸಲು ಅದನ್ನು ಈ ಸಾಧನಕ್ಕೆ ಪ್ಲಗ್ ಮಾಡಿ.</translation>
<translation id="6870233504224262352">ನಿಮ್ಮ ಸಾಧನವನ್ನು ಆನ್ ಸ್ಥಿತಿಯಲ್ಲಿಡಿ. ಇದಕ್ಕೆ ಸ್ವಲ್ಪ ಸಮಯ ಬೇಕಾಗಬಹುದು.</translation>
<translation id="6933530204467815794">TCP ಮೂಲಕ ಕನೆಕ್ಟ್ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="6972383785688794804">ಪೇಜ್ ಅಪ್</translation>
<translation id="7065553583078443466">ಬದಲಿ ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="7071202423630761214">USB ಮೂಲಕ ಕನೆಕ್ಟ್ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="7126032376876878896">ಆಯ್ಕೆಯನ್ನು ಆರಿಸಲು ಪವರ್ ಬಟನ್ ಬಳಸಿ.</translation>
<translation id="714708458581824276">ಇಂಟರ್ನೆಟ್ ರಿಕವರಿ ಪಾರ್ಟಿಶನ್ ದೋಷಪೂರಿತವಾಗಿದೆ ಅಥವಾ ಬಿಟ್ಟುಹೋಗಿದೆ. ಬದಲಿಗೆ, USB ಡ್ರೈವ್ ಅಥವಾ SD ಕಾರ್ಡ್ ಅನ್ನು ಬಳಸಿ.</translation>
<translation id="7321387134821904291">ಸಂಗ್ರಹಣೆ ಆರೋಗ್ಯದ ಕುರಿತು ಮಾಹಿತಿ</translation>
<translation id="7332672207700801967">ಇಂಟರ್‌ನೆಟ್ ರಿಕವರಿ (ಹಳೆಯ ಆವೃತ್ತಿ)</translation>
<translation id="7342794948394983731">ಡಯಾಗ್ನಾಸ್ಟಿಕ್ ಟೂಲ್‌ಗಳು</translation>
<translation id="7352651011704765696">ಯಾವುದೋ ತಪ್ಪು ಸಂಭವಿಸಿದೆ</translation>
<translation id="7356165460126686730">ಇಂಟರ್ನೆಟ್ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="7363327341920650426">ಅನ್‌ಲಾಕ್ ಮಾಡಲಾದ ಬೂಟ್‌ಲೋಡರ್ ಬಳಸಿಕೊಂಡು ಬೂಟ್ ಮಾಡುವುದನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ. ಅದನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು, OS ಗೆ ರೀಬೂಟ್ ಮಾಡಿ ಮತ್ತು ಡೆವಲಪರ್ ಆಯ್ಕೆಗಳಲ್ಲಿ OEM ಅನ್‌ಲಾಕ್ ಮಾಡುವಿಕೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ. ಇಲ್ಲಿ ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ:</translation>
<translation id="7379220436569534523">ಇದು ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಲಾಕ್ ಮಾಡುತ್ತದೆ ಮತ್ತು ನಿಮ್ಮ ಸಾಧನವನ್ನು ಅದರ ಮೂಲ ಸ್ಥಿತಿಗೆ ಮರುಸ್ಥಾಪಿಸುತ್ತದೆ.</translation>
<translation id="7658239707568436148">ರದ್ದುಮಾಡಿ</translation>
<translation id="7666722144169757891">ಈ ರಿಕವರಿ ಚಿತ್ರವು ತುಂಬಾ ಹಳೆಯದಾಗಿದ್ದು, ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಬಳಸಲಾಗುವುದಿಲ್ಲ. ಹೊಸ ರಿಕವರಿ ಚಿತ್ರವನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="7768922467835418715">ಯಾವುದೇ ಬಾಹ್ಯ ಡ್ರೈವ್ ಪತ್ತೆಯಾಗಿಲ್ಲ</translation>
<translation id="786846615651935749">2. ಇಂಟರ್ನೆಟ್ ಕನೆಕ್ಷನ್ ಹೊಂದಿರುವ ಮತ್ತೊಂದು ಸಾಧನ</translation>
<translation id="7939062555109487992">ಸುಧಾರಿತ ಆಯ್ಕೆಗಳು</translation>
<translation id="8003769027543821178">1. USB ಡ್ರೈವ್ ಅಥವಾ SD ಕಾರ್ಡ್</translation>
<translation id="8011335065515332253">ಅವಧಿ ಮೀರಿದ ನಂತರ, ಸಾಧನವು ಕೆಳಗಿನ ಆಯ್ಕೆಯಿಂದ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬೂಟ್ ಆಗುತ್ತದೆ.</translation>
<translation id="8116993605321079294">ಪರ್ಯಾಯ ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಪ್ರಾರಂಭಿಸುವಾಗ ಏನೋ ತಪ್ಪಾಗಿದೆ. ವಿವರಗಳಿಗಾಗಿ ಫರ್ಮ್‌ವೇರ್ ಲಾಗ್ ವೀಕ್ಷಿಸಿ.</translation>
<translation id="8131740175452115882">ದೃಢೀಕರಿಸು</translation>
<translation id="8182314305006465525">ನೀವು ಬೂಟ್‌ಲೋಡರ್ ಫಾಸ್ಟ್‌ಬೂಟ್ ಮೋಡ್‌ನಲ್ಲಿ (Fastboot mode) ಇದ್ದೀರಿ</translation>
<translation id="8315682102205416794">USB ಡ್ರೈವ್ ಅಥವಾ SD ಕಾರ್ಡ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="8377165353588213941">ನೀವು ಅಂತ್ಯವನ್ನು ತಲುಪಿರುವಿರಿ</translation>
<translation id="8547898031669202422">ಬಾಹ್ಯ ಡ್ರೈವ್‌ನಿಂದ ಬೂಟ್ ಮಾಡುವುದನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ. ಇಲ್ಲಿ ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ:</translation>
<translation id="8569584079758810124">ಡೀಬಗ್ ಮಾಹಿತಿಯನ್ನು ಪಡೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.</translation>
<translation id="8609689706517017461">ಇಂಟರ್ನೆಟ್ ರಿಕವರಿ ಪಾರ್ಟಿಶನ್ ದೋಷಪೂರಿತವಾಗಿದೆ ಅಥವಾ ಬಿಟ್ಟುಹೋಗಿದೆ. ಬದಲಿಗೆ, USB ಡ್ರೈವ್ ಅನ್ನು ಬಳಸಿ.</translation>
<translation id="8720490351198901261">ನೀವು ತುದಿಗೆ ತಲುಪಿರುವಿರಿ</translation>
<translation id="8738563743369620892">ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡುವುದಕ್ಕಾಗಿ ಕೀಬೋರ್ಡ್ ಅನ್ನು ಬಳಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ಪವರ್ ಬಟನ್ ( ⏻ ) ಅನ್ನು ಬಳಸಿ.</translation>
<translation id="8856927881878864573">2. ಕನಿಷ್ಠ 10 ಸೆಕೆಂಡ್‌ಗಳ ಕಾಲ ವಾಲ್ಯೂಮ್ ಹೆಚ್ಚು ಮಾಡಿ + ವಾಲ್ಯೂಮ್ ಕಡಿಮೆ ಮಾಡಿ + ಪವರ್ ಬಟನ್ ( ⏻ ) ಅನ್ನು ಒತ್ತಿ ಹಿಡಿದುಕೊಳ್ಳಿ.</translation>
<translation id="8878311588372127478">ಸಂಗ್ರಹಣೆ ಸ್ವಯಂ ಪರೀಕ್ಷೆ (ವಿಸ್ತರಿಸಿರುವುದು)</translation>
<translation id="8975826224585429326">ಬದಲಿ ಬೂಟ್‌ಲೋಡರ್ ಅನ್ನು ಹುಡುಕಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವುದು ಹೇಗೆ ಎಂಬುದನ್ನು ತಿಳಿಯಲು, ಇಲ್ಲಿಗೆ ಭೇಟಿ ನೀಡಿ:</translation>
<translation id="9004305007436435169">ಡಯಾಗ್ನಾಸ್ಟಿಕ್ ಮಾಹಿತಿಯನ್ನು ಪಡೆಯಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.</translation>
<translation id="9037104512788860027">ಅನ್‌ಲಾಕ್ ಮಾಡಲಾದ ಬೂಟ್‌ಲೋಡರ್ ಬಳಸಿಕೊಂಡು ಬೂಟ್ ಮಾಡಲು ಅನುಮತಿಸಲಾಗುವುದಿಲ್ಲ. ಇಲ್ಲಿ ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ:</translation>
<translation id="9111102763498581341">ಅನ್‌ಲಾಕ್ ಮಾಡಿ</translation>
</translationbundle>