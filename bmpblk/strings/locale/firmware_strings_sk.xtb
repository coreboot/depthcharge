<translation id="1014836725110176376">1. Prejdite na <ph name="REC_URL" /> v druhom zariadení</translation>
<translation id="1201402288615127009">Ďalej</translation>
<translation id="1327914510899744949">Režim rýchleho spustenia zavádzacieho programu systému</translation>
<translation id="1428255359211557126">Kontrola pamäte (rýchla)</translation>
<translation id="1472222389773595668">Nastavte si disk na obnovenie</translation>
<translation id="1483971085438511843">Klávesom Enter vyberte požadovanú možnosť.</translation>
<translation id="1512607074848104909">Pripojte externý disk s obrazom operačného systému. Zariadenie sa zapne automaticky.</translation>
<translation id="1618959600706780970">Keď je zavádzací program systému odomknutý, vaše zariadenie nie je zabezpečené. Ak chcete obnoviť jeho zabezpečenie, uzamknite zavádzací program systému.</translation>
<translation id="1851498512110506461">V rámci procesu budú údaje používateľa trvale vymazané.</translation>
<translation id="1880493276474218432">Na vytvorenie jednotky na obnovenie budete potrebovať:</translation>
<translation id="1995660704900986789">Vypnúť</translation>
<translation id="2022309272630265316">Nebol rozpoznaný žiadny platný obraz</translation>
<translation id="2164852388827548816">Denník firmvéru</translation>
<translation id="2242127796967618375">Viac sa dozviete na</translation>
<translation id="2340902555262319714">2. Pridržte tlačidlo obnovy, stlačte a uvoľnite vypínač ( ⏻ ) a potom uvoľnite tlačidlo obnovy.</translation>
<translation id="2730585974895524161">Zavádzací program systému je odomknutý</translation>
<translation id="2861620505929653443">Chcete odomknúť zavádzací program systému?</translation>
<translation id="2969699099866537016">Skontrolujte, či má jednotka na obnovenie platný obraz, a skúste to znova.</translation>
<translation id="3165751548024554961">Batéria zariadenia je takmer vybitá. Ak chcete pokračovať, pripojte sa k napájaciemu zdroju.</translation>
<translation id="3174560100798162637">Odporúčame vám pripojiť zariadenie k zdroju napájania.</translation>
<translation id="3294574173405124634">Experimentálne funkcie GBB nepovolili návrat do zabezpečeného režimu.</translation>
<translation id="330703583939423765">1. Odstráňte všetky pripojené zariadenia.</translation>
<translation id="361826164482194215">Alternatívne zavádzacie programy systému sú deaktivované. Viac sa dozviete na</translation>
<translation id="3697087251845525042">Autonómny test ukladacieho priestoru (krátky)</translation>
<translation id="3784455785234192852">Uzamknúť</translation>
<translation id="3848046184877245923">Spustenie procesu obnovenia</translation>
<translation id="385051799172605136">Späť</translation>
<translation id="3931222419141306012">Zastaraný obraz na obnovu</translation>
<translation id="4002335453596341558">Posunúť o stranu nižšie</translation>
<translation id="4228286289437521015">Týmto vymažete všetky údaje zo svojho zariadenia. Zabezpečenie zariadenia bude deaktivované.</translation>
<translation id="4231467600151418708">2. Pridržte Esc, tlačidlo obnovenia ( ⟳ ) a vypínač ( ⏻ ).</translation>
<translation id="4410491068110727276">Tlačidlami hlasitosti prechádzajte nahor alebo nadol.</translation>
<translation id="46859019225980199">Ak chcete tento problém odstrániť, začnite proces obnovenia.</translation>
<translation id="4773280894882892048">Informácie o ladení</translation>
<translation id="4815374450404670311">Kontrola pamäte (úplná)</translation>
<translation id="4986594717579135906">Dokoncuje sa aktualizacia. Trvanie: 1 - 2 min.
Nevypinajte zariadenie.</translation>
<translation id="4991849386608920411">Stlačením tlačidla obnovy vo svojom zariadení odomknite zavádzací program systému alebo vyberte Zrušiť, čím zachováte ochranu.</translation>
<translation id="5018618999152115810">Použiť kľúč USB</translation>
<translation id="5184662919967270437">Zariadenie sa aktualizuje</translation>
<translation id="5232488980254489397">Spustiť diagnostiku</translation>
<translation id="5258940999070776327">Výber testu, ktorý chcete spustiť</translation>
<translation id="5288652088496335604">Začnite výberom spôsobu obnovenia.</translation>
<translation id="5447452894128399840">2. Postupujte podľa pokynov v druhom zariadení.</translation>
<translation id="5477875595374685515">Denník firmvéru sa nepodarilo získať.</translation>
<translation id="5511340521509645831">Zapnúť z externého disku</translation>
<translation id="5592705604979238266">Centrum pomoci:</translation>
<translation id="5704836750240170251">Uzamknúť zavádzací program systému</translation>
<translation id="5733004683773923934">Pri zapnutí z interného disku sa niečo pokazilo. Podrobnosti nájdete v sekcii Rozšírené možnosti &gt; Denník firmvéru.</translation>
<translation id="5831266751064943765">Zavádzací program systému nemôžete odomknúť pomocou externej klávesnice. Použite vstavanú.</translation>
<translation id="5846715299792649254">1. Disk USB</translation>
<translation id="589807000231180230">Čaká sa na pripojenie…</translation>
<translation id="6073029132385600270">Pripravte sa na obnovenie zariadenia</translation>
<translation id="6172915643608608639">Spustiť z interného disku</translation>
<translation id="6209959435052494013">Chcete uzamknúť zavádzací program systému?</translation>
<translation id="6259657716425232440">Zavádzací program systému je už odomknutý.</translation>
<translation id="6326551461084488743">Zariadenie:</translation>
<translation id="635783852215913562">Klávesmi so šípkami prechádzajte nahor a nadol.</translation>
<translation id="6437078769036639380">Skontrolujte, či máte na externom disku platný obraz operačného systému, a keď budete chcieť začať, znova ho vložte.</translation>
<translation id="6453188622241717495">Odomknúť zavádzací program systému</translation>
<translation id="65237697078188559">Kostra firmvéru</translation>
<translation id="6526005868180962531">Keď bude disk na obnovenie pripravený, pripojte ho k tomuto zariadeniu a začnite tak proces obnovenia.</translation>
<translation id="6870233504224262352">Zariadenie nechajte zapnuté. Môže to chvíľu trvať.</translation>
<translation id="6933530204467815794">Pripojené cez TCP</translation>
<translation id="6972383785688794804">Posunúť o stranu vyššie</translation>
<translation id="7065553583078443466">Vybrať alternatívny zavádzací program systému</translation>
<translation id="7071202423630761214">Pripojené cez USB</translation>
<translation id="7126032376876878896">Vypínačom vyberte požadovanú možnosť.</translation>
<translation id="714708458581824276">Oddiel internetového obnovenia je poškodený alebo chýba. Použite radšej kľúč USB alebo SD kartu.</translation>
<translation id="7321387134821904291">Informácie o stave ukladacieho priestoru</translation>
<translation id="7332672207700801967">Internetové obnovenie (staršia verzia)</translation>
<translation id="7342794948394983731">Diagnostické nástroje</translation>
<translation id="7352651011704765696">Vyskytla sa chyba</translation>
<translation id="7356165460126686730">Používať internetové pripojenie</translation>
<translation id="7363327341920650426">Zapínanie s odomknutým zavádzacím programom systému je deaktivované. Ak ho chcete aktivovať, reštartujte operačný systém a aktivujte odomknutie OEM v sekcii Pre vývojárov. Viac sa dozviete na</translation>
<translation id="7379220436569534523">Týmto uzamknete zavádzací program systému a v zariadení sa obnoví pôvodný stav.</translation>
<translation id="7658239707568436148">Zrušiť</translation>
<translation id="7666722144169757891">Tento obraz na obnovu je pre vaše zariadenie príliš starý. Stiahnite si nový a skúste to znova.</translation>
<translation id="7768922467835418715">Nebol rozpoznaný žiadny externý disk</translation>
<translation id="786846615651935749">2. Druhé zariadenie s internetovým pripojením.</translation>
<translation id="7939062555109487992">Rozšírené možnosti</translation>
<translation id="8003769027543821178">1. Kľúč USB alebo SD karta</translation>
<translation id="8011335065515332253">Po časovom limite sa zariadenie automaticky zapne z vybraného zdroja nižšie.</translation>
<translation id="8116993605321079294">Pri spúšťaní alternatívneho zavádzacieho programu systému sa vyskytol problém. Podrobnosti nájdete v denníku firmvéru.</translation>
<translation id="8131740175452115882">Potvrdiť</translation>
<translation id="8182314305006465525">Ste v režime rýchleho spustenia zavádzacieho programu systému</translation>
<translation id="8315682102205416794">Použiť kľúč USB alebo SD kartu</translation>
<translation id="8377165353588213941">Ste na konci</translation>
<translation id="8547898031669202422">Zapínanie z externého disku je deaktivované. Viac sa dozviete na</translation>
<translation id="8569584079758810124">Informácie o ladení sa nepodarilo získať.</translation>
<translation id="8609689706517017461">Oddiel internetového obnovenia je poškodený alebo chýba. Použite namiesto toho kľúč USB.</translation>
<translation id="8720490351198901261">Ste na začiatku</translation>
<translation id="8738563743369620892">Zavádzací program systému nemôžete odomknúť pomocou klávesnice. Použite vypínač ( ⏻ ).</translation>
<translation id="8856927881878864573">2. Pridržte aspoň desať sekúnd tlačidlá zvýšenia a zníženia hlasitosti spolu s vypínačom ( ⏻ ).</translation>
<translation id="8878311588372127478">Autonómny test ukladacieho priestoru (rozšírený)</translation>
<translation id="8975826224585429326">Alternatívny zavádzací program systému sa nepodarilo nájsť. Postup jeho inštalácie nájdete tu:</translation>
<translation id="9004305007436435169">Diagnostické údaje sa nepodarilo získať.</translation>
<translation id="9037104512788860027">Zapínanie s odomknutým zavádzacím programom systému nie je povolené. Viac sa dozviete na</translation>
<translation id="9111102763498581341">Odomknúť</translation>
